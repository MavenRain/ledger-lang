-- Probe: structural recursion over Text, a List with a type parameter, and
-- the mutual Value / Values / Attrs group. Load after core/schema.mech.

def rec textLength : Text -> Nat := fun (text : Text) =>
  case text as self in Text return Nat with
  | textEnd => 0
  | textByte byte rest => natAdd 1 (textLength rest)

def rec listLength : (0 A : Type 0) -> List A -> Nat :=
  fun (0 A : Type 0) (items : List A) =>
    case items as self in List return Nat with
    | nil => 0
    | cons head tail => natAdd 1 (listLength A tail)

-- The structural argument is the second one.
def rec appendOnto : Text -> Text -> Text := fun (right : Text) (left : Text) =>
  case left as self in Text return Text with
  | textEnd => right
  | textByte byte rest => textByte byte (appendOnto right rest)

-- A fold with a function argument.
def rec listFold : (0 A : Type 0) -> (0 B : Type 0) -> (A -> B -> B) -> B -> List A -> B :=
  fun (0 A : Type 0) (0 B : Type 0) (step : A -> B -> B) (start : B) (items : List A) =>
    case items as self in List return B with
    | nil => start
    | cons head tail => step head (listFold A B step start tail)

def rec valueSize : Value -> Nat := fun (value : Value) =>
  case value as self in Value return Nat with
  | valueNull => 1
  | valueFlag flag => 1
  | valueNat number => 1
  | valueText text => 1
  | valueItems items => natAdd 1 (valuesSize items)
  | valueAttrs attrs => natAdd 1 (attrsSize attrs)
and valuesSize : Values -> Nat := fun (values : Values) =>
  case values as self in Values return Nat with
  | valuesEnd => 0
  | valuesItem head tail => natAdd (valueSize head) (valuesSize tail)
and attrsSize : Attrs -> Nat := fun (attrs : Attrs) =>
  case attrs as self in Attrs return Nat with
  | attrsEnd => 0
  | attrsField key value rest => natAdd (valueSize value) (attrsSize rest)

def twoBytes : Text := textByte 104 (textByte 105 textEnd)

def recTextLength : Nat := textLength (appendOnto twoBytes twoBytes)

def recListLength : Nat :=
  listLength Text (cons twoBytes (cons textEnd nil))

def recListFold : Nat :=
  listFold Nat Nat (fun (item : Nat) (total : Nat) => natAdd item total) 0
    (cons 30 (cons 12 nil))

def recValueSize : Nat :=
  valueSize
    (valueAttrs
      (attrsField twoBytes
        (valueItems (valuesItem valueNull (valuesItem (valueNat 7) valuesEnd)))
        attrsEnd))
