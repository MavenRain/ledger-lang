-- Probe: the Nat primitives of the host. The catalog holds natAdd, natSub,
-- natMul, natEq and natLt only. This file needs no other file.

def natSum : Nat := natAdd 200 55
def natDiff : Nat := natSub 5 3
def natDiffFloor : Nat := natSub 3 5
def natProduct : Nat := natMul 1000 1000
def natWide : Nat := natMul 100000 100000

def ltAsNat : Nat -> Nat -> Nat := fun (a : Nat) (b : Nat) =>
  case (natLt a b) as verdict return Nat with
  | 0 (x : prod ()) => 0
  | 1 (t : prod ()) => 1

def ltTrue : Nat := ltAsNat 1 2
def ltFalse : Nat := ltAsNat 2 1

def eqTrue : Nat :=
  case (natEq 7 7) as verdict return Nat with
  | 0 (x : prod ()) => 0
  | 1 (t : prod ()) => 1

-- Nat has no constructors, so recursion needs a separate structural argument.
mu Fuel : Type 0 with
| fuelEnd : Fuel
| fuelStep : Fuel -> Fuel

def rec fuelAdd : Fuel -> Fuel -> Fuel := fun (left : Fuel) (right : Fuel) =>
  case left as self in Fuel return Fuel with
  | fuelEnd => right
  | fuelStep more => fuelStep (fuelAdd more right)

def fuel4 : Fuel := fuelStep (fuelStep (fuelStep (fuelStep fuelEnd)))
def fuel8 : Fuel := fuelAdd fuel4 fuel4
def fuel16 : Fuel := fuelAdd fuel8 fuel8
def fuel32 : Fuel := fuelAdd fuel16 fuel16

-- Quotient by ten through repeated subtraction. There is no div or mod.
def rec quotTen : Fuel -> Nat -> Nat := fun (fuel : Fuel) (n : Nat) =>
  case fuel as self in Fuel return Nat with
  | fuelEnd => 0
  | fuelStep more =>
    case (natLt n 10) as small return Nat with
    | 0 (x : prod ()) => natAdd 1 (quotTen more (natSub n 10))
    | 1 (t : prod ()) => 0

def quot : Nat := quotTen fuel32 255
def lastDigit : Nat := natSub 255 (natMul 10 quot)
