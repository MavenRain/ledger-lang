-- A type definition can name a function type. WritePath is the function
-- type of core/ops.def: (log : Log) -> (write : Write) -> Step. The
-- compiler checks a function of this type. It does not run the write path.
def acme : Ref kindParty := refTo (hashOf "party-acme")
def deal : Ref kindCommercial := refTo (hashOf "deal-1")
def advance : Write :=
  makeWrite (actorHuman acme) none (commandTransition deal "negotiation")

def Guard : Type 0 := (head : Hash) -> WritePath

def refuse : WritePath :=
  fun (log : Log) (write : Write) => makeStep log (outcomeDenied none nil)

def conflict : Guard :=
  fun (head : Hash) (log : Log) (write : Write) =>
    makeStep log (outcomeConflict head)

def history : Log := nil
def refused : Step := refuse history advance
def raced : Step := conflict (hashOf "entry-9") history advance
