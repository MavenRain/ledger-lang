-- The answer type is the index of the Query type that the constructor gives.
def opsQueryAnswer : Text -> Option LType := fun (name : Text) =>
  (case (natEq (sameText name opsTextqueryMembersOf) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tyRef skindMembership))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryEmployer) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyOption (tyRef skindParty))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryJobChanges) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tyRef skindParty))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryCommercial) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyOption (tySchema schemaTextCommercial))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryProjectionSound) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyFlag)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryTermsInForce) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tyRef skindCommitment))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryTermHistory) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tyRef skindCommitment))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryAmountReconciled) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyFlag)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryDiscountPct) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyOption (tyNat))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryEvidence) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tyRef skindArtifact))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryArtifactIntact) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyFlag)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryTimeline) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tyRef skindEvent))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryThread) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tyRef skindEvent))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryReplay) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tySchema schemaTextEntry))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryTail) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tySchema schemaTextEntry))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryAuditByActor) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tyRef skindEvent))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryAuditByPolicy) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tyRef skindEvent))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryOwner) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyOption (tyRef skindParty))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryBook) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tySchema schemaTextAccount))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryCan) 1) as matched return Option LType with
