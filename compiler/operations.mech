    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryDryRun) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tySchema opsTextMissing))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextqueryRedacted) 1) as matched return Option LType with
