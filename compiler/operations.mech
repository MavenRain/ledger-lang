-- Log is an alias. The parser gives its definition, so the alias has no own name in the output.
def opsType : Text -> Option LType := fun (name : Text) =>
  (case (natEq (sameText name opsTextLog) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tyList (tySchema schemaTextEntry))
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextMoment) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextMoment)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextMissing) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextMissing)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextVerdict) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextVerdict)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextCommand) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextCommand)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextWrite) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextWrite)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextOutcome) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextOutcome)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextStep) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextStep)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextPipelineKey) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextPipelineKey)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextBucket) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextBucket)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextStageStat) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextStageStat)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextRenewal) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextRenewal)
    | 0 (x : prod ()) => (case (natEq (sameText name opsTextAccount360) 1) as matched return Option LType with
    | 1 (x : prod ()) => some (tySchema opsTextAccount360)
    | 0 (x : prod ()) => none)))))))))))))

