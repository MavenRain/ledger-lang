-- Operations over the schema. Load after schema.mech.
-- There is one write path and one read path. A write checks policy, appends
-- entries and updates the projection. A read is a query at a log position.

def Log : Type 0 := List Entry

-- A read position. Log order replaces time, so "as of time T" is "as of entry T".
mu Moment : Type 0 with
| momentNow : Moment
| momentAsOf : (entry : Hash) -> Moment

-- What a transition guard still needs.
mu Missing : Type 0 with
| missingField : (field : Text) -> Missing
| missingCommitment : (kind : CommitmentKind) -> Missing
| missingApproval : (role : Text) -> Missing

-- The answer of can: allow or deny, plus the policy that decided.
mu Verdict : Type 0 with
| verdictAllow : (policy : Ref kindPolicy) -> Verdict
| verdictDeny : (policy : Option (Ref kindPolicy)) -> Verdict   -- none = no rule matched

-- Every mutation. The write path turns one command into entries.
mu Command : Type 0 with
-- Identity
| commandResolveParty :                           -- find or create by merge key
    (kind : KindParty) -> (displayName : Text) -> (identifiers : List Identifier) -> Command
| commandMergeParties :                           -- repoints memberships, commercials, assignments, artifact subjects
    (keep : Ref kindParty) -> (drop : Ref kindParty) -> Command
| commandSplitParty : (party : Ref kindParty) -> (moved : List Identifier) -> Command
| commandAddIdentifier : (party : Ref kindParty) -> (identifier : Identifier) -> Command
| commandVerifyIdentifier :
    (party : Ref kindParty) -> (system : IdentifierSystem) -> (value : Text) -> Command
| commandEnrichParty :
    (party : Ref kindParty) -> (attrs : Attrs) -> (provenance : Provenance) -> Command
| commandDeleteParty : (party : Ref kindParty) -> Command      -- soft delete
| commandRestoreParty : (party : Ref kindParty) -> Command
| commandEraseParty : (party : Ref kindParty) -> Command       -- hard erase for a privacy request
-- Membership
| commandStartMembership : (membership : Membership) -> Command
| commandEndMembership : (membership : Ref kindMembership) -> Command
| commandSetPrimary : (membership : Ref kindMembership) -> Command   -- at most one current primary per person
-- Commercial
| commandOpenCommercial : (commercial : Commercial) -> Command
| commandTransition : (commercial : Ref kindCommercial) -> (stage : Text) -> Command
| commandChangeAmount : (commercial : Ref kindCommercial) -> (amountCents : Option Nat) -> Command
| commandSetStatus :                              -- win, lose, pause; resume = statusOpen
    (commercial : Ref kindCommercial) -> (status : CommercialStatus) -> Command
-- Commitment
| commandPropose : (commitment : Commitment) -> Command        -- supersede = propose with supersedes set
| commandAgree : (commitment : Ref kindCommitment) -> Command
-- Artifact
| commandIngest : (artifact : Artifact) -> Command             -- hash, dedupe on sha256, store, link subjects
| commandExtract :                                -- an agent derives events, commitments, memberships
    (artifact : Ref kindArtifact) -> (facts : List Body) -> Command
-- Event log
| commandRecord : (event : Event) -> Command                   -- note, message, meeting, call
-- Assignment
| commandAssign : (assignment : Assignment) -> Command
| commandReassign : (assignment : Ref kindAssignment) -> (assignee : Ref kindParty) -> Command
| commandEndAssignment : (assignment : Ref kindAssignment) -> Command
| commandBulkReassign :                           -- when a rep leaves
    (source : Ref kindParty) -> (target : Ref kindParty) -> Command
| commandRouteTerritory : (subject : Account) -> (territory : Text) -> Command
-- Policy
| commandRequestApproval : (commercial : Ref kindCommercial) -> (stage : Text) -> Command
| commandGrantApproval : (request : Ref kindEvent) -> Command

-- One write. A set expect is the compare-and-swap: the last entry on the
-- subject must have this hash.
mu Write : Type 0 with
| makeWrite : (actor : Actor) -> (expect : Option Hash) -> (command : Command) -> Write

mu Outcome : Type 0 with
| outcomeAppended : (entries : List Hash) -> (policy : Option (Ref kindPolicy)) -> Outcome
| outcomeDenied : (policy : Option (Ref kindPolicy)) -> (missing : List Missing) -> Outcome
| outcomeConflict : (head : Hash) -> Outcome      -- another writer got there first

mu Step : Type 0 with
| makeStep : (log : Log) -> (outcome : Outcome) -> Step

-- The sole write path: check policy, append entries, update the projection.
def WritePath : Type 0 := (log : Log) -> (write : Write) -> Step

mu PipelineKey : Type 0 with
| pipelineByStage : PipelineKey
| pipelineByOwner : PipelineKey
| pipelineByTerritory : PipelineKey
| pipelineByCloseDate : PipelineKey

mu Bucket : Type 0 with
| makeBucket : (key : Text) -> (count : Nat) -> (amountCents : Nat) -> Bucket

-- Velocity is in log entries, because the schema has no clock.
mu StageStat : Type 0 with
| makeStageStat :
    (stage : Text) -> (entered : Nat) -> (advanced : Nat) -> (entriesInStage : Nat) -> StageStat

mu Renewal : Type 0 with
| makeRenewal :
    (commercial : Ref kindCommercial) -> (date : Text) -> (term : Option (Ref kindCommitment)) -> Renewal

mu Account360 : Type 0 with
| makeAccount360 :
    (party : Party) ->
    (memberships : List (Ref kindMembership)) ->
    (commercials : List (Ref kindCommercial)) ->
    (assignments : List (Ref kindAssignment)) ->
    (artifacts : List (Ref kindArtifact)) ->
    (timeline : List (Ref kindEvent)) ->
    Account360

-- Every read. The index is the type of the answer.
mu Query : (0 answer : Type 0) -> Type 1 with
-- Membership
| queryMembersOf :                                -- who worked at org X at time T
    (org : Ref kindParty) -> (moment : Moment) -> Query (List (Ref kindMembership))
| queryEmployer : (person : Ref kindParty) -> (moment : Moment) -> Query (Option (Ref kindParty))
| queryJobChanges : (since : Moment) -> Query (List (Ref kindParty))
-- Commercial
| queryCommercial :                               -- rebuild the projection from the log
    (commercial : Ref kindCommercial) -> (moment : Moment) -> Query (Option Commercial)
| queryProjectionSound :                          -- the stored projection equals the replay
    (commercial : Ref kindCommercial) -> (stored : Commercial) -> Query Flag
-- Commitment
| queryTermsInForce :
    (commercial : Ref kindCommercial) -> (moment : Moment) -> Query (List (Ref kindCommitment))
| queryTermHistory : (commitment : Ref kindCommitment) -> Query (List (Ref kindCommitment))
| queryAmountReconciled : (commercial : Ref kindCommercial) -> Query Flag   -- amountCents against the agreed price
| queryDiscountPct : (commercial : Ref kindCommercial) -> Query (Option Nat)   -- for the policy guard
-- Artifact
| queryEvidence : (fact : Hash) -> Query (List (Ref kindArtifact))   -- back-trace from any fact
| queryArtifactIntact : (artifact : Ref kindArtifact) -> (digest : Text) -> Query Flag   -- re-hash
-- Event log
| queryTimeline : (subject : Subject) -> (moment : Moment) -> Query (List (Ref kindEvent))
| queryThread : (root : Ref kindEvent) -> Query (List (Ref kindEvent))
| queryReplay : (moment : Moment) -> Query Log
| queryTail : (after : Moment) -> Query Log       -- subscribe for agent triggers
| queryAuditByActor : (actor : Actor) -> Query (List (Ref kindEvent))
| queryAuditByPolicy : (policy : Ref kindPolicy) -> Query (List (Ref kindEvent))
-- Assignment
| queryOwner : (subject : Account) -> (moment : Moment) -> Query (Option (Ref kindParty))
| queryBook : (assignee : Ref kindParty) -> (moment : Moment) -> Query (List Account)
-- Policy
| queryCan :
    (principal : Text) -> (action : Permission) -> (subject : Subject) ->
    (fields : Option (List Text)) -> Query Verdict
| queryDryRun : (commercial : Ref kindCommercial) -> (stage : Text) -> Query (List Missing)
| queryRedacted : (principal : Text) -> (subject : Subject) -> Query Attrs   -- only the fields the ACL allows
| querySimulatePolicy : (policy : Policy) -> Query (List (Ref kindEvent))    -- events whose verdict changes
-- Rollups
| queryPipeline : (key : PipelineKey) -> (moment : Moment) -> Query (List Bucket)
| queryStageStats : Query (List StageStat)        -- velocity and conversion from eventStageChanged
| queryStaleDeals : (quietEntries : Nat) -> Query (List (Ref kindCommercial))
| queryRenewals : Query (List Renewal)            -- from date and term commitments
| queryAccount360 : (party : Ref kindParty) -> (moment : Moment) -> Query Account360
| queryReviewQueue : (belowConfidence : Nat) -> Query (List Hash)   -- low-confidence inferred facts

-- The sole read path: one query against the log gives an answer of its index type.
def ReadPath : Type 1 := (0 answer : Type 0) -> (log : Log) -> (query : Query answer) -> answer
