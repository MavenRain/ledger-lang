-- Each record enters the log as one Entry. The identity of a record is the hash
-- of the entry that created it, so no record stores its own id. Log order
-- replaces time: a start time is the creation entry itself, and a later time is
-- a Ref to the entry that caused it.

-- Base carriers. The language has no string type, so Text is a UTF-8 byte list.
mu Text : Type 0 with
| textEnd : Text
| textByte : (byte : Nat) -> (rest : Text) -> Text

mu Flag : Type 0 with
| flagNo : Flag
| flagYes : Flag

mu Option (0 A : Type 0) : Type 0 with
| none : Option A
| some : (value : A) -> Option A

mu List (0 A : Type 0) : Type 0 with
| nil : List A
| cons : (head : A) -> (tail : List A) -> List A

-- An untyped value. Attrs is a record from text keys to untyped values.
mu Value : Type 0 with
| valueNull : Value
| valueFlag : (flag : Flag) -> Value
| valueNat : (number : Nat) -> Value
| valueText : (text : Text) -> Value
| valueItems : (items : Values) -> Value
| valueAttrs : (attrs : Attrs) -> Value
and Values : Type 0 with
| valuesEnd : Values
| valuesItem : (head : Value) -> (tail : Values) -> Values
and Attrs : Type 0 with
| attrsEnd : Attrs
| attrsField : (key : Text) -> (value : Value) -> (rest : Attrs) -> Attrs

-- One tag for each record that an entry can create.
mu Kind : Type 0 with
| kindParty : Kind
| kindMembership : Kind
| kindCommercial : Kind
| kindCommitment : Kind
| kindArtifact : Kind
| kindEvent : Kind
| kindAssignment : Kind
| kindPolicy : Kind

-- sha256 of the canonical encoding of an Entry.
mu Hash : Type 0 with
| hashOf : (digest : Text) -> Hash

-- The hash of the entry that created a record of kind k.
mu Ref (0 k : Kind) : Type 0 with
| refTo : (hash : Hash) -> Ref k

-- A party or a commercial. The constructor replaces subject_type.
mu Account : Type 0 with
| accountParty : (party : Ref kindParty) -> Account
| accountCommercial : (commercial : Ref kindCommercial) -> Account

-- The subject of an event. The constructor replaces subject_type.
mu Subject : Type 0 with
| subjectParty : (party : Ref kindParty) -> Subject
| subjectMembership : (membership : Ref kindMembership) -> Subject
| subjectCommercial : (commercial : Ref kindCommercial) -> Subject
| subjectCommitment : (commitment : Ref kindCommitment) -> Subject
| subjectAssignment : (assignment : Ref kindAssignment) -> Subject

mu KindParty : Type 0 with
| partyPerson : KindParty
| partyOrg : KindParty

mu KindCommercial : Type 0 with
| commercialDeal : KindCommercial
| commercialSubscription : KindCommercial
| commercialTicket : KindCommercial

mu Actor : Type 0 with
| actorHuman : (party : Ref kindParty) -> Actor   -- KindParty = partyPerson
| actorAgent : (name : Text) -> Actor             -- not created in the log: a label, not a hash
| actorSystem : (name : Text) -> Actor

mu IdentifierSystem : Type 0 with
| systemEmail : IdentifierSystem
| systemDomain : IdentifierSystem
| systemLinkedin : IdentifierSystem
| systemPhone : IdentifierSystem
| systemSalesforce : IdentifierSystem
| systemStripe : IdentifierSystem
| systemOther : (name : Text) -> IdentifierSystem

mu Identifier : Type 0 with
| makeIdentifier :
    (system : IdentifierSystem) ->
    (value : Text) ->
    (verifiedBy : Option (Ref kindEvent)) ->      -- projected; was verified_at
    Identifier

-- Actor and time are those of the entry that carries the provenance.
mu Provenance : Type 0 with
| makeProvenance :
    (artifact : Option (Ref kindArtifact)) ->
    (event : Option (Ref kindEvent)) ->
    (confidence : Option Nat) ->                  -- percent, 0 to 100, only for inferred values
    Provenance

mu Party : Type 0 with
| makeParty :
    (kind : KindParty) ->
    (displayName : Text) ->
    (legalName : Option Text) ->
    (identifiers : List Identifier) ->            -- merge keys
    (attrs : Attrs) ->                            -- title, location, industry, headcount
    (lastEvent : Option (Ref kindEvent)) ->       -- projected; was updated_at
    (deletedBy : Option (Ref kindEvent)) ->       -- projected; was deleted_at
    Party

mu Membership : Type 0 with
| makeMembership :
    (person : Ref kindParty) ->                   -- KindParty = partyPerson
    (org : Ref kindParty) ->                      -- KindParty = partyOrg
    (role : Option Text) ->
    (isPrimary : Flag) ->
    (endedBy : Option (Ref kindEvent)) ->         -- projected; none = current
    (provenance : Provenance) ->
    (attrs : Attrs) ->
    Membership

mu CommercialStatus : Type 0 with
| statusOpen : CommercialStatus
| statusWon : CommercialStatus
| statusLost : CommercialStatus
| statusPaused : CommercialStatus

mu Commercial : Type 0 with
| makeCommercial :
    (kind : KindCommercial) ->
    (name : Text) ->
    (party : Ref kindParty) ->                    -- the customer org (or person, if B2C)
    (stage : Text) ->                             -- current projection
    (amountCents : Option Nat) ->                 -- pipeline number; not the legal amount
    (currency : Text) ->
    (expectedCloseOn : Option Text) ->            -- date
    (status : CommercialStatus) ->
    (attrs : Attrs) ->
    (lastEvent : Option (Ref kindEvent)) ->       -- projected; pointer into the log
    Commercial

mu CommitmentKind : Type 0 with
| commitmentPrice : CommitmentKind
| commitmentTerm : CommitmentKind
| commitmentDate : CommitmentKind
| commitmentScope : CommitmentKind
| commitmentSla : CommitmentKind

mu CommitmentStatus : Type 0 with
| commitmentProposed : CommitmentStatus
| commitmentAgreed : CommitmentStatus
| commitmentSuperseded : CommitmentStatus

mu Commitment : Type 0 with
| makeCommitment :
    (commercial : Ref kindCommercial) ->
    (kind : CommitmentKind) ->
    (label : Text) ->
    (value : Value) ->                            -- 18400000, "net_45", "2026-10-01"
    (unit : Option Text) ->
    (status : CommitmentStatus) ->
    (supersedes : Option (Ref kindCommitment)) -> -- valid from its own entry until the entry that supersedes it
    (provenance : Provenance) ->                  -- usually a signed quote / email artifact
    Commitment

mu ArtifactKind : Type 0 with
| artifactEmail : ArtifactKind
| artifactTranscript : ArtifactKind
| artifactPdf : ArtifactKind
| artifactSlack : ArtifactKind
| artifactNote : ArtifactKind
| artifactAudio : ArtifactKind

-- The capture time and the capturer are the position and the actor of its entry.
mu Artifact : Type 0 with
| makeArtifact :
    (kind : ArtifactKind) ->
    (sha256 : Text) ->                            -- content-addressed; never update in place
    (uri : Text) ->                               -- s3://... or file://...
    (mime : Text) ->
    (subjects : List Account) ->                  -- parties / commercials this is about
    (attrs : Attrs) ->                            -- from, to, duration_s, language
    Artifact

mu EventType : Type 0 with
| eventStageChanged : EventType
| eventAmountChanged : EventType
| eventAssignmentChanged : EventType
| eventCommitmentSet : EventType
| eventNoteAdded : EventType
| eventMessage : EventType
| eventMeeting : EventType
| eventCall : EventType
| eventApproval : EventType
| eventPolicyDenied : EventType
| eventFieldsChanged : EventType                  -- the four below replace in-place timestamp writes
| eventIdentifierVerified : EventType
| eventEnded : EventType
| eventDeleted : EventType

mu Event : Type 0 with
| makeEvent :
    (type : EventType) ->
    (subject : Subject) ->
    (artifact : Option (Ref kindArtifact)) ->
    (parent : Option (Ref kindEvent)) ->
    (payload : Attrs) ->                          -- before/after, channel, snippet
    (policy : Option (Ref kindPolicy)) ->         -- which rule allowed or denied this
    Event

mu AssignmentRole : Type 0 with
| roleOwner : AssignmentRole
| roleSdr : AssignmentRole
| roleSe : AssignmentRole
| roleCs : AssignmentRole
| roleOverlay : AssignmentRole

mu Assignment : Type 0 with
| makeAssignment :
    (subject : Account) ->
    (assignee : Ref kindParty) ->                 -- a human user, or the org Party that stands for a team
    (role : AssignmentRole) ->
    (territory : Option Text) ->
    (endedBy : Option (Ref kindEvent)) ->         -- projected; none = current
    (provenance : Provenance) ->
    Assignment

mu PolicyScope : Type 0 with
| scopeCommercial : (kind : KindCommercial) -> PolicyScope
| scopeParty : PolicyScope
| scopeAll : PolicyScope

mu Requirement : Type 0 with
| makeRequirement :
    (fields : Option (List Text)) ->              -- e.g. economic_buyer
    (commitmentKinds : Option (List CommitmentKind)) ->
    (approvalFrom : Option (List Text)) ->        -- roles
    (maxDiscountPct : Option Nat) ->
    Requirement

mu Permission : Type 0 with
| permissionRead : Permission
| permissionWrite : Permission
| permissionTransition : Permission
| permissionAssign : Permission

mu AclRule : Type 0 with
| makeAclRule :
    (principal : Text) ->                         -- role, person Ref, or agent name
    (can : List Permission) ->
    (fields : Option (List Text)) ->              -- none = all
    AclRule

mu Policy : Type 0 with
| makePolicy :
    (name : Text) ->
    (appliesTo : PolicyScope) ->
    (fromStage : Option Text) ->                  -- transition guard
    (toStage : Option Text) ->
    (require : Requirement) ->
    (acl : List AclRule) ->
    (active : Flag) ->
    Policy

-- What an entry creates. The constructor is the kind tag.
mu Body : Type 0 with
| createsParty : (party : Party) -> Body
| createsMembership : (membership : Membership) -> Body
| createsCommercial : (commercial : Commercial) -> Body
| createsCommitment : (commitment : Commitment) -> Body
| createsArtifact : (artifact : Artifact) -> Body
| createsEvent : (event : Event) -> Body
| createsAssignment : (assignment : Assignment) -> Body
| createsPolicy : (policy : Policy) -> Body

mu Entry : Type 0 with
| makeEntry :
    (prev : Option Hash) ->                       -- log head at append (none = first entry): gives the
                                                  -- order, and keeps two equal bodies from sharing a hash
    (actor : Actor) ->
    (body : Body) ->                              -- projected fields are none here
    Entry
