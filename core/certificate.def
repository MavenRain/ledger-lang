/* The fixed rows of the certificate module (M5 delta C-1, D4), in the row
   forms of compiler/certificate.c. The rows through mechRefl (the first
   DEFINE) are the copy of mechanism-lang prelude/init.mech lines 72 to 78.
   They come before the core rows. The other rows come after the core rows:
   the digits defs, the base encoders, the Value group and the encoders of
   Values, Attrs, Option and List. Each encoder puts the JSON bytes of its
   value in front of the tail. A row is one line, with no comma and no string
   literal. */

/* Equality keeps its endpoints erased and carries no constructor field. */
CARRIER(MechEq, (0 A : Type 0) (0 x : A) : (0 y : A) -> Prop)
  CONSTRUCTOR(mechReflCtor, MechEq A x x)
DEFINE(mechRefl, : (0 A : Type 0) -> (0 x : A) -> MechEq A x x := fun (0 A : Type 0) (0 x : A) => mechReflCtor)

/* The decimal digits of a Nat below 10^10. */
DEFINE(tenPowers, : List Nat := cons 1000000000 (cons 100000000 (cons 10000000 (cons 1000000 (cons 100000 (cons 10000 (cons 1000 (cons 100 (cons 10 nil)))))))))
DEFINE(digitAt, : Nat -> Nat -> Nat := fun (n : Nat) (p : Nat) => (case (natLt n (natMul 1 p)) as s1 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 2 p)) as s2 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 3 p)) as s3 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 4 p)) as s4 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 5 p)) as s5 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 6 p)) as s6 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 7 p)) as s7 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 8 p)) as s8 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 9 p)) as s9 return Nat with | 0 (no : prod ()) => 9 | 1 (yes : prod ()) => 8) | 1 (yes : prod ()) => 7) | 1 (yes : prod ()) => 6) | 1 (yes : prod ()) => 5) | 1 (yes : prod ()) => 4) | 1 (yes : prod ()) => 3) | 1 (yes : prod ()) => 2) | 1 (yes : prod ()) => 1) | 1 (yes : prod ()) => 0))
DEFINE_REC(digitTail, : List Nat -> Nat -> Text := fun (ps : List Nat) (n : Nat) => case ps as self in List return Text with | nil => textByte (natAdd 48 n) textEnd | cons (p : Nat) (rest : List Nat) => textByte (natAdd 48 (digitAt n p)) (digitTail rest (natSub n (natMul (digitAt n p) p))))
DEFINE_REC(digitLead, : List Nat -> Nat -> Text := fun (ps : List Nat) (n : Nat) => case ps as self in List return Text with | nil => textByte (natAdd 48 n) textEnd | cons (p : Nat) (rest : List Nat) => (case (natLt n p) as small return Text with | 0 (no : prod ()) => digitTail ps n | 1 (yes : prod ()) => digitLead rest n))
DEFINE(digits, : Nat -> Text := fun (n : Nat) => digitLead tenPowers n)

/* The base encoders. */
DEFINE_REC(textThen, : Text -> Text -> Text := fun (s : Text) (tail : Text) => case s as self in Text return Text with | textEnd => tail | textByte (b : Nat) (rest : Text) => textByte b (textThen rest tail))
DEFINE(hexLow, : Nat -> Nat := fun (d : Nat) => (case (natLt d 10) as s1 return Nat with | 0 (no : prod ()) => natAdd 87 d | 1 (yes : prod ()) => natAdd 48 d))
DEFINE(escapeLow, : Nat -> Text -> Text := fun (b : Nat) (tail : Text) => textByte 92 (textByte 117 (textByte 48 (textByte 48 (case (natLt b 16) as s1 return Text with | 0 (no : prod ()) => textByte 49 (textByte (hexLow (natSub b 16)) tail) | 1 (yes : prod ()) => textByte 48 (textByte (hexLow b) tail))))))
DEFINE(escapeByte, : Nat -> Text -> Text := fun (b : Nat) (tail : Text) => (case (natLt b 32) as s1 return Text with | 0 (no : prod ()) => (case (natEq b 34) as s2 return Text with | 0 (no : prod ()) => (case (natEq b 92) as s3 return Text with | 0 (no : prod ()) => textByte b tail | 1 (yes : prod ()) => textByte 92 (textByte 92 tail)) | 1 (yes : prod ()) => textByte 92 (textByte 34 tail)) | 1 (yes : prod ()) => escapeLow b tail))
DEFINE_REC(escapeThen, : Text -> Text -> Text := fun (s : Text) (tail : Text) => case s as self in Text return Text with | textEnd => textByte 34 tail | textByte (b : Nat) (rest : Text) => escapeByte b (escapeThen rest tail))
DEFINE(encodeText, : Text -> Text -> Text := fun (s : Text) (tail : Text) => textByte 34 (escapeThen s tail))
DEFINE(encodeNat, : Nat -> Text -> Text := fun (n : Nat) (tail : Text) => textThen (digits n) tail)
DEFINE(encodeFlag, : Flag -> Text -> Text := fun (b : Flag) (tail : Text) => case b as self in Flag return Text with | flagNo => textByte 102 (textByte 97 (textByte 108 (textByte 115 (textByte 101 tail)))) | flagYes => textByte 116 (textByte 114 (textByte 117 (textByte 101 tail))))
DEFINE(encodeHash, : Hash -> Text -> Text := fun (h : Hash) (tail : Text) => case h as self in Hash return Text with | hashOf (d : Text) => encodeText d tail)

/* The Value group: one mutual def rec group. */
DEFINE_REC(encodeValue, : Value -> Text -> Text := fun (v : Value) (tail : Text) => case v as sv in Value return Text with | valueNull => textByte 110 (textByte 117 (textByte 108 (textByte 108 tail))) | valueFlag (b : Flag) => encodeFlag b tail | valueNat (n : Nat) => encodeNat n tail | valueText (s : Text) => encodeText s tail | valueItems (vs : Values) => textByte 91 (encodeFirst vs tail) | valueAttrs (a : Attrs) => textByte 123 (encodeKeys a tail))
DEFINE_AND(encodeFirst, : Values -> Text -> Text := fun (vs : Values) (tail : Text) => case vs as s1 in Values return Text with | valuesEnd => textByte 93 tail | valuesItem (h : Value) (t : Values) => encodeValue h (encodeRest t tail))
DEFINE_AND(encodeRest, : Values -> Text -> Text := fun (vs : Values) (tail : Text) => case vs as s2 in Values return Text with | valuesEnd => textByte 93 tail | valuesItem (h : Value) (t : Values) => textByte 44 (encodeValue h (encodeRest t tail)))
DEFINE_AND(encodeKeys, : Attrs -> Text -> Text := fun (a : Attrs) (tail : Text) => case a as s3 in Attrs return Text with | attrsEnd => textByte 125 tail | attrsField (k : Text) (v : Value) (r : Attrs) => encodeText k (textByte 58 (encodeValue v (encodeMore r tail))))
DEFINE_AND(encodeMore, : Attrs -> Text -> Text := fun (a : Attrs) (tail : Text) => case a as s4 in Attrs return Text with | attrsEnd => textByte 125 tail | attrsField (k : Text) (v : Value) (r : Attrs) => textByte 44 (encodeText k (textByte 58 (encodeValue v (encodeMore r tail)))))

/* Values, Attrs, Option and List. The binder of the payload encoder is put.
   encodeOptionSome gives {"some":v} for a payload type that encodes null. */
DEFINE(encodeValues, : Values -> Text -> Text := fun (vs : Values) (tail : Text) => textByte 91 (encodeFirst vs tail))
DEFINE(encodeAttrs, : Attrs -> Text -> Text := fun (a : Attrs) (tail : Text) => textByte 123 (encodeKeys a tail))
DEFINE(encodeOptionBare, : (0 A : Type 0) -> (A -> Text -> Text) -> Option A -> Text -> Text := fun (0 A : Type 0) (put : A -> Text -> Text) (o : Option A) (tail : Text) => case o as self in Option return Text with | none => (textByte 110 (textByte 117 (textByte 108 (textByte 108 tail)))) | some (v : A) => put v tail)
DEFINE(encodeOptionSome, : (0 A : Type 0) -> (A -> Text -> Text) -> Option A -> Text -> Text := fun (0 A : Type 0) (put : A -> Text -> Text) (o : Option A) (tail : Text) => case o as self in Option return Text with | none => (textByte 110 (textByte 117 (textByte 108 (textByte 108 tail)))) | some (v : A) => (textByte 123 (textByte 34 (textByte 115 (textByte 111 (textByte 109 (textByte 101 (textByte 34 (textByte 58 (put v (textByte 125 tail)))))))))))
DEFINE_REC(encodeListRest, : (0 A : Type 0) -> (A -> Text -> Text) -> List A -> Text -> Text := fun (0 A : Type 0) (put : A -> Text -> Text) (l : List A) (tail : Text) => case l as self in List return Text with | nil => textByte 93 tail | cons (h : A) (t : List A) => textByte 44 (put h (encodeListRest A put t tail)))
DEFINE(encodeList, : (0 A : Type 0) -> (A -> Text -> Text) -> List A -> Text -> Text := fun (0 A : Type 0) (put : A -> Text -> Text) (l : List A) (tail : Text) => textByte 91 (case l as self in List return Text with | nil => textByte 93 tail | cons (h : A) (t : List A) => put h (encodeListRest A put t tail)))

/* SHA-256 (FIPS 180-4), the same steps as compiler/sha256.c. A word is a
   List Nat of 32 bits, the most significant bit first. shaKg0 to shaKg7 hold
   the 64 round constants in order, 8 in each row, and shaK is the chain of
   them. sha256Hex puts the 64 lowercase hex digits of the digest in front of
   the tail. */
DEFINE(shaC0, : List Nat := nil)
DEFINE(shaC1, : List Nat := (cons 0 nil))
DEFINE(shaC3, : List Nat := (cons 0 (cons 0 (cons 0 nil))))
DEFINE(shaC7, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))
DEFINE(shaC9, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))
DEFINE(shaC10, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))
DEFINE(shaC13, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))
DEFINE(shaC14, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))
DEFINE(shaC15, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))))
DEFINE(shaC19, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))))))))
DEFINE(shaC21, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))))))))))
DEFINE(shaC22, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))))))))))
DEFINE(shaC25, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))))))))))))))
DEFINE(shaC26, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))))))))))))))
DEFINE(shaC29, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))))))))))))))))))
DEFINE(shaC30, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))))))))))))))))))
DEFINE(shaC32, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))))))))))))))))))))
DEFINE(shaC48, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))))))))))))))))))))))))))))))))))))
DEFINE(shaPow35, : List Nat := (cons 17179869184 (cons 8589934592 (cons 4294967296 (cons 2147483648 (cons 1073741824 (cons 536870912 (cons 268435456 (cons 134217728 (cons 67108864 (cons 33554432 (cons 16777216 (cons 8388608 (cons 4194304 (cons 2097152 (cons 1048576 (cons 524288 (cons 262144 (cons 131072 (cons 65536 (cons 32768 (cons 16384 (cons 8192 (cons 4096 (cons 2048 (cons 1024 (cons 512 (cons 256 (cons 128 (cons 64 (cons 32 (cons 16 (cons 8 (cons 4 (cons 2 (cons 1 nil))))))))))))))))))))))))))))))))))))
DEFINE(shaPow32, : List Nat := (cons 2147483648 (cons 1073741824 (cons 536870912 (cons 268435456 (cons 134217728 (cons 67108864 (cons 33554432 (cons 16777216 (cons 8388608 (cons 4194304 (cons 2097152 (cons 1048576 (cons 524288 (cons 262144 (cons 131072 (cons 65536 (cons 32768 (cons 16384 (cons 8192 (cons 4096 (cons 2048 (cons 1024 (cons 512 (cons 256 (cons 128 (cons 64 (cons 32 (cons 16 (cons 8 (cons 4 (cons 2 (cons 1 nil)))))))))))))))))))))))))))))))))
DEFINE(shaIdx, : List Nat := (cons 0 (cons 1 (cons 2 (cons 3 (cons 4 (cons 5 (cons 6 (cons 7 (cons 8 (cons 9 (cons 10 (cons 11 (cons 12 (cons 13 (cons 14 (cons 15 (cons 16 (cons 17 (cons 18 (cons 19 (cons 20 (cons 21 (cons 22 (cons 23 (cons 24 (cons 25 (cons 26 (cons 27 (cons 28 (cons 29 (cons 30 (cons 31 (cons 32 (cons 33 (cons 34 (cons 35 (cons 36 (cons 37 (cons 38 (cons 39 (cons 40 (cons 41 (cons 42 (cons 43 (cons 44 (cons 45 (cons 46 (cons 47 (cons 48 (cons 49 (cons 50 (cons 51 (cons 52 (cons 53 (cons 54 (cons 55 (cons 56 (cons 57 (cons 58 (cons 59 (cons 60 (cons 61 (cons 62 (cons 63 nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
DEFINE(shaKg0, : List Nat := (cons 1116352408 (cons 1899447441 (cons 3049323471 (cons 3921009573 (cons 961987163 (cons 1508970993 (cons 2453635748 (cons 2870763221 nil)))))))))
DEFINE(shaKg1, : List Nat := (cons 3624381080 (cons 310598401 (cons 607225278 (cons 1426881987 (cons 1925078388 (cons 2162078206 (cons 2614888103 (cons 3248222580 nil)))))))))
DEFINE(shaKg2, : List Nat := (cons 3835390401 (cons 4022224774 (cons 264347078 (cons 604807628 (cons 770255983 (cons 1249150122 (cons 1555081692 (cons 1996064986 nil)))))))))
DEFINE(shaKg3, : List Nat := (cons 2554220882 (cons 2821834349 (cons 2952996808 (cons 3210313671 (cons 3336571891 (cons 3584528711 (cons 113926993 (cons 338241895 nil)))))))))
DEFINE(shaKg4, : List Nat := (cons 666307205 (cons 773529912 (cons 1294757372 (cons 1396182291 (cons 1695183700 (cons 1986661051 (cons 2177026350 (cons 2456956037 nil)))))))))
DEFINE(shaKg5, : List Nat := (cons 2730485921 (cons 2820302411 (cons 3259730800 (cons 3345764771 (cons 3516065817 (cons 3600352804 (cons 4094571909 (cons 275423344 nil)))))))))
DEFINE(shaKg6, : List Nat := (cons 430227734 (cons 506948616 (cons 659060556 (cons 883997877 (cons 958139571 (cons 1322822218 (cons 1537002063 (cons 1747873779 nil)))))))))
DEFINE(shaKg7, : List Nat := (cons 1955562222 (cons 2024104815 (cons 2227730452 (cons 2361852424 (cons 2428436474 (cons 2756734187 (cons 3204031479 (cons 3329325298 nil)))))))))
DEFINE(shaMaj, : Nat -> Nat -> Nat -> Nat := fun (a : Nat) (b : Nat) (c : Nat) => (case (natLt 1 (natAdd a (natAdd b c))) as s1 return Nat with | 0 (no : prod ()) => 0 | 1 (yes : prod ()) => 1))
DEFINE(shaXor3, : Nat -> Nat -> Nat -> Nat := fun (a : Nat) (b : Nat) (c : Nat) => natSub (natAdd a (natAdd b c)) (natMul 2 (shaMaj a b c)))
DEFINE(shaCh, : Nat -> Nat -> Nat -> Nat := fun (e : Nat) (f : Nat) (g : Nat) => natAdd (natMul e f) (natMul (natSub 1 e) g))
DEFINE_REC(shaZip3, : (Nat -> Nat -> Nat -> Nat) -> List Nat -> List Nat -> List Nat -> List Nat := fun (op : Nat -> Nat -> Nat -> Nat) (x : List Nat) (y : List Nat) (z : List Nat) => case x as s1 in List return List Nat with | nil => nil | cons (a : Nat) (xr : List Nat) => (case y as s2 in List return List Nat with | nil => nil | cons (b : Nat) (yr : List Nat) => (case z as s3 in List return List Nat with | nil => nil | cons (c : Nat) (zr : List Nat) => cons (op a b c) (shaZip3 op xr yr zr))))
DEFINE_REC(shaTake, : List Nat -> List Nat -> List Nat := fun (c : List Nat) (l : List Nat) => case c as s1 in List return List Nat with | nil => nil | cons (u : Nat) (cr : List Nat) => (case l as s2 in List return List Nat with | nil => nil | cons (b : Nat) (lr : List Nat) => cons b (shaTake cr lr)))
DEFINE_REC(shaDrop, : List Nat -> List Nat -> List Nat := fun (c : List Nat) (l : List Nat) => case c as s1 in List return List Nat with | nil => l | cons (u : Nat) (cr : List Nat) => (case l as s2 in List return List Nat with | nil => nil | cons (b : Nat) (lr : List Nat) => shaDrop cr lr))
DEFINE_REC(shaAppend, : List Nat -> List Nat -> List Nat := fun (x : List Nat) (y : List Nat) => case x as s1 in List return List Nat with | nil => y | cons (b : Nat) (xr : List Nat) => cons b (shaAppend xr y))
DEFINE(shaK, : List Nat := (shaAppend shaKg0 (shaAppend shaKg1 (shaAppend shaKg2 (shaAppend shaKg3 (shaAppend shaKg4 (shaAppend shaKg5 (shaAppend shaKg6 shaKg7))))))))
DEFINE(shaRotr, : List Nat -> List Nat -> List Nat := fun (c : List Nat) (x : List Nat) => shaAppend (shaDrop c x) (shaTake c x))
DEFINE_REC(shaValue, : List Nat -> Nat -> Nat := fun (l : List Nat) (acc : Nat) => case l as s1 in List return Nat with | nil => acc | cons (b : Nat) (r : List Nat) => shaValue r (natAdd (natMul 2 acc) b))
DEFINE_REC(shaBits, : List Nat -> Nat -> List Nat := fun (ps : List Nat) (n : Nat) => case ps as s1 in List return List Nat with | nil => nil | cons (p : Nat) (r : List Nat) => (case (natLt n p) as s2 return List Nat with | 0 (no : prod ()) => cons 1 (shaBits r (natSub n p)) | 1 (yes : prod ()) => cons 0 (shaBits r n)))
DEFINE(shaWord, : List Nat -> Nat := fun (x : List Nat) => shaValue x 0)
DEFINE(shaMod, : Nat -> List Nat := fun (n : Nat) => shaDrop shaC3 (shaBits shaPow35 n))
DEFINE(shaBigS0, : List Nat -> List Nat := fun (x : List Nat) => shaZip3 shaXor3 (shaRotr shaC30 x) (shaRotr shaC19 x) (shaRotr shaC10 x))
DEFINE(shaBigS1, : List Nat -> List Nat := fun (x : List Nat) => shaZip3 shaXor3 (shaRotr shaC26 x) (shaRotr shaC21 x) (shaRotr shaC7 x))
DEFINE(shaSmallS0, : List Nat -> List Nat := fun (x : List Nat) => shaZip3 shaXor3 (shaRotr shaC25 x) (shaRotr shaC14 x) (shaAppend shaC3 (shaTake shaC29 x)))
DEFINE(shaSmallS1, : List Nat -> List Nat := fun (x : List Nat) => shaZip3 shaXor3 (shaRotr shaC15 x) (shaRotr shaC13 x) (shaAppend shaC10 (shaTake shaC22 x)))
DEFINE_REC(shaNth, : List Nat -> List (List Nat) -> List Nat := fun (c : List Nat) (l : List (List Nat)) => case c as s1 in List return List Nat with | nil => (case l as s2 in List return List Nat with | nil => nil | cons (x : List Nat) (lr : List (List Nat)) => x) | cons (u : Nat) (cr : List Nat) => (case l as s3 in List return List Nat with | nil => nil | cons (y : List Nat) (lr : List (List Nat)) => shaNth cr lr))
DEFINE_REC(shaSnoc, : List (List Nat) -> List Nat -> List (List Nat) := fun (l : List (List Nat)) (x : List Nat) => case l as s1 in List return List (List Nat) with | nil => cons x nil | cons (y : List Nat) (lr : List (List Nat)) => cons y (shaSnoc lr x))
DEFINE(shaNext, : List (List Nat) -> List Nat := fun (win : List (List Nat)) => shaMod (natAdd (shaWord (shaSmallS1 (shaNth shaC14 win))) (natAdd (shaWord (shaNth shaC9 win)) (natAdd (shaWord (shaSmallS0 (shaNth shaC1 win))) (shaWord (shaNth shaC0 win))))))
DEFINE_REC(shaSched, : List Nat -> List (List Nat) -> List (List Nat) := fun (c : List Nat) (win : List (List Nat)) => case c as s1 in List return List (List Nat) with | nil => win | cons (u : Nat) (cr : List Nat) => (case win as s2 in List return List (List Nat) with | nil => nil | cons (w0 : List Nat) (wr : List (List Nat)) => cons w0 (shaSched cr (shaSnoc wr (shaNext win)))))
DEFINE(shaRoundEnd, : Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List (List Nat) := fun (t1 : Nat) (a : List Nat) (b : List Nat) (c : List Nat) (d : List Nat) (e : List Nat) (f : List Nat) (g : List Nat) => cons (shaMod (natAdd t1 (natAdd (shaWord (shaBigS0 a)) (shaWord (shaZip3 shaMaj a b c))))) (cons a (cons b (cons c (cons (shaMod (natAdd (shaWord d) t1)) (cons e (cons f (cons g nil))))))))
DEFINE(shaRoundWith, : Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List (List Nat) := fun (k : Nat) (w : List Nat) (a : List Nat) (b : List Nat) (c : List Nat) (d : List Nat) (e : List Nat) (f : List Nat) (g : List Nat) (h : List Nat) => shaRoundEnd (natAdd (shaWord h) (natAdd (shaWord (shaBigS1 e)) (natAdd (shaWord (shaZip3 shaCh e f g)) (natAdd k (shaWord w))))) a b c d e f g)
DEFINE(shaRound, : Nat -> List Nat -> List (List Nat) -> List (List Nat) := fun (k : Nat) (w : List Nat) (st : List (List Nat)) => (case st as q1 in List return List (List Nat) with | nil => st | cons (a : List Nat) (r1 : List (List Nat)) => (case r1 as q2 in List return List (List Nat) with | nil => st | cons (b : List Nat) (r2 : List (List Nat)) => (case r2 as q3 in List return List (List Nat) with | nil => st | cons (c : List Nat) (r3 : List (List Nat)) => (case r3 as q4 in List return List (List Nat) with | nil => st | cons (d : List Nat) (r4 : List (List Nat)) => (case r4 as q5 in List return List (List Nat) with | nil => st | cons (e : List Nat) (r5 : List (List Nat)) => (case r5 as q6 in List return List (List Nat) with | nil => st | cons (f : List Nat) (r6 : List (List Nat)) => (case r6 as q7 in List return List (List Nat) with | nil => st | cons (g : List Nat) (r7 : List (List Nat)) => (case r7 as q8 in List return List (List Nat) with | nil => st | cons (h : List Nat) (r8 : List (List Nat)) => shaRoundWith k w a b c d e f g h)))))))))
DEFINE_REC(shaRounds, : List Nat -> List (List Nat) -> List (List Nat) -> List (List Nat) := fun (ks : List Nat) (ws : List (List Nat)) (st : List (List Nat)) => case ks as s1 in List return List (List Nat) with | nil => st | cons (k : Nat) (kr : List Nat) => (case ws as s2 in List return List (List Nat) with | nil => st | cons (w : List Nat) (wr : List (List Nat)) => shaRounds kr wr (shaRound k w st)))
DEFINE_REC(shaAddState, : List (List Nat) -> List (List Nat) -> List (List Nat) := fun (x : List (List Nat)) (y : List (List Nat)) => case x as s1 in List return List (List Nat) with | nil => nil | cons (a : List Nat) (xr : List (List Nat)) => (case y as s2 in List return List (List Nat) with | nil => nil | cons (b : List Nat) (yr : List (List Nat)) => cons (shaMod (natAdd (shaWord a) (shaWord b))) (shaAddState xr yr)))
DEFINE_REC(shaCompress, : List (List (List Nat)) -> List (List Nat) -> List (List Nat) := fun (bs : List (List (List Nat))) (st : List (List Nat)) => case bs as s1 in List return List (List Nat) with | nil => st | cons (b : List (List Nat)) (br : List (List (List Nat))) => shaCompress br (shaAddState st (shaRounds shaK (shaSched shaC48 b) st)))
DEFINE(shaH, : List (List Nat) := (cons (shaBits shaPow32 1779033703) (cons (shaBits shaPow32 3144134277) (cons (shaBits shaPow32 1013904242) (cons (shaBits shaPow32 2773480762) (cons (shaBits shaPow32 1359893119) (cons (shaBits shaPow32 2600822924) (cons (shaBits shaPow32 528734635) (cons (shaBits shaPow32 1541459225) nil)))))))))
DEFINE_REC(shaBytes, : Text -> List Nat -> List Nat := fun (s : Text) (tail : List Nat) => case s as s1 in Text return List Nat with | textEnd => tail | textByte (b : Nat) (r : Text) => cons b (shaBytes r tail))
DEFINE_REC(shaLen, : Text -> Nat -> Nat := fun (s : Text) (n : Nat) => case s as s1 in Text return Nat with | textEnd => n | textByte (b : Nat) (r : Text) => shaLen r (natAdd n 1))
DEFINE_REC(shaLenMod, : Text -> Nat -> Nat := fun (s : Text) (m : Nat) => case s as s1 in Text return Nat with | textEnd => m | textByte (b : Nat) (r : Text) => shaLenMod r (case (natEq m 63) as s2 return Nat with | 0 (no : prod ()) => natAdd m 1 | 1 (yes : prod ()) => 0))
DEFINE(shaPadCount, : Nat -> Nat := fun (r : Nat) => (case (natLt r 56) as s1 return Nat with | 0 (no : prod ()) => natSub 119 r | 1 (yes : prod ()) => natSub 55 r))
DEFINE_REC(shaPadZeros, : List Nat -> Nat -> List Nat -> List Nat := fun (ix : List Nat) (z : Nat) (tail : List Nat) => case ix as s1 in List return List Nat with | nil => tail | cons (i : Nat) (ir : List Nat) => (case (natLt i z) as s2 return List Nat with | 0 (no : prod ()) => shaPadZeros ir z tail | 1 (yes : prod ()) => cons 0 (shaPadZeros ir z tail)))
DEFINE_REC(shaWords, : List Nat -> List (List Nat) -> List (List Nat) := fun (l : List Nat) (tail : List (List Nat)) => case l as q0 in List return List (List Nat) with | nil => tail | cons (b0 : Nat) (l1 : List Nat) => (case l1 as q1 in List return List (List Nat) with | nil => tail | cons (b1 : Nat) (l2 : List Nat) => (case l2 as q2 in List return List (List Nat) with | nil => tail | cons (b2 : Nat) (l3 : List Nat) => (case l3 as q3 in List return List (List Nat) with | nil => tail | cons (b3 : Nat) (l4 : List Nat) => cons (shaBits shaPow32 (natAdd (natMul 16777216 b0) (natAdd (natMul 65536 b1) (natAdd (natMul 256 b2) b3)))) (shaWords l4 tail)))))
DEFINE_REC(shaBlocks, : List (List Nat) -> List (List (List Nat)) := fun (ws : List (List Nat)) => case ws as q0 in List return List (List (List Nat)) with | nil => nil | cons (x0 : List Nat) (w1 : List (List Nat)) => (case w1 as q1 in List return List (List (List Nat)) with | nil => nil | cons (x1 : List Nat) (w2 : List (List Nat)) => (case w2 as q2 in List return List (List (List Nat)) with | nil => nil | cons (x2 : List Nat) (w3 : List (List Nat)) => (case w3 as q3 in List return List (List (List Nat)) with | nil => nil | cons (x3 : List Nat) (w4 : List (List Nat)) => (case w4 as q4 in List return List (List (List Nat)) with | nil => nil | cons (x4 : List Nat) (w5 : List (List Nat)) => (case w5 as q5 in List return List (List (List Nat)) with | nil => nil | cons (x5 : List Nat) (w6 : List (List Nat)) => (case w6 as q6 in List return List (List (List Nat)) with | nil => nil | cons (x6 : List Nat) (w7 : List (List Nat)) => (case w7 as q7 in List return List (List (List Nat)) with | nil => nil | cons (x7 : List Nat) (w8 : List (List Nat)) => (case w8 as q8 in List return List (List (List Nat)) with | nil => nil | cons (x8 : List Nat) (w9 : List (List Nat)) => (case w9 as q9 in List return List (List (List Nat)) with | nil => nil | cons (x9 : List Nat) (w10 : List (List Nat)) => (case w10 as q10 in List return List (List (List Nat)) with | nil => nil | cons (x10 : List Nat) (w11 : List (List Nat)) => (case w11 as q11 in List return List (List (List Nat)) with | nil => nil | cons (x11 : List Nat) (w12 : List (List Nat)) => (case w12 as q12 in List return List (List (List Nat)) with | nil => nil | cons (x12 : List Nat) (w13 : List (List Nat)) => (case w13 as q13 in List return List (List (List Nat)) with | nil => nil | cons (x13 : List Nat) (w14 : List (List Nat)) => (case w14 as q14 in List return List (List (List Nat)) with | nil => nil | cons (x14 : List Nat) (w15 : List (List Nat)) => (case w15 as q15 in List return List (List (List Nat)) with | nil => nil | cons (x15 : List Nat) (w16 : List (List Nat)) => (cons (cons x0 (cons x1 (cons x2 (cons x3 (cons x4 (cons x5 (cons x6 (cons x7 (cons x8 (cons x9 (cons x10 (cons x11 (cons x12 (cons x13 (cons x14 (cons x15 nil)))))))))))))))) (shaBlocks w16))))))))))))))))))
DEFINE_REC(shaHexBits, : List Nat -> Text -> Text := fun (l : List Nat) (tail : Text) => case l as q0 in List return Text with | nil => tail | cons (b3 : Nat) (l1 : List Nat) => (case l1 as q1 in List return Text with | nil => tail | cons (b2 : Nat) (l2 : List Nat) => (case l2 as q2 in List return Text with | nil => tail | cons (b1 : Nat) (l3 : List Nat) => (case l3 as q3 in List return Text with | nil => tail | cons (b0 : Nat) (l4 : List Nat) => textByte (hexLow (natAdd (natMul 8 b3) (natAdd (natMul 4 b2) (natAdd (natMul 2 b1) b0)))) (shaHexBits l4 tail)))))
DEFINE_REC(shaHexWords, : List (List Nat) -> Text -> Text := fun (l : List (List Nat)) (tail : Text) => case l as s1 in List return Text with | nil => tail | cons (x : List Nat) (r : List (List Nat)) => shaHexBits x (shaHexWords r tail))
DEFINE(sha256Hex, : Text -> Text -> Text := fun (s : Text) (tail : Text) => shaHexWords (shaCompress (shaBlocks (shaWords (shaBytes s (cons 128 (shaPadZeros shaIdx (shaPadCount (shaLenMod s 0)) nil))) (cons shaC32 (cons (shaBits shaPow32 (natMul 8 (shaLen s 0))) nil)))) shaH) tail)

/* Byte equality of two Texts. */
DEFINE_REC(textSame, : Text -> Text -> Flag := fun (s : Text) (t : Text) => case s as s1 in Text return Flag with | textEnd => (case t as s2 in Text return Flag with | textEnd => flagYes | textByte (c : Nat) (tr : Text) => flagNo) | textByte (b : Nat) (sr : Text) => (case t as s3 in Text return Flag with | textEnd => flagNo | textByte (c : Nat) (tr : Text) => (case (natEq b c) as s4 return Flag with | 0 (no : prod ()) => flagNo | 1 (yes : prod ()) => textSame sr tr)))

/* The write path (M5 delta D-1 (a), checker.c write_step): the Command to
   Body table (checker.c write_bodies and write_party_body), the last entry
   of a log, the end of a log, and writeWith. hs gives the hash text of an
   Entry (a generated row). A hash is made only in an arm where write_step
   makes it. */
DEFINE_REC(writeLast, : List Entry -> Option Entry -> Option Entry := fun (l : List Entry) (o : Option Entry) => case l as s1 in List return Option Entry with | nil => o | cons (e : Entry) (r : List Entry) => writeLast r (some e))
DEFINE_REC(writeSnoc, : List Entry -> Entry -> List Entry := fun (l : List Entry) (e : Entry) => case l as s1 in List return List Entry with | nil => cons e nil | cons (x : Entry) (r : List Entry) => cons x (writeSnoc r e))
DEFINE(writeAdd, : (Entry -> Text) -> Log -> Entry -> Option (Ref kindPolicy) -> Step := fun (hs : Entry -> Text) (lg : Log) (e : Entry) (o : Option (Ref kindPolicy)) => makeStep (writeSnoc lg e) (outcomeAppended (cons (hashOf (hs e)) nil) o))
DEFINE_REC(entryHashes, : (Entry -> Text) -> List Entry -> List Hash := fun (hs : Entry -> Text) (l : List Entry) => case l as s1 in List return List Hash with | nil => nil | cons (e : Entry) (r : List Entry) => cons (hashOf (hs e)) (entryHashes hs r))
DEFINE_REC(writeSnocs, : List Entry -> List Entry -> List Entry := fun (lg : List Entry) (l : List Entry) => case l as s1 in List return List Entry with | nil => lg | cons (e : Entry) (r : List Entry) => writeSnocs (writeSnoc lg e) r)
DEFINE(writeAdds, : (Entry -> Text) -> Log -> List Entry -> Option (Ref kindPolicy) -> Step := fun (hs : Entry -> Text) (lg : Log) (es : List Entry) (o : Option (Ref kindPolicy)) => makeStep (writeSnocs lg es) (outcomeAppended (entryHashes hs es) o))
DEFINE(writeOld, : (Entry -> Text) -> Log -> Option Hash -> Actor -> Body -> Text -> Option (Ref kindPolicy) -> Step := fun (hs : Entry -> Text) (lg : Log) (x : Option Hash) (a : Actor) (b : Body) (hd : Text) (o : Option (Ref kindPolicy)) => case x as s1 in Option return Step with | none => writeAdd hs lg (makeEntry (some (hashOf hd)) a b) o | some (h : Hash) => (case h as s2 in Hash return Step with | hashOf (d : Text) => (case (textSame d hd) as s3 in Flag return Step with | flagNo => makeStep lg (outcomeConflict (hashOf hd)) | flagYes => writeAdd hs lg (makeEntry (some (hashOf hd)) a b) o)))
DEFINE(writeOldM, : (Entry -> Text) -> Log -> Option Hash -> Actor -> Body -> (Entry -> List Entry) -> Text -> Option (Ref kindPolicy) -> Step := fun (hs : Entry -> Text) (lg : Log) (x : Option Hash) (a : Actor) (b : Body) (n : Entry -> List Entry) (hd : Text) (o : Option (Ref kindPolicy)) => case x as s1 in Option return Step with | none => writeAdds hs lg (n (makeEntry (some (hashOf hd)) a b)) o | some (h : Hash) => (case h as s2 in Hash return Step with | hashOf (d : Text) => (case (textSame d hd) as s3 in Flag return Step with | flagNo => makeStep lg (outcomeConflict (hashOf hd)) | flagYes => writeAdds hs lg (n (makeEntry (some (hashOf hd)) a b)) o)))
DEFINE(stepLog, : Step -> Log := fun (t : Step) => case t as s1 in Step return Log with | makeStep (lg : Log) (o : Outcome) => lg)

/* The records (M5 delta D-1 (a), program.c project_records): a fold over
   the feeding logs in definition order and their entries in log order, the
   records oldest first. A record is the hash text of its creating entry and
   its Body (the tag gives the type, the payload the state). upd sets
   lastEvent on a Body payload and put encodes one record (generated rows). */
FAMILY(Record, : Type 0)
  CONSTRUCTOR(makeRecord, Record) FIELD(ref, Text) FIELD(state, Body)
DEFINE_REC(recordsKnown, : List Record -> Text -> Flag := fun (rs : List Record) (h : Text) => case rs as s1 in List return Flag with | nil => flagNo | cons (r : Record) (rr : List Record) => (case r as s2 in Record return Flag with | makeRecord (x : Text) (b : Body) => (case (textSame x h) as s3 in Flag return Flag with | flagNo => recordsKnown rr h | flagYes => flagYes)))
DEFINE_REC(recordsSet, : List Record -> (Body -> Body) -> Text -> List Record := fun (rs : List Record) (f : Body -> Body) (h : Text) => case rs as s1 in List return List Record with | nil => nil | cons (r : Record) (rr : List Record) => cons (case r as s2 in Record return Record with | makeRecord (x : Text) (b : Body) => (case (textSame x h) as s3 in Flag return Record with | flagNo => makeRecord x b | flagYes => makeRecord x (f b))) (recordsSet rr f h))
DEFINE_REC(recordsSnoc, : List Record -> Record -> List Record := fun (rs : List Record) (r : Record) => case rs as s1 in List return List Record with | nil => cons r nil | cons (x : Record) (rr : List Record) => cons x (recordsSnoc rr r))
DEFINE(refText, : (0 k : Kind) -> Ref k -> Text := fun (0 k : Kind) (r : Ref k) => case r as s1 in Ref return Text with | refTo (h : Hash) => (case h as s2 in Hash return Text with | hashOf (d : Text) => d))
DEFINE(recordsSubject, : Body -> Option Text := fun (b : Body) => case b as s1 in Body return Option Text with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (e : Event) => (case e as s2 in Event return Option Text with | makeEvent (y : EventType) (j : Subject) (f : Option (Ref kindArtifact)) (q : Option (Ref kindEvent)) (v : Attrs) (g : Option (Ref kindPolicy)) => (case j as s3 in Subject return Option Text with | subjectParty (r : Ref kindParty) => some (refText kindParty r) | subjectMembership (r : Ref kindMembership) => some (refText kindMembership r) | subjectCommercial (r : Ref kindCommercial) => some (refText kindCommercial r) | subjectCommitment (r : Ref kindCommitment) => some (refText kindCommitment r) | subjectAssignment (r : Ref kindAssignment) => some (refText kindAssignment r))) | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(keyMergedInto, : Text := textByte 109 (textByte 101 (textByte 114 (textByte 103 (textByte 101 (textByte 100 (textByte 73 (textByte 110 (textByte 116 (textByte 111 textEnd))))))))))
DEFINE(membershipKey, : Text := textByte 109 (textByte 101 (textByte 109 (textByte 98 (textByte 101 (textByte 114 (textByte 115 (textByte 104 (textByte 105 (textByte 112 (textEnd)))))))))))
DEFINE(primaryKey, : Text := textByte 105 (textByte 115 (textByte 80 (textByte 114 (textByte 105 (textByte 109 (textByte 97 (textByte 114 (textByte 121 (textEnd))))))))))
/* M7 part C2 (deltas MC-2, MC-3): the keys amountCents and status, the
   tag of a CommercialStatus as text, and an Option Nat as a Value. */
DEFINE(amountKey, : Text := textByte 97 (textByte 109 (textByte 111 (textByte 117 (textByte 110 (textByte 116 (textByte 67 (textByte 101 (textByte 110 (textByte 116 (textByte 115 textEnd)))))))))))
DEFINE(statusKey, : Text := textByte 115 (textByte 116 (textByte 97 (textByte 116 (textByte 117 (textByte 115 textEnd))))))
DEFINE(commitmentKey, : Text := textByte 99 (textByte 111 (textByte 109 (textByte 109 (textByte 105 (textByte 116 (textByte 109 (textByte 101 (textByte 110 (textByte 116 textEnd))))))))))
DEFINE(agreedText, : Text := textByte 99 (textByte 111 (textByte 109 (textByte 109 (textByte 105 (textByte 116 (textByte 109 (textByte 101 (textByte 110 (textByte 116 (textByte 65 (textByte 103 (textByte 114 (textByte 101 (textByte 101 (textByte 100 textEnd))))))))))))))))
DEFINE(statusText, : CommercialStatus -> Text := fun (k : CommercialStatus) => case k as s1 in CommercialStatus return Text with | statusOpen => textByte 115 (textByte 116 (textByte 97 (textByte 116 (textByte 117 (textByte 115 (textByte 79 (textByte 112 (textByte 101 (textByte 110 textEnd))))))))) | statusWon => textByte 115 (textByte 116 (textByte 97 (textByte 116 (textByte 117 (textByte 115 (textByte 87 (textByte 111 (textByte 110 textEnd)))))))) | statusLost => textByte 115 (textByte 116 (textByte 97 (textByte 116 (textByte 117 (textByte 115 (textByte 76 (textByte 111 (textByte 115 (textByte 116 textEnd))))))))) | statusPaused => textByte 115 (textByte 116 (textByte 97 (textByte 116 (textByte 117 (textByte 115 (textByte 80 (textByte 97 (textByte 117 (textByte 115 (textByte 101 (textByte 100 textEnd))))))))))))
DEFINE(natValue, : Option Nat -> Value := fun (o : Option Nat) => case o as s1 in Option return Value with | none => valueNull | some (n : Nat) => valueNat n)
DEFINE(partyRepoint, : Text -> Text -> Ref kindParty -> Ref kindParty := fun (d : Text) (k : Text) (r : Ref kindParty) => case (textSame (refText kindParty r) d) as s1 in Flag return Ref kindParty with | flagNo => r | flagYes => refTo (hashOf k))
DEFINE(accountRepoint, : Text -> Text -> Account -> Account := fun (d : Text) (k : Text) (c : Account) => case c as s1 in Account return Account with | accountParty (p : Ref kindParty) => accountParty (partyRepoint d k p) | accountCommercial (m : Ref kindCommercial) => accountCommercial m)
DEFINE_REC(accountsRepoint, : Text -> Text -> List Account -> List Account := fun (d : Text) (k : Text) (l : List Account) => case l as s1 in List return List Account with | nil => nil | cons (c : Account) (r : List Account) => cons (accountRepoint d k c) (accountsRepoint d k r))
DEFINE(bodyRepoint, : Text -> Text -> Body -> Body := fun (d : Text) (k : Text) (b : Body) => case b as s1 in Body return Body with | createsParty (m : Party) => createsParty m | createsMembership (m : Membership) => createsMembership (case m as s2 in Membership return Membership with | makeMembership (x0 : Ref kindParty) (x1 : Ref kindParty) (x2 : Option Text) (x3 : Flag) (x4 : Option (Ref kindEvent)) (x5 : Provenance) (x6 : Attrs) => makeMembership (partyRepoint d k x0) (partyRepoint d k x1) x2 x3 x4 x5 x6) | createsCommercial (m : Commercial) => createsCommercial (case m as s2 in Commercial return Commercial with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => makeCommercial x0 x1 (partyRepoint d k x2) x3 x4 x5 x6 x7 x8 x9) | createsCommitment (m : Commitment) => createsCommitment m | createsArtifact (m : Artifact) => createsArtifact (case m as s2 in Artifact return Artifact with | makeArtifact (x0 : ArtifactKind) (x1 : Text) (x2 : Text) (x3 : Text) (x4 : List Account) (x5 : Attrs) => makeArtifact x0 x1 x2 x3 (accountsRepoint d k x4) x5) | createsEvent (m : Event) => createsEvent m | createsAssignment (m : Assignment) => createsAssignment (case m as s2 in Assignment return Assignment with | makeAssignment (x0 : Account) (x1 : Ref kindParty) (x2 : AssignmentRole) (x3 : Option Text) (x4 : Option (Ref kindEvent)) (x5 : Provenance) => makeAssignment (accountRepoint d k x0) (partyRepoint d k x1) x2 x3 x4 x5) | createsPolicy (m : Policy) => createsPolicy m)
DEFINE_REC(recordsRepoint, : Text -> Text -> List Record -> List Record := fun (d : Text) (k : Text) (rs : List Record) => case rs as s1 in List return List Record with | nil => nil | cons (r : Record) (rr : List Record) => cons (case r as s2 in Record return Record with | makeRecord (x : Text) (b : Body) => makeRecord x (bodyRepoint d k b)) (recordsRepoint d k rr))
DEFINE_REC(attrsInto, : Attrs -> Option Text := fun (a : Attrs) => case a as s1 in Attrs return Option Text with | attrsEnd => none | attrsField (t : Text) (v : Value) (r : Attrs) => (case (textSame t keyMergedInto) as s2 in Flag return Option Text with | flagNo => attrsInto r | flagYes => (case v as s3 in Value return Option Text with | valueNull => none | valueFlag (f : Flag) => none | valueNat (c : Nat) => none | valueText (u : Text) => some u | valueItems (i : Values) => none | valueAttrs (n : Attrs) => none)))
DEFINE(etDeleted, : EventType -> Flag := fun (t : EventType) => case t as s1 in EventType return Flag with | eventStageChanged => flagNo | eventAmountChanged => flagNo | eventAssignmentChanged => flagNo | eventCommitmentSet => flagNo | eventNoteAdded => flagNo | eventMessage => flagNo | eventMeeting => flagNo | eventCall => flagNo | eventApproval => flagNo | eventPolicyDenied => flagNo | eventFieldsChanged => flagNo | eventIdentifierVerified => flagNo | eventEnded => flagNo | eventDeleted => flagYes)
DEFINE(recordsMerged, : List Record -> Body -> List Record := fun (rs : List Record) (b : Body) => case b as s1 in Body return List Record with | createsParty (m : Party) => rs | createsMembership (m : Membership) => rs | createsCommercial (m : Commercial) => rs | createsCommitment (m : Commitment) => rs | createsArtifact (m : Artifact) => rs | createsEvent (e : Event) => (case e as s2 in Event return List Record with | makeEvent (y : EventType) (j : Subject) (f : Option (Ref kindArtifact)) (q : Option (Ref kindEvent)) (v : Attrs) (g : Option (Ref kindPolicy)) => (case (etDeleted y) as s3 in Flag return List Record with | flagNo => rs | flagYes => (case j as s4 in Subject return List Record with | subjectParty (r : Ref kindParty) => (case (attrsInto v) as s5 in Option return List Record with | none => rs | some (k : Text) => recordsRepoint (refText kindParty r) k rs) | subjectMembership (r : Ref kindMembership) => rs | subjectCommercial (r : Ref kindCommercial) => rs | subjectCommitment (r : Ref kindCommitment) => rs | subjectAssignment (r : Ref kindAssignment) => rs))) | createsAssignment (m : Assignment) => rs | createsPolicy (m : Policy) => rs)
DEFINE(flagAnd, : Flag -> Flag -> Flag := fun (a : Flag) (b : Flag) => case a as s1 in Flag return Flag with | flagNo => flagNo | flagYes => b)
DEFINE(flagOr, : Flag -> Flag -> Flag := fun (a : Flag) (b : Flag) => case a as s1 in Flag return Flag with | flagNo => b | flagYes => flagYes)
DEFINE(flagNot, : Flag -> Flag := fun (a : Flag) => case a as s1 in Flag return Flag with | flagNo => flagYes | flagYes => flagNo)
/* M7 part C (delta MC-5, program.c projection_primary_slots): an
   eventFieldsChanged with isPrimary = flagYes on a Membership sets isPrimary
   = flagNo on each other current (endedBy none) Membership record of the same
   person. An ended one keeps its flag. recordsAdd runs it after
   recordsMerged. */
DEFINE(etPrimary, : EventType -> Flag := fun (t : EventType) => case t as s1 in EventType return Flag with | eventStageChanged => flagNo | eventAmountChanged => flagNo | eventAssignmentChanged => flagNo | eventCommitmentSet => flagNo | eventNoteAdded => flagNo | eventMessage => flagNo | eventMeeting => flagNo | eventCall => flagNo | eventApproval => flagNo | eventPolicyDenied => flagNo | eventFieldsChanged => flagYes | eventIdentifierVerified => flagNo | eventEnded => flagNo | eventDeleted => flagNo)
DEFINE_REC(attrsPrimary, : Attrs -> Flag := fun (a : Attrs) => case a as s1 in Attrs return Flag with | attrsEnd => flagNo | attrsField (t : Text) (v : Value) (r : Attrs) => (case (textSame t primaryKey) as s2 in Flag return Flag with | flagNo => attrsPrimary r | flagYes => (case v as s3 in Value return Flag with | valueNull => flagNo | valueFlag (f : Flag) => f | valueNat (c : Nat) => flagNo | valueText (u : Text) => flagNo | valueItems (i : Values) => flagNo | valueAttrs (n : Attrs) => flagNo)))
DEFINE_REC(recordsPerson, : List Record -> Text -> Option Text := fun (rs : List Record) (h : Text) => case rs as s1 in List return Option Text with | nil => none | cons (r : Record) (rr : List Record) => (case r as s2 in Record return Option Text with | makeRecord (x : Text) (b : Body) => (case (textSame x h) as s3 in Flag return Option Text with | flagNo => recordsPerson rr h | flagYes => (case b as s4 in Body return Option Text with | createsParty (m : Party) => none | createsMembership (m : Membership) => (case m as s5 in Membership return Option Text with | makeMembership (x0 : Ref kindParty) (x1 : Ref kindParty) (x2 : Option Text) (x3 : Flag) (x4 : Option (Ref kindEvent)) (x5 : Provenance) (x6 : Attrs) => some (refText kindParty x0)) | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none))))
DEFINE(membershipUnprimary, : Text -> Membership -> Membership := fun (p : Text) (m : Membership) => case m as s1 in Membership return Membership with | makeMembership (x0 : Ref kindParty) (x1 : Ref kindParty) (x2 : Option Text) (x3 : Flag) (x4 : Option (Ref kindEvent)) (x5 : Provenance) (x6 : Attrs) => (case (textSame (refText kindParty x0) p) as s2 in Flag return Membership with | flagNo => makeMembership x0 x1 x2 x3 x4 x5 x6 | flagYes => (case x4 as s3 in Option return Membership with | none => makeMembership x0 x1 x2 flagNo none x5 x6 | some (d : Ref kindEvent) => makeMembership x0 x1 x2 x3 (some d) x5 x6)))
DEFINE(bodyUnprimary, : Text -> Text -> Text -> Body -> Body := fun (x : Text) (j : Text) (p : Text) (b : Body) => case b as s1 in Body return Body with | createsParty (m : Party) => b | createsMembership (m : Membership) => (case (textSame x j) as s2 in Flag return Body with | flagNo => createsMembership (membershipUnprimary p m) | flagYes => b) | createsCommercial (m : Commercial) => b | createsCommitment (m : Commitment) => b | createsArtifact (m : Artifact) => b | createsEvent (m : Event) => b | createsAssignment (m : Assignment) => b | createsPolicy (m : Policy) => b)
DEFINE_REC(recordsUnprimary, : Text -> Text -> List Record -> List Record := fun (j : Text) (p : Text) (rs : List Record) => case rs as s1 in List return List Record with | nil => nil | cons (r : Record) (rr : List Record) => cons (case r as s2 in Record return Record with | makeRecord (x : Text) (b : Body) => makeRecord x (bodyUnprimary x j p b)) (recordsUnprimary j p rr))
DEFINE(recordsPrimaryFor, : Text -> List Record -> Option Text -> List Record := fun (j : Text) (rs : List Record) (o : Option Text) => case o as s1 in Option return List Record with | none => rs | some (p : Text) => recordsUnprimary j p rs)
DEFINE(recordsPrimary, : List Record -> Body -> List Record := fun (rs : List Record) (b : Body) => case b as s1 in Body return List Record with | createsParty (m : Party) => rs | createsMembership (m : Membership) => rs | createsCommercial (m : Commercial) => rs | createsCommitment (m : Commitment) => rs | createsArtifact (m : Artifact) => rs | createsEvent (e : Event) => (case e as s2 in Event return List Record with | makeEvent (y : EventType) (j : Subject) (f : Option (Ref kindArtifact)) (q : Option (Ref kindEvent)) (v : Attrs) (g : Option (Ref kindPolicy)) => (case (flagAnd (etPrimary y) (attrsPrimary v)) as s3 in Flag return List Record with | flagNo => rs | flagYes => (case j as s4 in Subject return List Record with | subjectParty (r : Ref kindParty) => rs | subjectMembership (r : Ref kindMembership) => recordsPrimaryFor (refText kindMembership r) rs (recordsPerson rs (refText kindMembership r)) | subjectCommercial (r : Ref kindCommercial) => rs | subjectCommitment (r : Ref kindCommitment) => rs | subjectAssignment (r : Ref kindAssignment) => rs))) | createsAssignment (m : Assignment) => rs | createsPolicy (m : Policy) => rs)
/* M7 delta A-4: upd h e b also sets the stage of a Commercial record b from
   the after payload of the event Body e (stageAfter, program.c projection_moved). */
DEFINE(recordsTarget, : (Text -> Body -> Body -> Body) -> List Record -> Text -> Body -> List Record := fun (upd : Text -> Body -> Body -> Body) (rs : List Record) (h : Text) (b : Body) => case (recordsSubject b) as s1 in Option return List Record with | none => rs | some (j : Text) => recordsSet rs (upd h b) j)
DEFINE(recordsAdd, : (Text -> Body -> Body -> Body) -> List Record -> Text -> Entry -> List Record := fun (upd : Text -> Body -> Body -> Body) (rs : List Record) (h : Text) (e : Entry) => case (recordsKnown rs h) as s1 in Flag return List Record with | flagNo => (case e as s2 in Entry return List Record with | makeEntry (p : Option Hash) (a : Actor) (b : Body) => recordsSnoc (recordsPrimary (recordsMerged (recordsTarget upd rs h b) b) b) (makeRecord h b)) | flagYes => rs)
DEFINE_REC(recordsLog, : List Entry -> (Entry -> Text) -> (Text -> Body -> Body -> Body) -> List Record -> List Record := fun (l : List Entry) (hs : Entry -> Text) (upd : Text -> Body -> Body -> Body) (rs : List Record) => case l as s1 in List return List Record with | nil => rs | cons (e : Entry) (r : List Entry) => recordsLog r hs upd (recordsAdd upd rs (hs e) e))
DEFINE_REC(recordsLogs, : List Log -> (Entry -> Text) -> (Text -> Body -> Body -> Body) -> List Record -> List Record := fun (ls : List Log) (hs : Entry -> Text) (upd : Text -> Body -> Body -> Body) (rs : List Record) => case ls as s1 in List return List Record with | nil => rs | cons (l : Log) (r : List Log) => recordsLogs r hs upd (recordsLog l hs upd rs))
DEFINE(recordsWith, : (Entry -> Text) -> (Text -> Body -> Body -> Body) -> List Log -> List Record := fun (hs : Entry -> Text) (upd : Text -> Body -> Body -> Body) (ls : List Log) => recordsLogs ls hs upd nil)
DEFINE(recordsKeep, : Text -> Body -> Body -> Body := fun (h : Text) (e : Body) (b : Body) => b)

/* The render helper (program.c:1300): no records gives nothing; else
   ,"records":[ then the records with , between them and ]. */
DEFINE_REC(recordsMore, : List Record -> (Text -> Body -> Text -> Text) -> Text -> Text := fun (rs : List Record) (put : Text -> Body -> Text -> Text) (tail : Text) => case rs as s1 in List return Text with | nil => textByte 93 tail | cons (r : Record) (rr : List Record) => textByte 44 (case r as s2 in Record return Text with | makeRecord (x : Text) (b : Body) => put x b (recordsMore rr put tail)))
DEFINE(recordsThen, : (Text -> Body -> Text -> Text) -> List Record -> Text -> Text := fun (put : Text -> Body -> Text -> Text) (rs : List Record) (tail : Text) => case rs as s1 in List return Text with | nil => tail | cons (r : Record) (rr : List Record) => textByte 44 (textByte 34 (textByte 114 (textByte 101 (textByte 99 (textByte 111 (textByte 114 (textByte 100 (textByte 115 (textByte 34 (textByte 58 (textByte 91 (case r as s2 in Record return Text with | makeRecord (x : Text) (b : Body) => put x b (recordsMore rr put tail))))))))))))))
/* E-1 (a): the read path. Hash lists as data; readWithH takes the update function (ledgerLastEvent is generated after these rows). */
DEFINE_REC(readUptoH, : Text -> List Entry -> List Text -> Option (List Entry) := fun (h : Text) (l : List Entry) (ks : List Text) => case l as s1 in List return Option (List Entry) with | nil => none | cons (e : Entry) (r : List Entry) => (case ks as s2 in List return Option (List Entry) with | nil => none | cons (k : Text) (kr : List Text) => (case (textSame k h) as s3 in Flag return Option (List Entry) with | flagNo => (case (readUptoH h r kr) as s4 in Option return Option (List Entry) with | none => none | some (t : List Entry) => some (cons e t)) | flagYes => some (cons e nil))))
DEFINE(readReplayH, : List Text -> Log -> Moment -> Log := fun (ks : List Text) (lg : Log) (m : Moment) => case m as s1 in Moment return Log with | momentNow => lg | momentAsOf (h : Hash) => (case h as s2 in Hash return Log with | hashOf (d : Text) => (case (readUptoH d lg ks) as s3 in Option return Log with | none => nil | some (t : List Entry) => t)))
DEFINE_REC(recordsLogH, : List Entry -> List Text -> (Text -> Body -> Body -> Body) -> List Record -> List Record := fun (l : List Entry) (ks : List Text) (upd : Text -> Body -> Body -> Body) (rs : List Record) => case l as s1 in List return List Record with | nil => rs | cons (e : Entry) (r : List Entry) => (case ks as s2 in List return List Record with | nil => rs | cons (k : Text) (kr : List Text) => recordsLogH r kr upd (recordsAdd upd rs k e)))
DEFINE_REC(recordsLogsH, : List Log -> List (List Text) -> (Text -> Body -> Body -> Body) -> List Record -> List Record := fun (ls : List Log) (kss : List (List Text)) (upd : Text -> Body -> Body -> Body) (rs : List Record) => case ls as s1 in List return List Record with | nil => rs | cons (l : Log) (r : List Log) => (case kss as s2 in List return List Record with | nil => rs | cons (ks : List Text) (kr : List (List Text)) => recordsLogsH r kr upd (recordsLogH l ks upd rs)))
DEFINE_REC(hsMap, : (Entry -> Text) -> List Entry -> List Text := fun (hs : Entry -> Text) (l : List Entry) => case l as s1 in List return List Text with | nil => nil | cons (e : Entry) (r : List Entry) => cons (hs e) (hsMap hs r))
DEFINE(bodyCommitment, : Body -> Option Commitment := fun (b : Body) => case b as s1 in Body return Option Commitment with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => some m | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(valueNatOf, : Value -> Option Nat := fun (v : Value) => case v as s1 in Value return Option Nat with | valueNull => none | valueFlag (f : Flag) => none | valueNat (n : Nat) => some n | valueText (t : Text) => none | valueItems (i : Values) => none | valueAttrs (a : Attrs) => none)
DEFINE(pctTens, : Nat -> Nat -> Nat -> Nat := fun (n : Nat) (f : Nat) (t : Nat) => natAdd (natMul 10 t) (digitAt (natSub n (natMul t (natMul 10 f))) f))
DEFINE(pctDigits, : Nat -> Nat -> Nat := fun (n : Nat) (f : Nat) => (case (natLt n (natMul 100 f)) as s1 return Nat with | 0 (no : prod ()) => 100 | 1 (yes : prod ()) => pctTens n f (digitAt n (natMul 10 f))))
DEFINE(pctOf, : Nat -> Nat -> Option Nat := fun (f : Nat) (a : Nat) => (case (natLt 0 f) as s1 return Option Nat with | 0 (no : prod ()) => none | 1 (yes : prod ()) => (case (natLt f a) as s2 return Option Nat with | 0 (no : prod ()) => some (pctDigits (natMul 100 (natSub f a)) f) | 1 (yes : prod ()) => none)))
DEFINE(discPct, : Option Value -> Value -> Option Nat := fun (fv : Option Value) (av : Value) => case fv as s1 in Option return Option Nat with | none => none | some (w : Value) => (case (valueNatOf w) as s2 in Option return Option Nat with | none => none | some (fn : Nat) => (case (valueNatOf av) as s3 in Option return Option Nat with | none => none | some (an : Nat) => pctOf fn an)))
DEFINE(discFirst, : Option Value -> Value -> Option Value := fun (fv : Option Value) (v : Value) => case fv as s1 in Option return Option Value with | none => some v | some (w : Value) => some w)
DEFINE(discIsPrice, : Text -> Ref kindCommercial -> CommitmentKind -> Flag := fun (d : Text) (cm : Ref kindCommercial) (k : CommitmentKind) => case k as s1 in CommitmentKind return Flag with | commitmentPrice => textSame (refText kindCommercial cm) d | commitmentTerm => flagNo | commitmentDate => flagNo | commitmentScope => flagNo | commitmentSla => flagNo)
DEFINE(recSupersedes, : Record -> Text -> Flag := fun (x : Record) (h : Text) => case x as s1 in Record return Flag with | makeRecord (k : Text) (b : Body) => (case (bodyCommitment b) as s2 in Option return Flag with | none => flagNo | some (c : Commitment) => (case c as s3 in Commitment return Flag with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case sp as s4 in Option return Flag with | none => flagNo | some (rf : Ref kindCommitment) => textSame (refText kindCommitment rf) h))))
DEFINE_REC(recSuperseded, : List Record -> Text -> Flag := fun (l : List Record) (h : Text) => case l as s1 in List return Flag with | nil => flagNo | cons (x : Record) (r : List Record) => (case (recSupersedes x h) as s2 in Flag return Flag with | flagNo => recSuperseded r h | flagYes => flagYes))
DEFINE(discAgreed, : List Record -> Text -> CommitmentStatus -> Value -> Option Value -> Option Nat -> Option Nat := fun (all : List Record) (h : Text) (st : CommitmentStatus) (v : Value) (fv : Option Value) (res : Option Nat) => case st as s1 in CommitmentStatus return Option Nat with | commitmentProposed => res | commitmentAgreed => (case (recSuperseded all h) as s2 in Flag return Option Nat with | flagNo => discPct fv v | flagYes => res) | commitmentSuperseded => res)
DEFINE_REC(discWalk, : List Record -> List Record -> Text -> Option Value -> Option Nat -> Option Nat := fun (l : List Record) (all : List Record) (d : Text) (fv : Option Value) (res : Option Nat) => case l as s1 in List return Option Nat with | nil => res | cons (x : Record) (r : List Record) => (case x as s2 in Record return Option Nat with | makeRecord (h : Text) (b : Body) => (case (bodyCommitment b) as s3 in Option return Option Nat with | none => discWalk r all d fv res | some (c : Commitment) => (case c as s4 in Commitment return Option Nat with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case (discIsPrice d cm ck) as s5 in Flag return Option Nat with | flagNo => discWalk r all d fv res | flagYes => discWalk r all d (discFirst fv v) (discAgreed all h st v fv res))))))
DEFINE(discRead, : List Record -> Ref kindCommercial -> Option Nat := fun (rs : List Record) (c : Ref kindCommercial) => discWalk rs rs (refText kindCommercial c) none none)
DEFINE(bodyCommercial, : Body -> Option Commercial := fun (b : Body) => case b as s1 in Body return Option Commercial with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => some m | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE_REC(recLen, : List Record -> Nat := fun (l : List Record) => case l as s1 in List return Nat with | nil => 0 | cons (x : Record) (r : List Record) => natAdd 1 (recLen r))
DEFINE_REC(recPos, : List Record -> Text -> Nat -> Option Nat := fun (l : List Record) (h : Text) (i : Nat) => case l as s1 in List return Option Nat with | nil => none | cons (x : Record) (r : List Record) => (case x as s2 in Record return Option Nat with | makeRecord (k : Text) (b : Body) => (case (textSame k h) as s3 in Flag return Option Nat with | flagNo => recPos r h (natAdd i 1) | flagYes => some i)))
DEFINE(staleLast, : List Record -> Commercial -> Nat -> Nat := fun (all : List Record) (c : Commercial) (p : Nat) => case c as s1 in Commercial return Nat with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => (case x9 as s2 in Option return Nat with | none => p | some (ev : Ref kindEvent) => (case (recPos all (refText kindEvent ev) 0) as s3 in Option return Nat with | none => p | some (s : Nat) => (case (natLt p s) as s4 return Nat with | 0 (no : prod ()) => p | 1 (yes : prod ()) => s))))
DEFINE(commercialRef, : Text -> Ref kindCommercial := fun (h : Text) => refTo (hashOf h))
DEFINE_REC(staleWalk, : List Record -> List Record -> Nat -> Nat -> Nat -> List (Ref kindCommercial) := fun (l : List Record) (all : List Record) (p : Nat) (total : Nat) (quiet : Nat) => case l as s1 in List return List (Ref kindCommercial) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindCommercial) with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return List (Ref kindCommercial) with | none => staleWalk r all (natAdd p 1) total quiet | some (c : Commercial) => (case (natLt (natAdd (staleLast all c p) quiet) total) as s4 return List (Ref kindCommercial) with | 0 (no : prod ()) => staleWalk r all (natAdd p 1) total quiet | 1 (yes : prod ()) => cons (commercialRef h) (staleWalk r all (natAdd p 1) total quiet)))))
DEFINE(staleRead, : List Record -> Nat -> List (Ref kindCommercial) := fun (rs : List Record) (q : Nat) => staleWalk rs rs 0 (recLen rs) q)
DEFINE(natSame, : Nat -> Nat -> Flag := fun (a : Nat) (b : Nat) => (case (natEq a b) as s1 return Flag with | 0 (no : prod ()) => flagNo | 1 (yes : prod ()) => flagYes))
DEFINE(optNone, : (0 A : Type 0) -> Option A -> Flag := fun (0 A : Type 0) (o : Option A) => case o as s1 in Option return Flag with | none => flagYes | some (v : A) => flagNo)
DEFINE(optSome, : (0 A : Type 0) -> Option A -> Flag := fun (0 A : Type 0) (o : Option A) => flagNot (optNone A o))
DEFINE(optSame, : (0 A : Type 0) -> (A -> A -> Flag) -> Option A -> Option A -> Flag := fun (0 A : Type 0) (cmp : A -> A -> Flag) (o : Option A) (p : Option A) => case o as s1 in Option return Flag with | none => optNone A p | some (v : A) => (case p as s2 in Option return Flag with | none => flagNo | some (w : A) => cmp v w))
DEFINE(refSame, : (0 k : Kind) -> Ref k -> Ref k -> Flag := fun (0 k : Kind) (a : Ref k) (b : Ref k) => textSame (refText k a) (refText k b))
DEFINE_REC(textIn, : List Text -> Text -> Flag := fun (l : List Text) (t : Text) => case l as s1 in List return Flag with | nil => flagNo | cons (x : Text) (r : List Text) => (case (textSame x t) as s2 in Flag return Flag with | flagNo => textIn r t | flagYes => flagYes))
DEFINE_REC(textDedupe, : List Text -> List Text -> List Text := fun (l : List Text) (seen : List Text) => case l as s1 in List return List Text with | nil => nil | cons (t : Text) (r : List Text) => (case (textIn seen t) as s2 in Flag return List Text with | flagNo => cons t (textDedupe r (cons t seen)) | flagYes => textDedupe r seen))
DEFINE(asOfThen, : (0 A : Type 0) -> A -> (List Record -> A) -> Option (List Record) -> A := fun (0 A : Type 0) (d : A) (k : List Record -> A) (o : Option (List Record)) => case o as s1 in Option return A with | none => d | some (rs : List Record) => k rs)
DEFINE(readAsOfH, : (Text -> Body -> Body -> Body) -> List Text -> Log -> Moment -> Option (List Record) := fun (upd : Text -> Body -> Body -> Body) (ks : List Text) (lg : Log) (m : Moment) => case m as s1 in Moment return Option (List Record) with | momentNow => some (recordsLogH lg ks upd nil) | momentAsOf (h : Hash) => (case h as s2 in Hash return Option (List Record) with | hashOf (d : Text) => (case (readUptoH d lg ks) as s3 in Option return Option (List Record) with | none => none | some (t : List Entry) => some (recordsLogH t ks upd nil))))
DEFINE_REC(recFind, : List Record -> Text -> Option Body := fun (l : List Record) (h : Text) => case l as s1 in List return Option Body with | nil => none | cons (x : Record) (r : List Record) => (case x as s2 in Record return Option Body with | makeRecord (k : Text) (b : Body) => (case (textSame k h) as s3 in Flag return Option Body with | flagNo => recFind r h | flagYes => some b)))
DEFINE(bodyParty, : Body -> Option Party := fun (b : Body) => case b as s1 in Body return Option Party with | createsParty (m : Party) => some m | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(bodyMembership, : Body -> Option Membership := fun (b : Body) => case b as s1 in Body return Option Membership with | createsParty (m : Party) => none | createsMembership (m : Membership) => some m | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(bodyArtifact, : Body -> Option Artifact := fun (b : Body) => case b as s1 in Body return Option Artifact with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => some m | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(bodyEvent, : Body -> Option Event := fun (b : Body) => case b as s1 in Body return Option Event with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => some m | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(bodyAssignment, : Body -> Option Assignment := fun (b : Body) => case b as s1 in Body return Option Assignment with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => some m | createsPolicy (m : Policy) => none)
DEFINE(bodyPolicy, : Body -> Option Policy := fun (b : Body) => case b as s1 in Body return Option Policy with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => some m)
DEFINE(eventRef, : Text -> Ref kindEvent := fun (h : Text) => refTo (hashOf h))
DEFINE(membershipRef, : Text -> Ref kindMembership := fun (h : Text) => refTo (hashOf h))
DEFINE(commitmentRef, : Text -> Ref kindCommitment := fun (h : Text) => refTo (hashOf h))
DEFINE(assignmentRef, : Text -> Ref kindAssignment := fun (h : Text) => refTo (hashOf h))
DEFINE(artifactRef, : Text -> Ref kindArtifact := fun (h : Text) => refTo (hashOf h))
DEFINE_REC(attrsGet, : Attrs -> Text -> Option Value := fun (a : Attrs) (t : Text) => case a as s1 in Attrs return Option Value with | attrsEnd => none | attrsField (k : Text) (v : Value) (r : Attrs) => (case (textSame k t) as s2 in Flag return Option Value with | flagNo => attrsGet r t | flagYes => some v))
DEFINE(valueTextOf, : Value -> Option Text := fun (v : Value) => case v as s1 in Value return Option Text with | valueNull => none | valueFlag (f : Flag) => none | valueNat (n : Nat) => none | valueText (t : Text) => some t | valueItems (i : Values) => none | valueAttrs (a : Attrs) => none)
DEFINE(attrsText, : Attrs -> Text -> Option Text := fun (a : Attrs) (k : Text) => case (attrsGet a k) as s1 in Option return Option Text with | none => none | some (v : Value) => valueTextOf v)
DEFINE(recCommercial, : List Record -> Text -> Option Commercial := fun (rs : List Record) (h : Text) => case (recFind rs h) as s1 in Option return Option Commercial with | none => none | some (b : Body) => bodyCommercial b)
DEFINE(kcNat, : KindCommercial -> Nat := fun (k : KindCommercial) => case k as s1 in KindCommercial return Nat with | commercialDeal => 0 | commercialSubscription => 1 | commercialTicket => 2)
DEFINE(csNat, : CommercialStatus -> Nat := fun (k : CommercialStatus) => case k as s1 in CommercialStatus return Nat with | statusOpen => 0 | statusWon => 1 | statusLost => 2 | statusPaused => 3)
DEFINE(attrsSame, : Attrs -> Attrs -> Flag := fun (a : Attrs) (b : Attrs) => textSame (encodeAttrs a textEnd) (encodeAttrs b textEnd))
DEFINE(commercialSame, : Commercial -> Commercial -> Flag := fun (c : Commercial) (d : Commercial) => case c as s1 in Commercial return Flag with | makeCommercial (a0 : KindCommercial) (a1 : Text) (a2 : Ref kindParty) (a3 : Text) (a4 : Option Nat) (a5 : Text) (a6 : Option Text) (a7 : CommercialStatus) (a8 : Attrs) (a9 : Option (Ref kindEvent)) => (case d as s2 in Commercial return Flag with | makeCommercial (b0 : KindCommercial) (b1 : Text) (b2 : Ref kindParty) (b3 : Text) (b4 : Option Nat) (b5 : Text) (b6 : Option Text) (b7 : CommercialStatus) (b8 : Attrs) (b9 : Option (Ref kindEvent)) => flagAnd (natSame (kcNat a0) (kcNat b0)) (flagAnd (textSame a1 b1) (flagAnd (refSame kindParty a2 b2) (flagAnd (textSame a3 b3) (flagAnd (optSame Nat natSame a4 b4) (flagAnd (textSame a5 b5) (flagAnd (optSame Text textSame a6 b6) (flagAnd (natSame (csNat a7) (csNat b7)) (flagAnd (attrsSame a8 b8) (optSame (Ref kindEvent) (refSame kindEvent) a9 b9)))))))))))
DEFINE(soundRead, : List Record -> Text -> Commercial -> Flag := fun (rs : List Record) (d : Text) (s : Commercial) => case (recCommercial rs d) as s1 in Option return Flag with | none => flagNo | some (c : Commercial) => commercialSame c s)
DEFINE_REC(readAfterH, : Text -> List Entry -> List Text -> Log := fun (h : Text) (l : List Entry) (ks : List Text) => case l as s1 in List return Log with | nil => nil | cons (e : Entry) (r : List Entry) => (case ks as s2 in List return Log with | nil => nil | cons (k : Text) (kr : List Text) => (case (textSame k h) as s3 in Flag return Log with | flagNo => readAfterH h r kr | flagYes => r)))
DEFINE(readTailH, : List Text -> Log -> Moment -> Log := fun (ks : List Text) (lg : Log) (m : Moment) => case m as s1 in Moment return Log with | momentNow => nil | momentAsOf (h : Hash) => (case h as s2 in Hash return Log with | hashOf (d : Text) => readAfterH d lg ks))
DEFINE(actorSame, : Actor -> Actor -> Flag := fun (a : Actor) (b : Actor) => case a as s1 in Actor return Flag with | actorHuman (p : Ref kindParty) => (case b as s2 in Actor return Flag with | actorHuman (q : Ref kindParty) => refSame kindParty p q | actorAgent (m : Text) => flagNo | actorSystem (m : Text) => flagNo) | actorAgent (n : Text) => (case b as s3 in Actor return Flag with | actorHuman (q : Ref kindParty) => flagNo | actorAgent (m : Text) => textSame n m | actorSystem (m : Text) => flagNo) | actorSystem (n : Text) => (case b as s4 in Actor return Flag with | actorHuman (q : Ref kindParty) => flagNo | actorAgent (m : Text) => flagNo | actorSystem (m : Text) => textSame n m))
DEFINE_REC(auditWalkH, : List Entry -> List Text -> Actor -> List (Ref kindEvent) := fun (l : List Entry) (ks : List Text) (a : Actor) => case l as s1 in List return List (Ref kindEvent) with | nil => nil | cons (e : Entry) (r : List Entry) => (case ks as s2 in List return List (Ref kindEvent) with | nil => nil | cons (k : Text) (kr : List Text) => (case e as s3 in Entry return List (Ref kindEvent) with | makeEntry (p : Option Hash) (ac : Actor) (b : Body) => (case (flagAnd (optSome Event (bodyEvent b)) (actorSame ac a)) as s4 in Flag return List (Ref kindEvent) with | flagNo => auditWalkH r kr a | flagYes => cons (eventRef k) (auditWalkH r kr a)))))
DEFINE_REC(membersWalk, : List Record -> Text -> List (Ref kindMembership) := fun (l : List Record) (o : Text) => case l as s1 in List return List (Ref kindMembership) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindMembership) with | makeRecord (h : Text) (b : Body) => (case (bodyMembership b) as s3 in Option return List (Ref kindMembership) with | none => membersWalk r o | some (m : Membership) => (case m as s4 in Membership return List (Ref kindMembership) with | makeMembership (pe : Ref kindParty) (og : Ref kindParty) (ro : Option Text) (ip : Flag) (eb : Option (Ref kindEvent)) (pv : Provenance) (ats : Attrs) => (case (flagAnd (textSame (refText kindParty og) o) (optNone (Ref kindEvent) eb)) as s5 in Flag return List (Ref kindMembership) with | flagNo => membersWalk r o | flagYes => cons (membershipRef h) (membersWalk r o))))))
DEFINE_REC(employerFirst, : List Record -> Text -> Flag -> Option (Ref kindParty) := fun (l : List Record) (p : Text) (pr : Flag) => case l as s1 in List return Option (Ref kindParty) with | nil => none | cons (x : Record) (r : List Record) => (case x as s2 in Record return Option (Ref kindParty) with | makeRecord (h : Text) (b : Body) => (case (bodyMembership b) as s3 in Option return Option (Ref kindParty) with | none => employerFirst r p pr | some (m : Membership) => (case m as s4 in Membership return Option (Ref kindParty) with | makeMembership (pe : Ref kindParty) (og : Ref kindParty) (ro : Option Text) (ip : Flag) (eb : Option (Ref kindEvent)) (pv : Provenance) (ats : Attrs) => (case (flagAnd (textSame (refText kindParty pe) p) (flagAnd (optNone (Ref kindEvent) eb) (flagOr (flagNot pr) ip))) as s5 in Flag return Option (Ref kindParty) with | flagNo => employerFirst r p pr | flagYes => some og)))))
DEFINE(employerRead, : List Record -> Text -> Option (Ref kindParty) := fun (rs : List Record) (p : Text) => case (employerFirst rs p flagYes) as s1 in Option return Option (Ref kindParty) with | none => employerFirst rs p flagNo | some (o : Ref kindParty) => some o)
DEFINE_REC(changesPersons, : List Record -> List (Ref kindParty) := fun (l : List Record) => case l as s1 in List return List (Ref kindParty) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindParty) with | makeRecord (h : Text) (b : Body) => (case (bodyMembership b) as s3 in Option return List (Ref kindParty) with | none => changesPersons r | some (m : Membership) => (case m as s4 in Membership return List (Ref kindParty) with | makeMembership (pe : Ref kindParty) (og : Ref kindParty) (ro : Option Text) (ip : Flag) (eb : Option (Ref kindEvent)) (pv : Provenance) (ats : Attrs) => cons pe (changesPersons r)))))
DEFINE_REC(changesFrom, : List Record -> Text -> List (Ref kindParty) := fun (l : List Record) (h : Text) => case l as s1 in List return List (Ref kindParty) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindParty) with | makeRecord (k : Text) (b : Body) => (case (textSame k h) as s3 in Flag return List (Ref kindParty) with | flagNo => changesFrom r h | flagYes => changesPersons r)))
DEFINE(changesRead, : List Record -> Moment -> List (Ref kindParty) := fun (rs : List Record) (m : Moment) => case m as s1 in Moment return List (Ref kindParty) with | momentNow => nil | momentAsOf (h : Hash) => (case h as s2 in Hash return List (Ref kindParty) with | hashOf (d : Text) => changesFrom rs d))
DEFINE(statusLive, : CommitmentStatus -> Flag := fun (s : CommitmentStatus) => case s as s1 in CommitmentStatus return Flag with | commitmentProposed => flagYes | commitmentAgreed => flagYes | commitmentSuperseded => flagNo)
DEFINE_REC(termsWalk, : List Record -> List Record -> Text -> List (Ref kindCommitment) := fun (l : List Record) (all : List Record) (d : Text) => case l as s1 in List return List (Ref kindCommitment) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindCommitment) with | makeRecord (h : Text) (b : Body) => (case (bodyCommitment b) as s3 in Option return List (Ref kindCommitment) with | none => termsWalk r all d | some (c : Commitment) => (case c as s4 in Commitment return List (Ref kindCommitment) with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case (flagAnd (textSame (refText kindCommercial cm) d) (flagAnd (statusLive st) (flagNot (recSuperseded all h)))) as s5 in Flag return List (Ref kindCommitment) with | flagNo => termsWalk r all d | flagYes => cons (commitmentRef h) (termsWalk r all d))))))
DEFINE(recCommitment, : List Record -> Text -> Option Commitment := fun (rs : List Record) (h : Text) => case (recFind rs h) as s1 in Option return Option Commitment with | none => none | some (b : Body) => bodyCommitment b)
DEFINE(recMembership, : List Record -> Text -> Option Membership := fun (rs : List Record) (h : Text) => case (recFind rs h) as s1 in Option return Option Membership with | none => none | some (b : Body) => bodyMembership b)
DEFINE_REC(termChain, : List Record -> List Record -> Text -> List (Ref kindCommitment) -> List (Ref kindCommitment) := fun (fu : List Record) (all : List Record) (h : Text) (acc : List (Ref kindCommitment)) => case fu as s1 in List return List (Ref kindCommitment) with | nil => acc | cons (y : Record) (fr : List Record) => (case (recCommitment all h) as s2 in Option return List (Ref kindCommitment) with | none => acc | some (c : Commitment) => (case c as s3 in Commitment return List (Ref kindCommitment) with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case sp as s4 in Option return List (Ref kindCommitment) with | none => cons (commitmentRef h) acc | some (rf : Ref kindCommitment) => termChain fr all (refText kindCommitment rf) (cons (commitmentRef h) acc)))))
DEFINE(termRead, : List Record -> Text -> List (Ref kindCommitment) := fun (rs : List Record) (h : Text) => termChain rs rs h nil)
DEFINE(statusAgreed, : CommitmentStatus -> Flag := fun (s : CommitmentStatus) => case s as s1 in CommitmentStatus return Flag with | commitmentProposed => flagNo | commitmentAgreed => flagYes | commitmentSuperseded => flagNo)
DEFINE(valueIsNat, : Value -> Nat -> Flag := fun (v : Value) (n : Nat) => case (valueNatOf v) as s1 in Option return Flag with | none => flagNo | some (p : Nat) => natSame p n)
DEFINE_REC(reconWalk, : List Record -> List Record -> Text -> Nat -> Flag := fun (l : List Record) (all : List Record) (d : Text) (n : Nat) => case l as s1 in List return Flag with | nil => flagNo | cons (x : Record) (r : List Record) => (case x as s2 in Record return Flag with | makeRecord (h : Text) (b : Body) => (case (bodyCommitment b) as s3 in Option return Flag with | none => reconWalk r all d n | some (c : Commitment) => (case c as s4 in Commitment return Flag with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case (flagAnd (discIsPrice d cm ck) (flagAnd (statusAgreed st) (flagAnd (valueIsNat v n) (flagNot (recSuperseded all h))))) as s5 in Flag return Flag with | flagNo => reconWalk r all d n | flagYes => flagYes)))))
DEFINE(reconRead, : List Record -> Text -> Flag := fun (rs : List Record) (d : Text) => case (recCommercial rs d) as s1 in Option return Flag with | none => flagNo | some (c : Commercial) => (case c as s2 in Commercial return Flag with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => (case x4 as s3 in Option return Flag with | none => flagNo | some (n : Nat) => reconWalk rs rs d n)))
DEFINE(acctSame, : Account -> Account -> Flag := fun (a : Account) (b : Account) => case a as s1 in Account return Flag with | accountParty (x : Ref kindParty) => (case b as s2 in Account return Flag with | accountParty (y : Ref kindParty) => refSame kindParty x y | accountCommercial (y : Ref kindCommercial) => flagNo) | accountCommercial (x : Ref kindCommercial) => (case b as s3 in Account return Flag with | accountParty (y : Ref kindParty) => flagNo | accountCommercial (y : Ref kindCommercial) => refSame kindCommercial x y))
DEFINE(isOwner, : AssignmentRole -> Flag := fun (r : AssignmentRole) => case r as s1 in AssignmentRole return Flag with | roleOwner => flagYes | roleSdr => flagNo | roleSe => flagNo | roleCs => flagNo | roleOverlay => flagNo)
DEFINE(assignCurrent, : Assignment -> Flag := fun (m : Assignment) => case m as s1 in Assignment return Flag with | makeAssignment (x0 : Account) (x1 : Ref kindParty) (x2 : AssignmentRole) (x3 : Option Text) (x4 : Option (Ref kindEvent)) (x5 : Provenance) => (case x4 as s2 in Option return Flag with | none => flagYes | some (e : Ref kindEvent) => flagNo))
DEFINE(assigneeOf, : Assignment -> Ref kindParty := fun (m : Assignment) => case m as s1 in Assignment return Ref kindParty with | makeAssignment (x0 : Account) (x1 : Ref kindParty) (x2 : AssignmentRole) (x3 : Option Text) (x4 : Option (Ref kindEvent)) (x5 : Provenance) => x1)
DEFINE(subjectOf, : Assignment -> Account := fun (m : Assignment) => case m as s1 in Assignment return Account with | makeAssignment (x0 : Account) (x1 : Ref kindParty) (x2 : AssignmentRole) (x3 : Option Text) (x4 : Option (Ref kindEvent)) (x5 : Provenance) => x0)
DEFINE(roleOf, : Assignment -> AssignmentRole := fun (m : Assignment) => case m as s1 in Assignment return AssignmentRole with | makeAssignment (x0 : Account) (x1 : Ref kindParty) (x2 : AssignmentRole) (x3 : Option Text) (x4 : Option (Ref kindEvent)) (x5 : Provenance) => x2)
DEFINE(territoryOf, : Assignment -> Text := fun (m : Assignment) => case m as s1 in Assignment return Text with | makeAssignment (x0 : Account) (x1 : Ref kindParty) (x2 : AssignmentRole) (x3 : Option Text) (x4 : Option (Ref kindEvent)) (x5 : Provenance) => (case x3 as s2 in Option return Text with | none => textEnd | some (t : Text) => t))
DEFINE(ownerMatch, : Assignment -> Account -> Flag := fun (m : Assignment) (a : Account) => case (acctSame (subjectOf m) a) as s1 in Flag return Flag with | flagNo => flagNo | flagYes => (case (isOwner (roleOf m)) as s2 in Flag return Flag with | flagNo => flagNo | flagYes => assignCurrent m))
DEFINE_REC(ownerWalk, : List Record -> Account -> Option Assignment -> Option Assignment := fun (l : List Record) (a : Account) (acc : Option Assignment) => case l as s1 in List return Option Assignment with | nil => acc | cons (x : Record) (r : List Record) => (case x as s2 in Record return Option Assignment with | makeRecord (h : Text) (b : Body) => (case (bodyAssignment b) as s3 in Option return Option Assignment with | none => ownerWalk r a acc | some (m : Assignment) => (case (ownerMatch m a) as s4 in Flag return Option Assignment with | flagNo => ownerWalk r a acc | flagYes => ownerWalk r a (some m)))))
DEFINE(ownerAssign, : List Record -> Account -> Option Assignment := fun (rs : List Record) (a : Account) => ownerWalk rs a none)
DEFINE(ownerRead, : List Record -> Account -> Option (Ref kindParty) := fun (rs : List Record) (a : Account) => case (ownerAssign rs a) as s1 in Option return Option (Ref kindParty) with | none => none | some (m : Assignment) => some (assigneeOf m))
DEFINE(dealOwner, : List Record -> Text -> Ref kindParty -> Option Assignment := fun (all : List Record) (h : Text) (p : Ref kindParty) => case (ownerAssign all (accountCommercial (commercialRef h))) as s1 in Option return Option Assignment with | none => ownerAssign all (accountParty p) | some (m : Assignment) => some m)
DEFINE(pipeKey, : PipelineKey -> List Record -> Text -> Commercial -> Text := fun (k : PipelineKey) (all : List Record) (h : Text) (c : Commercial) => case c as s1 in Commercial return Text with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => (case k as s2 in PipelineKey return Text with | pipelineByStage => x3 | pipelineByOwner => (case (dealOwner all h x2) as s3 in Option return Text with | none => textEnd | some (m : Assignment) => refText kindParty (assigneeOf m)) | pipelineByTerritory => (case (dealOwner all h x2) as s4 in Option return Text with | none => textEnd | some (m : Assignment) => territoryOf m) | pipelineByCloseDate => (case x6 as s5 in Option return Text with | none => textEnd | some (t : Text) => t)))
DEFINE(commercialCents, : Commercial -> Nat := fun (c : Commercial) => case c as s1 in Commercial return Nat with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => (case x4 as s2 in Option return Nat with | none => 0 | some (n : Nat) => n))
DEFINE(commercialStage, : Commercial -> Text := fun (c : Commercial) => case c as s1 in Commercial return Text with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => x3)
DEFINE_REC(pipeCount, : List Record -> List Record -> PipelineKey -> Text -> Nat := fun (l : List Record) (all : List Record) (k : PipelineKey) (t : Text) => case l as s1 in List return Nat with | nil => 0 | cons (x : Record) (r : List Record) => (case x as s2 in Record return Nat with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return Nat with | none => pipeCount r all k t | some (c : Commercial) => (case (textSame (pipeKey k all h c) t) as s4 in Flag return Nat with | flagNo => pipeCount r all k t | flagYes => natAdd 1 (pipeCount r all k t)))))
DEFINE_REC(pipeCents, : List Record -> List Record -> PipelineKey -> Text -> Nat := fun (l : List Record) (all : List Record) (k : PipelineKey) (t : Text) => case l as s1 in List return Nat with | nil => 0 | cons (x : Record) (r : List Record) => (case x as s2 in Record return Nat with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return Nat with | none => pipeCents r all k t | some (c : Commercial) => (case (textSame (pipeKey k all h c) t) as s4 in Flag return Nat with | flagNo => pipeCents r all k t | flagYes => natAdd (commercialCents c) (pipeCents r all k t)))))
DEFINE_REC(pipeWalk, : List Record -> List Record -> PipelineKey -> List Text -> List Bucket := fun (l : List Record) (all : List Record) (k : PipelineKey) (seen : List Text) => case l as s1 in List return List Bucket with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Bucket with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return List Bucket with | none => pipeWalk r all k seen | some (c : Commercial) => (case (textIn seen (pipeKey k all h c)) as s4 in Flag return List Bucket with | flagNo => cons (makeBucket (pipeKey k all h c) (pipeCount all all k (pipeKey k all h c)) (pipeCents all all k (pipeKey k all h c))) (pipeWalk r all k (cons (pipeKey k all h c) seen)) | flagYes => pipeWalk r all k seen))))
DEFINE(pipeRead, : PipelineKey -> List Record -> List Bucket := fun (k : PipelineKey) (rs : List Record) => case k as s1 in PipelineKey return List Bucket with | pipelineByStage => pipeWalk rs rs k nil | pipelineByOwner => pipeWalk rs rs k nil | pipelineByTerritory => pipeWalk rs rs k nil | pipelineByCloseDate => pipeWalk rs rs k nil)
DEFINE(afterKey, : Text := textByte 97 (textByte 102 (textByte 116 (textByte 101 (textByte 114 textEnd)))))
DEFINE(beforeKey, : Text := textByte 98 (textByte 101 (textByte 102 (textByte 111 (textByte 114 (textByte 101 textEnd))))))
DEFINE(isStageType, : EventType -> Flag := fun (t : EventType) => case t as s1 in EventType return Flag with | eventStageChanged => flagYes | eventAmountChanged => flagNo | eventAssignmentChanged => flagNo | eventCommitmentSet => flagNo | eventNoteAdded => flagNo | eventMessage => flagNo | eventMeeting => flagNo | eventCall => flagNo | eventApproval => flagNo | eventPolicyDenied => flagNo | eventFieldsChanged => flagNo | eventIdentifierVerified => flagNo | eventEnded => flagNo | eventDeleted => flagNo)
DEFINE(etAmount, : EventType -> Flag := fun (t : EventType) => case t as s1 in EventType return Flag with | eventStageChanged => flagNo | eventAmountChanged => flagYes | eventAssignmentChanged => flagNo | eventCommitmentSet => flagNo | eventNoteAdded => flagNo | eventMessage => flagNo | eventMeeting => flagNo | eventCall => flagNo | eventApproval => flagNo | eventPolicyDenied => flagNo | eventFieldsChanged => flagNo | eventIdentifierVerified => flagNo | eventEnded => flagNo | eventDeleted => flagNo)
DEFINE(stageAfter, : Body -> Text -> Text := fun (e : Body) (s : Text) => case (bodyEvent e) as s1 in Option return Text with | none => s | some (ev : Event) => (case ev as s2 in Event return Text with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (isStageType ty) as s3 in Flag return Text with | flagNo => s | flagYes => (case (attrsText pl afterKey) as s4 in Option return Text with | none => s | some (t : Text) => t))))
/* M7 part C (delta MC-6): the isPrimary of a Membership after the event Body
   e (program.c projection_moved, the eventFieldsChanged row). */
DEFINE(primaryAfter, : Body -> Flag -> Flag := fun (e : Body) (s : Flag) => case (bodyEvent e) as s1 in Option return Flag with | none => s | some (ev : Event) => (case ev as s2 in Event return Flag with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (etPrimary ty) as s3 in Flag return Flag with | flagNo => s | flagYes => (case (attrsGet pl primaryKey) as s4 in Option return Flag with | none => s | some (v : Value) => (case v as s5 in Value return Flag with | valueNull => s | valueFlag (f : Flag) => f | valueNat (c : Nat) => s | valueText (u : Text) => s | valueItems (i : Values) => s | valueAttrs (n : Attrs) => s)))))
/* M7 part C2 (delta MC-6, Q-C-2 (a), program.c projection_moved): an
   eventAmountChanged sets amountCents to its after value (none for null; no
   change without the key), and an eventFieldsChanged sets status to the
   CommercialStatus of its status text. */
DEFINE(statusOf, : Text -> CommercialStatus -> CommercialStatus := fun (t : Text) (s : CommercialStatus) => case (textSame t (statusText statusOpen)) as s1 in Flag return CommercialStatus with | flagNo => (case (textSame t (statusText statusWon)) as s2 in Flag return CommercialStatus with | flagNo => (case (textSame t (statusText statusLost)) as s3 in Flag return CommercialStatus with | flagNo => (case (textSame t (statusText statusPaused)) as s4 in Flag return CommercialStatus with | flagNo => s | flagYes => statusPaused) | flagYes => statusLost) | flagYes => statusWon) | flagYes => statusOpen)
DEFINE(amountAfter, : Body -> Option Nat -> Option Nat := fun (e : Body) (s : Option Nat) => case (bodyEvent e) as s1 in Option return Option Nat with | none => s | some (ev : Event) => (case ev as s2 in Event return Option Nat with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (etAmount ty) as s3 in Flag return Option Nat with | flagNo => s | flagYes => (case (attrsGet pl afterKey) as s4 in Option return Option Nat with | none => s | some (v : Value) => (case v as s5 in Value return Option Nat with | valueNull => none | valueFlag (f : Flag) => s | valueNat (c : Nat) => some c | valueText (u : Text) => s | valueItems (i : Values) => s | valueAttrs (n : Attrs) => s)))))
DEFINE(statusAfter, : Body -> CommercialStatus -> CommercialStatus := fun (e : Body) (s : CommercialStatus) => case (bodyEvent e) as s1 in Option return CommercialStatus with | none => s | some (ev : Event) => (case ev as s2 in Event return CommercialStatus with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (etPrimary ty) as s3 in Flag return CommercialStatus with | flagNo => s | flagYes => (case (attrsText pl statusKey) as s4 in Option return CommercialStatus with | none => s | some (t : Text) => statusOf t s))))
DEFINE(etAgreed, : EventType -> Flag := fun (t : EventType) => case t as s1 in EventType return Flag with | eventStageChanged => flagNo | eventAmountChanged => flagNo | eventAssignmentChanged => flagNo | eventCommitmentSet => flagYes | eventNoteAdded => flagNo | eventMessage => flagNo | eventMeeting => flagNo | eventCall => flagNo | eventApproval => flagNo | eventPolicyDenied => flagNo | eventFieldsChanged => flagNo | eventIdentifierVerified => flagNo | eventEnded => flagNo | eventDeleted => flagNo)
DEFINE(agreedAfter, : Body -> CommitmentStatus -> CommitmentStatus := fun (e : Body) (s : CommitmentStatus) => case (bodyEvent e) as s1 in Option return CommitmentStatus with | none => s | some (ev : Event) => (case ev as s2 in Event return CommitmentStatus with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (etAgreed ty) as s3 in Flag return CommitmentStatus with | flagNo => s | flagYes => (case (attrsText pl statusKey) as s4 in Option return CommitmentStatus with | none => s | some (t : Text) => (case (textSame t agreedText) as s5 in Flag return CommitmentStatus with | flagNo => s | flagYes => commitmentAgreed)))))
DEFINE(subjIsCommercial, : Subject -> Flag := fun (sj : Subject) => case sj as s1 in Subject return Flag with | subjectParty (p : Ref kindParty) => flagNo | subjectMembership (p : Ref kindMembership) => flagNo | subjectCommercial (p : Ref kindCommercial) => flagYes | subjectCommitment (p : Ref kindCommitment) => flagNo | subjectAssignment (p : Ref kindAssignment) => flagNo)
DEFINE(moveOf, : Body -> Option Event := fun (b : Body) => case (bodyEvent b) as s1 in Option return Option Event with | none => none | some (ev : Event) => (case ev as s2 in Event return Option Event with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (flagAnd (isStageType ty) (flagAnd (subjIsCommercial sj) (optSome Text (attrsText pl afterKey)))) as s3 in Flag return Option Event with | flagNo => none | flagYes => some ev)))
DEFINE(evDeal, : Event -> Text := fun (ev : Event) => case ev as s1 in Event return Text with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case sj as s2 in Subject return Text with | subjectParty (p : Ref kindParty) => textEnd | subjectMembership (p : Ref kindMembership) => textEnd | subjectCommercial (p : Ref kindCommercial) => refText kindCommercial p | subjectCommitment (p : Ref kindCommitment) => textEnd | subjectAssignment (p : Ref kindAssignment) => textEnd))
DEFINE(evAfter, : Event -> Text := fun (ev : Event) => case ev as s1 in Event return Text with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (attrsText pl afterKey) as s2 in Option return Text with | none => textEnd | some (t : Text) => t))
DEFINE(evBefore, : Event -> Option Text := fun (ev : Event) => case ev as s1 in Event return Option Text with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => attrsText pl beforeKey)
DEFINE(moveHas, : Flag -> Event -> Text -> Flag := fun (f : Flag) (ev : Event) (s : Text) => case f as s1 in Flag return Flag with | flagNo => textSame (evAfter ev) s | flagYes => (case (evBefore ev) as s2 in Option return Flag with | none => flagNo | some (bt : Text) => textSame bt s))
DEFINE(moveNames, : Event -> List Text -> List Text := fun (ev : Event) (rest : List Text) => case (evBefore ev) as s1 in Option return List Text with | none => cons (evAfter ev) rest | some (bt : Text) => cons bt (cons (evAfter ev) rest))
DEFINE_REC(stageNames, : List Record -> List Text := fun (l : List Record) => case l as s1 in List return List Text with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Text with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return List Text with | none => (case (moveOf b) as s4 in Option return List Text with | none => stageNames r | some (ev : Event) => moveNames ev (stageNames r)) | some (c : Commercial) => cons (commercialStage c) (stageNames r))))
DEFINE_REC(stageMoves, : List Record -> Flag -> Text -> Nat := fun (l : List Record) (f : Flag) (s : Text) => case l as s1 in List return Nat with | nil => 0 | cons (x : Record) (r : List Record) => (case x as s2 in Record return Nat with | makeRecord (h : Text) (b : Body) => (case (moveOf b) as s3 in Option return Nat with | none => stageMoves r f s | some (ev : Event) => (case (moveHas f ev s) as s4 in Flag return Nat with | flagNo => stageMoves r f s | flagYes => natAdd 1 (stageMoves r f s)))))
DEFINE_REC(stageSpan, : List Record -> Text -> Text -> Nat := fun (l : List Record) (d : Text) (s : Text) => case l as s1 in List return Nat with | nil => 1 | cons (x : Record) (r : List Record) => (case x as s2 in Record return Nat with | makeRecord (h : Text) (b : Body) => (case (moveOf b) as s3 in Option return Nat with | none => natAdd 1 (stageSpan r d s) | some (ev : Event) => (case (flagAnd (textSame (evDeal ev) d) (moveHas flagYes ev s)) as s4 in Flag return Nat with | flagNo => natAdd 1 (stageSpan r d s) | flagYes => 1))))
DEFINE(stayCost, : Body -> Text -> List Record -> Text -> Nat := fun (b : Body) (h : Text) (r : List Record) (s : Text) => case (bodyCommercial b) as s1 in Option return Nat with | none => (case (moveOf b) as s3 in Option return Nat with | none => 0 | some (ev : Event) => (case (textSame (evAfter ev) s) as s4 in Flag return Nat with | flagNo => 0 | flagYes => stageSpan r (evDeal ev) s)) | some (c : Commercial) => (case (textSame (commercialStage c) s) as s2 in Flag return Nat with | flagNo => 0 | flagYes => stageSpan r h s))
DEFINE_REC(stageSum, : List Record -> Text -> Nat := fun (l : List Record) (s : Text) => case l as s1 in List return Nat with | nil => 0 | cons (x : Record) (r : List Record) => (case x as s2 in Record return Nat with | makeRecord (h : Text) (b : Body) => natAdd (stayCost b h r s) (stageSum r s)))
DEFINE_REC(stageMap, : List Record -> List Text -> List StageStat := fun (rs : List Record) (l : List Text) => case l as s1 in List return List StageStat with | nil => nil | cons (s : Text) (r : List Text) => cons (makeStageStat s (stageMoves rs flagNo s) (stageMoves rs flagYes s) (stageSum rs s)) (stageMap rs r))
DEFINE(stageRead, : List Record -> List StageStat := fun (rs : List Record) => stageMap rs (textDedupe (stageNames rs) nil))
DEFINE(kindIsDate, : CommitmentKind -> Flag := fun (k : CommitmentKind) => case k as s1 in CommitmentKind return Flag with | commitmentPrice => flagNo | commitmentTerm => flagNo | commitmentDate => flagYes | commitmentScope => flagNo | commitmentSla => flagNo)
DEFINE(kindIsTerm, : CommitmentKind -> Flag := fun (k : CommitmentKind) => case k as s1 in CommitmentKind return Flag with | commitmentPrice => flagNo | commitmentTerm => flagYes | commitmentDate => flagNo | commitmentScope => flagNo | commitmentSla => flagNo)
DEFINE_REC(renewFirst, : List Record -> List Record -> Text -> (CommitmentKind -> Flag) -> Option Record := fun (l : List Record) (all : List Record) (d : Text) (kf : CommitmentKind -> Flag) => case l as s1 in List return Option Record with | nil => none | cons (x : Record) (r : List Record) => (case x as s2 in Record return Option Record with | makeRecord (h : Text) (b : Body) => (case (bodyCommitment b) as s3 in Option return Option Record with | none => renewFirst r all d kf | some (c : Commitment) => (case c as s4 in Commitment return Option Record with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case (flagAnd (textSame (refText kindCommercial cm) d) (flagAnd (kf ck) (flagAnd (statusLive st) (flagNot (recSuperseded all h))))) as s5 in Flag return Option Record with | flagNo => renewFirst r all d kf | flagYes => some x)))))
DEFINE(recTermRef, : Option Record -> Option (Ref kindCommitment) := fun (o : Option Record) => case o as s1 in Option return Option (Ref kindCommitment) with | none => none | some (x : Record) => (case x as s2 in Record return Option (Ref kindCommitment) with | makeRecord (h : Text) (b : Body) => some (commitmentRef h)))
DEFINE(recDateText, : Record -> Text := fun (x : Record) => case x as s1 in Record return Text with | makeRecord (h : Text) (b : Body) => (case (bodyCommitment b) as s2 in Option return Text with | none => textEnd | some (c : Commitment) => (case c as s3 in Commitment return Text with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case (valueTextOf v) as s4 in Option return Text with | none => textEnd | some (t : Text) => t))))
DEFINE(renewItem, : List Record -> Text -> Option Record -> List Renewal -> List Renewal := fun (all : List Record) (h : Text) (od : Option Record) (rest : List Renewal) => case od as s1 in Option return List Renewal with | none => rest | some (dx : Record) => cons (makeRenewal (commercialRef h) (recDateText dx) (recTermRef (renewFirst all all h kindIsTerm))) rest)
DEFINE_REC(renewWalk, : List Record -> List Record -> List Renewal := fun (l : List Record) (all : List Record) => case l as s1 in List return List Renewal with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Renewal with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return List Renewal with | none => renewWalk r all | some (c : Commercial) => renewItem all h (renewFirst all all h kindIsDate) (renewWalk r all))))
DEFINE(renewRead, : List Record -> List Renewal := fun (rs : List Record) => renewWalk rs rs)
DEFINE(acctNames, : Account -> Text -> List Text -> Flag := fun (a : Account) (p : Text) (ds : List Text) => case a as s1 in Account return Flag with | accountParty (r : Ref kindParty) => textSame (refText kindParty r) p | accountCommercial (c : Ref kindCommercial) => textIn ds (refText kindCommercial c))
DEFINE_REC(acctsName, : List Account -> Text -> List Text -> Flag := fun (l : List Account) (p : Text) (ds : List Text) => case l as s1 in List return Flag with | nil => flagNo | cons (a : Account) (r : List Account) => flagOr (acctNames a p ds) (acctsName r p ds))
DEFINE(subjNames, : Subject -> Text -> List Text -> Flag := fun (sj : Subject) (p : Text) (ds : List Text) => case sj as s1 in Subject return Flag with | subjectParty (r : Ref kindParty) => textSame (refText kindParty r) p | subjectMembership (r : Ref kindMembership) => flagNo | subjectCommercial (c : Ref kindCommercial) => textIn ds (refText kindCommercial c) | subjectCommitment (r : Ref kindCommitment) => flagNo | subjectAssignment (r : Ref kindAssignment) => flagNo)
DEFINE_REC(acctDeals, : List Record -> Text -> List Text := fun (l : List Record) (p : Text) => case l as s1 in List return List Text with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Text with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return List Text with | none => acctDeals r p | some (c : Commercial) => (case c as s4 in Commercial return List Text with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => (case (textSame (refText kindParty x2) p) as s5 in Flag return List Text with | flagNo => acctDeals r p | flagYes => cons h (acctDeals r p))))))
DEFINE_REC(dealRefs, : List Text -> List (Ref kindCommercial) := fun (l : List Text) => case l as s1 in List return List (Ref kindCommercial) with | nil => nil | cons (h : Text) (r : List Text) => cons (commercialRef h) (dealRefs r))
DEFINE_REC(acctMems, : List Record -> Text -> List (Ref kindMembership) := fun (l : List Record) (p : Text) => case l as s1 in List return List (Ref kindMembership) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindMembership) with | makeRecord (h : Text) (b : Body) => (case (bodyMembership b) as s3 in Option return List (Ref kindMembership) with | none => acctMems r p | some (m : Membership) => (case m as s4 in Membership return List (Ref kindMembership) with | makeMembership (pe : Ref kindParty) (og : Ref kindParty) (ro : Option Text) (ip : Flag) (eb : Option (Ref kindEvent)) (pv : Provenance) (ats : Attrs) => (case (flagAnd (optNone (Ref kindEvent) eb) (flagOr (textSame (refText kindParty pe) p) (textSame (refText kindParty og) p))) as s5 in Flag return List (Ref kindMembership) with | flagNo => acctMems r p | flagYes => cons (membershipRef h) (acctMems r p))))))
DEFINE_REC(acctAssigns, : List Record -> Text -> List Text -> List (Ref kindAssignment) := fun (l : List Record) (p : Text) (ds : List Text) => case l as s1 in List return List (Ref kindAssignment) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindAssignment) with | makeRecord (h : Text) (b : Body) => (case (bodyAssignment b) as s3 in Option return List (Ref kindAssignment) with | none => acctAssigns r p ds | some (m : Assignment) => (case m as s4 in Assignment return List (Ref kindAssignment) with | makeAssignment (sb : Account) (ae : Ref kindParty) (rl : AssignmentRole) (te : Option Text) (eb : Option (Ref kindEvent)) (pv : Provenance) => (case (flagAnd (optNone (Ref kindEvent) eb) (acctNames sb p ds)) as s5 in Flag return List (Ref kindAssignment) with | flagNo => acctAssigns r p ds | flagYes => cons (assignmentRef h) (acctAssigns r p ds))))))
DEFINE_REC(acctArts, : List Record -> Text -> List Text -> List (Ref kindArtifact) := fun (l : List Record) (p : Text) (ds : List Text) => case l as s1 in List return List (Ref kindArtifact) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindArtifact) with | makeRecord (h : Text) (b : Body) => (case (bodyArtifact b) as s3 in Option return List (Ref kindArtifact) with | none => acctArts r p ds | some (m : Artifact) => (case m as s4 in Artifact return List (Ref kindArtifact) with | makeArtifact (kd : ArtifactKind) (sh : Text) (ur : Text) (mi : Text) (sbs : List Account) (ats : Attrs) => (case (acctsName sbs p ds) as s5 in Flag return List (Ref kindArtifact) with | flagNo => acctArts r p ds | flagYes => cons (artifactRef h) (acctArts r p ds))))))
DEFINE_REC(acctTimes, : List Record -> Text -> List Text -> List (Ref kindEvent) := fun (l : List Record) (p : Text) (ds : List Text) => case l as s1 in List return List (Ref kindEvent) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindEvent) with | makeRecord (h : Text) (b : Body) => (case (bodyEvent b) as s3 in Option return List (Ref kindEvent) with | none => acctTimes r p ds | some (m : Event) => (case m as s4 in Event return List (Ref kindEvent) with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (subjNames sj p ds) as s5 in Flag return List (Ref kindEvent) with | flagNo => acctTimes r p ds | flagYes => cons (eventRef h) (acctTimes r p ds))))))
DEFINE(acctDummy, : Account360 := makeAccount360 (makeParty partyOrg textEnd none nil attrsEnd none none) nil nil nil nil nil)
DEFINE(acctView, : List Record -> Text -> Party -> List Text -> Account360 := fun (rs : List Record) (p : Text) (pa : Party) (ds : List Text) => makeAccount360 pa (acctMems rs p) (dealRefs ds) (acctAssigns rs p ds) (acctArts rs p ds) (acctTimes rs p ds))
DEFINE(acctRead, : List Record -> Text -> Account360 := fun (rs : List Record) (p : Text) => case (recFind rs p) as s1 in Option return Account360 with | none => acctDummy | some (b : Body) => (case (bodyParty b) as s2 in Option return Account360 with | none => acctDummy | some (pa : Party) => acctView rs p pa (acctDeals rs p)))
DEFINE(provConf, : Provenance -> Option Nat := fun (v : Provenance) => case v as s1 in Provenance return Option Nat with | makeProvenance (pa : Option (Ref kindArtifact)) (pe : Option (Ref kindEvent)) (pc : Option Nat) => pc)
DEFINE(bodyConfidence, : Body -> Option Nat := fun (b : Body) => case b as s1 in Body return Option Nat with | createsParty (m : Party) => none | createsMembership (m : Membership) => (case m as s2 in Membership return Option Nat with | makeMembership (pe : Ref kindParty) (og : Ref kindParty) (ro : Option Text) (ip : Flag) (eb : Option (Ref kindEvent)) (pv : Provenance) (ats : Attrs) => provConf pv) | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => (case m as s3 in Commitment return Option Nat with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => provConf pv) | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => (case m as s4 in Assignment return Option Nat with | makeAssignment (sb : Account) (ae : Ref kindParty) (rl : AssignmentRole) (te : Option Text) (eb : Option (Ref kindEvent)) (pv : Provenance) => provConf pv) | createsPolicy (m : Policy) => none)
DEFINE_REC(reviewWalk, : List Record -> Nat -> List Hash := fun (l : List Record) (bl : Nat) => case l as s1 in List return List Hash with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Hash with | makeRecord (h : Text) (b : Body) => (case (bodyConfidence b) as s3 in Option return List Hash with | none => reviewWalk r bl | some (k : Nat) => (case (natLt k bl) as s4 return List Hash with | 0 (no : prod ()) => reviewWalk r bl | 1 (yes : prod ()) => cons (hashOf h) (reviewWalk r bl)))))
DEFINE(evArtifact, : Event -> List (Ref kindArtifact) := fun (ev : Event) => case ev as s1 in Event return List (Ref kindArtifact) with | makeEvent (x0 : EventType) (x1 : Subject) (x2 : Option (Ref kindArtifact)) (x3 : Option (Ref kindEvent)) (x4 : Attrs) (x5 : Option (Ref kindPolicy)) => (case x2 as s2 in Option return List (Ref kindArtifact) with | none => nil | some (a : Ref kindArtifact) => cons a nil))
DEFINE(evidenceBody, : Text -> Body -> List (Ref kindArtifact) := fun (d : Text) (b : Body) => case (bodyEvent b) as s1 in Option return List (Ref kindArtifact) with | none => (case (bodyArtifact b) as s2 in Option return List (Ref kindArtifact) with | none => nil | some (m : Artifact) => cons (artifactRef d) nil) | some (ev : Event) => evArtifact ev)
DEFINE(evidenceRead, : List Record -> Hash -> List (Ref kindArtifact) := fun (rs : List Record) (h : Hash) => case h as s1 in Hash return List (Ref kindArtifact) with | hashOf (d : Text) => (case (recFind rs d) as s2 in Option return List (Ref kindArtifact) with | none => nil | some (b : Body) => evidenceBody d b))
DEFINE(artSame, : Artifact -> Text -> Flag := fun (m : Artifact) (g : Text) => case m as s1 in Artifact return Flag with | makeArtifact (x0 : ArtifactKind) (x1 : Text) (x2 : Text) (x3 : Text) (x4 : List Account) (x5 : Attrs) => textSame x1 g)
DEFINE(intactRead, : List Record -> Ref kindArtifact -> Text -> Flag := fun (rs : List Record) (r : Ref kindArtifact) (g : Text) => case (recFind rs (refText kindArtifact r)) as s1 in Option return Flag with | none => flagNo | some (b : Body) => (case (bodyArtifact b) as s2 in Option return Flag with | none => flagNo | some (m : Artifact) => artSame m g))
DEFINE(subjSame, : Subject -> Subject -> Flag := fun (a : Subject) (b : Subject) => case a as s1 in Subject return Flag with | subjectParty (x : Ref kindParty) => (case b as s2 in Subject return Flag with | subjectParty (y : Ref kindParty) => refSame kindParty x y | subjectMembership (y : Ref kindMembership) => flagNo | subjectCommercial (y : Ref kindCommercial) => flagNo | subjectCommitment (y : Ref kindCommitment) => flagNo | subjectAssignment (y : Ref kindAssignment) => flagNo) | subjectMembership (x : Ref kindMembership) => (case b as s3 in Subject return Flag with | subjectParty (y : Ref kindParty) => flagNo | subjectMembership (y : Ref kindMembership) => refSame kindMembership x y | subjectCommercial (y : Ref kindCommercial) => flagNo | subjectCommitment (y : Ref kindCommitment) => flagNo | subjectAssignment (y : Ref kindAssignment) => flagNo) | subjectCommercial (x : Ref kindCommercial) => (case b as s4 in Subject return Flag with | subjectParty (y : Ref kindParty) => flagNo | subjectMembership (y : Ref kindMembership) => flagNo | subjectCommercial (y : Ref kindCommercial) => refSame kindCommercial x y | subjectCommitment (y : Ref kindCommitment) => flagNo | subjectAssignment (y : Ref kindAssignment) => flagNo) | subjectCommitment (x : Ref kindCommitment) => (case b as s5 in Subject return Flag with | subjectParty (y : Ref kindParty) => flagNo | subjectMembership (y : Ref kindMembership) => flagNo | subjectCommercial (y : Ref kindCommercial) => flagNo | subjectCommitment (y : Ref kindCommitment) => refSame kindCommitment x y | subjectAssignment (y : Ref kindAssignment) => flagNo) | subjectAssignment (x : Ref kindAssignment) => (case b as s6 in Subject return Flag with | subjectParty (y : Ref kindParty) => flagNo | subjectMembership (y : Ref kindMembership) => flagNo | subjectCommercial (y : Ref kindCommercial) => flagNo | subjectCommitment (y : Ref kindCommitment) => flagNo | subjectAssignment (y : Ref kindAssignment) => refSame kindAssignment x y))
DEFINE_REC(timelineRead, : List Record -> Subject -> List (Ref kindEvent) := fun (l : List Record) (sb : Subject) => case l as s1 in List return List (Ref kindEvent) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindEvent) with | makeRecord (h : Text) (b : Body) => (case (bodyEvent b) as s3 in Option return List (Ref kindEvent) with | none => timelineRead r sb | some (m : Event) => (case m as s4 in Event return List (Ref kindEvent) with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (subjSame sj sb) as s5 in Flag return List (Ref kindEvent) with | flagNo => timelineRead r sb | flagYes => cons (eventRef h) (timelineRead r sb))))))
DEFINE(eventParent, : Body -> Option (Ref kindEvent) := fun (b : Body) => case (bodyEvent b) as s1 in Option return Option (Ref kindEvent) with | none => none | some (m : Event) => (case m as s2 in Event return Option (Ref kindEvent) with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => pa))
DEFINE_REC(threadReaches, : List Record -> List Record -> Text -> Text -> Flag := fun (fu : List Record) (rs : List Record) (h : Text) (root : Text) => case fu as s1 in List return Flag with | nil => flagNo | cons (x : Record) (r : List Record) => (case (textSame h root) as s2 in Flag return Flag with | flagYes => flagYes | flagNo => (case (recFind rs h) as s3 in Option return Flag with | none => flagNo | some (b : Body) => (case (eventParent b) as s4 in Option return Flag with | none => flagNo | some (p : Ref kindEvent) => threadReaches r rs (refText kindEvent p) root))))
DEFINE_REC(threadWalk, : List Record -> List Record -> Text -> List (Ref kindEvent) := fun (l : List Record) (rs : List Record) (root : Text) => case l as s1 in List return List (Ref kindEvent) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindEvent) with | makeRecord (h : Text) (b : Body) => (case (textSame h root) as s3 in Flag return List (Ref kindEvent) with | flagYes => threadWalk r rs root | flagNo => (case (eventParent b) as s4 in Option return List (Ref kindEvent) with | none => threadWalk r rs root | some (p : Ref kindEvent) => (case (threadReaches rs rs (refText kindEvent p) root) as s5 in Flag return List (Ref kindEvent) with | flagNo => threadWalk r rs root | flagYes => cons (eventRef h) (threadWalk r rs root))))))
DEFINE(threadRead, : List Record -> Ref kindEvent -> List (Ref kindEvent) := fun (rs : List Record) (r : Ref kindEvent) => case (recFind rs (refText kindEvent r)) as s1 in Option return List (Ref kindEvent) with | none => nil | some (b : Body) => (case (bodyEvent b) as s2 in Option return List (Ref kindEvent) with | none => nil | some (m : Event) => cons r (threadWalk rs rs (refText kindEvent r))))
DEFINE_REC(auditPolicyRead, : List Record -> Ref kindPolicy -> List (Ref kindEvent) := fun (l : List Record) (q : Ref kindPolicy) => case l as s1 in List return List (Ref kindEvent) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindEvent) with | makeRecord (h : Text) (b : Body) => (case (bodyEvent b) as s3 in Option return List (Ref kindEvent) with | none => auditPolicyRead r q | some (m : Event) => (case m as s4 in Event return List (Ref kindEvent) with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case po as s5 in Option return List (Ref kindEvent) with | none => auditPolicyRead r q | some (p : Ref kindPolicy) => (case (refSame kindPolicy p q) as s6 in Flag return List (Ref kindEvent) with | flagNo => auditPolicyRead r q | flagYes => cons (eventRef h) (auditPolicyRead r q)))))))
DEFINE_REC(acctIn, : List Account -> Account -> Flag := fun (l : List Account) (a : Account) => case l as s1 in List return Flag with | nil => flagNo | cons (x : Account) (r : List Account) => (case (acctSame x a) as s2 in Flag return Flag with | flagNo => acctIn r a | flagYes => flagYes))
DEFINE(bookMatch, : Assignment -> Ref kindParty -> Flag := fun (m : Assignment) (p : Ref kindParty) => case (refSame kindParty (assigneeOf m) p) as s1 in Flag return Flag with | flagNo => flagNo | flagYes => assignCurrent m)
DEFINE_REC(bookWalk, : List Record -> Ref kindParty -> List Account -> List Account := fun (l : List Record) (p : Ref kindParty) (seen : List Account) => case l as s1 in List return List Account with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Account with | makeRecord (h : Text) (b : Body) => (case (bodyAssignment b) as s3 in Option return List Account with | none => bookWalk r p seen | some (m : Assignment) => (case (bookMatch m p) as s4 in Flag return List Account with | flagNo => bookWalk r p seen | flagYes => (case (acctIn seen (subjectOf m)) as s5 in Flag return List Account with | flagNo => cons (subjectOf m) (bookWalk r p (cons (subjectOf m) seen)) | flagYes => bookWalk r p seen)))))
DEFINE(bookRead, : List Record -> Ref kindParty -> List Account := fun (rs : List Record) (p : Ref kindParty) => bookWalk rs p nil)
DEFINE_REC(permIn, : List Permission -> Permission -> Flag := fun (l : List Permission) (p : Permission) => case l as s1 in List return Flag with | nil => flagNo | cons (x : Permission) (r : List Permission) => flagOr (natSame (case x as s2 in Permission return Nat with | permissionRead => 0 | permissionWrite => 1 | permissionTransition => 2 | permissionAssign => 3) (case p as s3 in Permission return Nat with | permissionRead => 0 | permissionWrite => 1 | permissionTransition => 2 | permissionAssign => 3)) (permIn r p))
DEFINE_REC(textsAll, : List Text -> List Text -> Flag := fun (l : List Text) (s : List Text) => case l as s1 in List return Flag with | nil => flagYes | cons (x : Text) (r : List Text) => flagAnd (textIn s x) (textsAll r s))
DEFINE(fieldsOk, : Option (List Text) -> Option (List Text) -> Flag := fun (f : Option (List Text)) (q : Option (List Text)) => case f as s1 in Option return Flag with | none => flagYes | some (fs : List Text) => (case q as s2 in Option return Flag with | none => flagYes | some (qs : List Text) => textsAll qs fs))
DEFINE(ruleAllows, : AclRule -> Text -> Permission -> Option (List Text) -> Flag := fun (u : AclRule) (p : Text) (a : Permission) (q : Option (List Text)) => case u as s1 in AclRule return Flag with | makeAclRule (x0 : Text) (x1 : List Permission) (x2 : Option (List Text)) => flagAnd (textSame x0 p) (flagAnd (permIn x1 a) (fieldsOk x2 q)))
DEFINE_REC(rulesAllow, : List AclRule -> Text -> Permission -> Option (List Text) -> Flag := fun (l : List AclRule) (p : Text) (a : Permission) (q : Option (List Text)) => case l as s1 in List return Flag with | nil => flagNo | cons (x : AclRule) (r : List AclRule) => flagOr (ruleAllows x p a q) (rulesAllow r p a q))
DEFINE(scopeApplies, : List Record -> PolicyScope -> Subject -> Flag := fun (rs : List Record) (o : PolicyScope) (s : Subject) => case o as s1 in PolicyScope return Flag with | scopeCommercial (k : KindCommercial) => (case s as s2 in Subject return Flag with | subjectParty (x : Ref kindParty) => flagNo | subjectMembership (x : Ref kindMembership) => flagNo | subjectCommercial (x : Ref kindCommercial) => (case (recCommercial rs (refText kindCommercial x)) as s3 in Option return Flag with | none => flagNo | some (m : Commercial) => (case m as s4 in Commercial return Flag with | makeCommercial (y0 : KindCommercial) (y1 : Text) (y2 : Ref kindParty) (y3 : Text) (y4 : Option Nat) (y5 : Text) (y6 : Option Text) (y7 : CommercialStatus) (y8 : Attrs) (y9 : Option (Ref kindEvent)) => natSame (kcNat y0) (kcNat k))) | subjectCommitment (x : Ref kindCommitment) => flagNo | subjectAssignment (x : Ref kindAssignment) => flagNo) | scopeParty => (case s as s5 in Subject return Flag with | subjectParty (x : Ref kindParty) => flagYes | subjectMembership (x : Ref kindMembership) => flagNo | subjectCommercial (x : Ref kindCommercial) => flagNo | subjectCommitment (x : Ref kindCommitment) => flagNo | subjectAssignment (x : Ref kindAssignment) => flagNo) | scopeAll => flagYes)
DEFINE(scopeOpt, : List Record -> PolicyScope -> Option Subject -> Flag := fun (rs : List Record) (o : PolicyScope) (s : Option Subject) => case s as s1 in Option return Flag with | none => (case o as s2 in PolicyScope return Flag with | scopeCommercial (k : KindCommercial) => flagNo | scopeParty => flagNo | scopeAll => flagYes) | some (j : Subject) => scopeApplies rs o j)
DEFINE(policyRef, : Text -> Ref kindPolicy := fun (h : Text) => refTo (hashOf h))
DEFINE_REC(canWalk, : List Record -> List Record -> Text -> Permission -> Option Subject -> Option (List Text) -> Option (Ref kindPolicy) -> Verdict := fun (l : List Record) (rs : List Record) (p : Text) (a : Permission) (s : Option Subject) (q : Option (List Text)) (acc : Option (Ref kindPolicy)) => case l as s1 in List return Verdict with | nil => verdictDeny acc | cons (x : Record) (r : List Record) => (case x as s2 in Record return Verdict with | makeRecord (h : Text) (b : Body) => (case (bodyPolicy b) as s3 in Option return Verdict with | none => canWalk r rs p a s q acc | some (m : Policy) => (case m as s4 in Policy return Verdict with | makePolicy (z0 : Text) (z1 : PolicyScope) (z2 : Option Text) (z3 : Option Text) (z4 : Requirement) (z5 : List AclRule) (z6 : Flag) => (case (flagAnd z6 (scopeOpt rs z1 s)) as s5 in Flag return Verdict with | flagNo => canWalk r rs p a s q acc | flagYes => (case (rulesAllow z5 p a q) as s6 in Flag return Verdict with | flagNo => canWalk r rs p a s q (case acc as s7 in Option return Option (Ref kindPolicy) with | none => some (policyRef h) | some (y : Ref kindPolicy) => some y) | flagYes => verdictAllow (policyRef h)))))))
DEFINE(canRead, : List Record -> Text -> Permission -> Subject -> Option (List Text) -> Verdict := fun (rs : List Record) (p : Text) (a : Permission) (s : Subject) (q : Option (List Text)) => canWalk rs rs p a (some s) q none)
DEFINE_REC(askFields, : List Record -> Text -> Permission -> Option (List Text) -> List (Option Subject) -> Verdict := fun (rs : List Record) (p : Text) (a : Permission) (f : Option (List Text)) (l : List (Option Subject)) => case l as s1 in List return Verdict with | nil => verdictDeny none | cons (s : Option Subject) (r : List (Option Subject)) => (case (canWalk rs rs p a s f none) as s2 in Verdict return Verdict with | verdictDeny (d : Option (Ref kindPolicy)) => (case d as s3 in Option return Verdict with | none => askFields rs p a f r | some (y : Ref kindPolicy) => verdictDeny (some y)) | verdictAllow (y : Ref kindPolicy) => (case (askFields rs p a f r) as s4 in Verdict return Verdict with | verdictDeny (e : Option (Ref kindPolicy)) => (case e as s5 in Option return Verdict with | none => verdictAllow y | some (z : Ref kindPolicy) => verdictDeny (some z)) | verdictAllow (z : Ref kindPolicy) => verdictAllow y)))
DEFINE(askWalk, : List Record -> Text -> Permission -> List (Option Subject) -> Verdict := fun (rs : List Record) (p : Text) (a : Permission) (l : List (Option Subject)) => askFields rs p a none l)
DEFINE(attrsKeep, : List Record -> Text -> Subject -> Text -> Flag := fun (rs : List Record) (p : Text) (s : Subject) (k : Text) => case (canRead rs p permissionRead s (some (cons k nil))) as s1 in Verdict return Flag with | verdictAllow (v : Ref kindPolicy) => flagYes | verdictDeny (v : Option (Ref kindPolicy)) => flagNo)
DEFINE_REC(redactWalk, : Attrs -> List Record -> Text -> Subject -> Attrs := fun (a : Attrs) (rs : List Record) (p : Text) (s : Subject) => case a as s1 in Attrs return Attrs with | attrsEnd => attrsEnd | attrsField (k : Text) (v : Value) (r : Attrs) => (case (attrsKeep rs p s k) as s2 in Flag return Attrs with | flagNo => redactWalk r rs p s | flagYes => attrsField k v (redactWalk r rs p s)))
DEFINE(redactRead, : List Record -> Text -> Subject -> Attrs := fun (rs : List Record) (p : Text) (s : Subject) => redactWalk (case s as s1 in Subject return Attrs with | subjectParty (x : Ref kindParty) => (case (recFind rs (refText kindParty x)) as s2 in Option return Attrs with | none => attrsEnd | some (b : Body) => (case (bodyParty b) as s3 in Option return Attrs with | none => attrsEnd | some (m : Party) => (case m as s4 in Party return Attrs with | makeParty (y0 : KindParty) (y1 : Text) (y2 : Option Text) (y3 : List Identifier) (y4 : Attrs) (y5 : Option (Ref kindEvent)) (y6 : Option (Ref kindEvent)) => y4))) | subjectMembership (x : Ref kindMembership) => attrsEnd | subjectCommercial (x : Ref kindCommercial) => (case (recCommercial rs (refText kindCommercial x)) as s5 in Option return Attrs with | none => attrsEnd | some (m : Commercial) => (case m as s6 in Commercial return Attrs with | makeCommercial (y0 : KindCommercial) (y1 : Text) (y2 : Ref kindParty) (y3 : Text) (y4 : Option Nat) (y5 : Text) (y6 : Option Text) (y7 : CommercialStatus) (y8 : Attrs) (y9 : Option (Ref kindEvent)) => y8)) | subjectCommitment (x : Ref kindCommitment) => attrsEnd | subjectAssignment (x : Ref kindAssignment) => attrsEnd) rs p s)
DEFINE(ckNat, : CommitmentKind -> Nat := fun (k : CommitmentKind) => case k as s1 in CommitmentKind return Nat with | commitmentPrice => 0 | commitmentTerm => 1 | commitmentDate => 2 | commitmentScope => 3 | commitmentSla => 4)
DEFINE(etNat, : EventType -> Nat := fun (t : EventType) => case t as s1 in EventType return Nat with | eventStageChanged => 0 | eventAmountChanged => 1 | eventAssignmentChanged => 2 | eventCommitmentSet => 3 | eventNoteAdded => 4 | eventMessage => 5 | eventMeeting => 6 | eventCall => 7 | eventApproval => 8 | eventPolicyDenied => 9 | eventFieldsChanged => 10 | eventIdentifierVerified => 11 | eventEnded => 12 | eventDeleted => 13)
DEFINE(optTexts, : Option (List Text) -> List Text := fun (o : Option (List Text)) => case o as s1 in Option return List Text with | none => nil | some (l : List Text) => l)
DEFINE(optKinds, : Option (List CommitmentKind) -> List CommitmentKind := fun (o : Option (List CommitmentKind)) => case o as s1 in Option return List CommitmentKind with | none => nil | some (l : List CommitmentKind) => l)
DEFINE(comAttrs, : List Record -> Ref kindCommercial -> Attrs := fun (rs : List Record) (c : Ref kindCommercial) => case (recCommercial rs (refText kindCommercial c)) as s1 in Option return Attrs with | none => attrsEnd | some (m : Commercial) => (case m as s2 in Commercial return Attrs with | makeCommercial (y0 : KindCommercial) (y1 : Text) (y2 : Ref kindParty) (y3 : Text) (y4 : Option Nat) (y5 : Text) (y6 : Option Text) (y7 : CommercialStatus) (y8 : Attrs) (y9 : Option (Ref kindEvent)) => y8))
DEFINE(fromOk, : List Record -> Ref kindCommercial -> Option Text -> Flag := fun (rs : List Record) (c : Ref kindCommercial) (f : Option Text) => case f as s1 in Option return Flag with | none => flagYes | some (t : Text) => (case (recCommercial rs (refText kindCommercial c)) as s2 in Option return Flag with | none => flagNo | some (m : Commercial) => (case m as s3 in Commercial return Flag with | makeCommercial (y0 : KindCommercial) (y1 : Text) (y2 : Ref kindParty) (y3 : Text) (y4 : Option Nat) (y5 : Text) (y6 : Option Text) (y7 : CommercialStatus) (y8 : Attrs) (y9 : Option (Ref kindEvent)) => textSame y3 t)))
DEFINE(toIs, : Option Text -> Text -> Flag := fun (o : Option Text) (t : Text) => case o as s1 in Option return Flag with | none => flagNo | some (x : Text) => textSame x t)
DEFINE_REC(missFields, : List Text -> Attrs -> List Missing -> List Missing := fun (l : List Text) (a : Attrs) (z : List Missing) => case l as s1 in List return List Missing with | nil => z | cons (f : Text) (r : List Text) => (case (attrsGet a f) as s2 in Option return List Missing with | none => cons (missingField f) (missFields r a z) | some (v : Value) => missFields r a z))
DEFINE_REC(agreedHas, : List Record -> Text -> Nat -> Flag := fun (l : List Record) (d : Text) (k : Nat) => case l as s1 in List return Flag with | nil => flagNo | cons (x : Record) (r : List Record) => (case x as s2 in Record return Flag with | makeRecord (h : Text) (b : Body) => (case (bodyCommitment b) as s3 in Option return Flag with | none => agreedHas r d k | some (c : Commitment) => (case c as s4 in Commitment return Flag with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => flagOr (flagAnd (textSame (refText kindCommercial cm) d) (flagAnd (natSame (ckNat ck) k) (statusAgreed st))) (agreedHas r d k)))))
DEFINE_REC(missKinds, : List CommitmentKind -> List Record -> Text -> List Missing -> List Missing := fun (l : List CommitmentKind) (rs : List Record) (d : Text) (z : List Missing) => case l as s1 in List return List Missing with | nil => z | cons (k : CommitmentKind) (r : List CommitmentKind) => (case (agreedHas rs d (ckNat k)) as s2 in Flag return List Missing with | flagNo => cons (missingCommitment k) (missKinds r rs d z) | flagYes => missKinds r rs d z))
DEFINE_REC(approvalHas, : List Record -> Subject -> Text -> Flag := fun (l : List Record) (s : Subject) (o : Text) => case l as s1 in List return Flag with | nil => flagNo | cons (x : Record) (r : List Record) => (case x as s2 in Record return Flag with | makeRecord (h : Text) (b : Body) => (case (bodyEvent b) as s3 in Option return Flag with | none => approvalHas r s o | some (m : Event) => (case m as s4 in Event return Flag with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => flagOr (flagAnd (natSame (etNat ty) 8) (flagAnd (subjSame sj s) (optSome Value (attrsGet pl o)))) (approvalHas r s o)))))
DEFINE_REC(missRoles, : List Text -> List Record -> Subject -> List Missing -> List Missing := fun (l : List Text) (rs : List Record) (s : Subject) (z : List Missing) => case l as s1 in List return List Missing with | nil => z | cons (o : Text) (r : List Text) => (case (approvalHas rs s o) as s2 in Flag return List Missing with | flagNo => cons (missingApproval o) (missRoles r rs s z) | flagYes => missRoles r rs s z))
DEFINE_REC(dryWalk, : List Record -> List Record -> Ref kindCommercial -> Text -> List Missing := fun (l : List Record) (rs : List Record) (c : Ref kindCommercial) (st : Text) => case l as s1 in List return List Missing with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Missing with | makeRecord (h : Text) (b : Body) => (case (bodyPolicy b) as s3 in Option return List Missing with | none => dryWalk r rs c st | some (m : Policy) => (case m as s4 in Policy return List Missing with | makePolicy (z0 : Text) (z1 : PolicyScope) (z2 : Option Text) (z3 : Option Text) (z4 : Requirement) (z5 : List AclRule) (z6 : Flag) => (case (flagAnd z6 (flagAnd (scopeApplies rs z1 (subjectCommercial c)) (flagAnd (toIs z3 st) (fromOk rs c z2)))) as s5 in Flag return List Missing with | flagNo => dryWalk r rs c st | flagYes => (case z4 as s6 in Requirement return List Missing with | makeRequirement (q0 : Option (List Text)) (q1 : Option (List CommitmentKind)) (q2 : Option (List Text)) (q3 : Option Nat) => missFields (optTexts q0) (comAttrs rs c) (missKinds (optKinds q1) rs (refText kindCommercial c) (missRoles (optTexts q2) rs (subjectCommercial c) (dryWalk r rs c st)))))))))
DEFINE(dryRead, : List Record -> Ref kindCommercial -> Text -> List Missing := fun (rs : List Record) (c : Ref kindCommercial) (st : Text) => dryWalk rs rs c st)
DEFINE_REC(guardWalk, : List Record -> List Record -> Ref kindCommercial -> Text -> Option (Ref kindPolicy) := fun (l : List Record) (rs : List Record) (c : Ref kindCommercial) (st : Text) => case l as s1 in List return Option (Ref kindPolicy) with | nil => none | cons (x : Record) (r : List Record) => (case (dryWalk (cons x nil) rs c st) as s2 in List return Option (Ref kindPolicy) with | nil => guardWalk r rs c st | cons (y : Missing) (z : List Missing) => (case x as s3 in Record return Option (Ref kindPolicy) with | makeRecord (h : Text) (b : Body) => some (policyRef h))))
DEFINE(actorText, : Actor -> Text := fun (a : Actor) => case a as s1 in Actor return Text with | actorHuman (p : Ref kindParty) => refText kindParty p | actorAgent (n : Text) => n | actorSystem (n : Text) => n)
/* M7 part A (design items 1 to 4, deltas A-5 to A-7): the write path. writeGo
   mirrors checker.c write_step: missingField, the body, the verdict on each
   subject (askWalk), the guard (commandTransition), expect, then append with
   the allowing policy. */
DEFINE(commercialKey, : Text := textByte 99 (textByte 111 (textByte 109 (textByte 109 (textByte 101 (textByte 114 (textByte 99 (textByte 105 (textByte 97 (textByte 108 textEnd))))))))))
DEFINE(writeEnd, : (Entry -> Text) -> Log -> Actor -> Option Hash -> Body -> Option (Ref kindPolicy) -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (b : Body) (o : Option (Ref kindPolicy)) => case (writeLast lg none) as s1 in Option return Step with | none => (case x as s2 in Option return Step with | none => writeAdd hs lg (makeEntry none a b) o | some (h : Hash) => makeStep lg (outcomeDenied none nil)) | some (e : Entry) => writeOld hs lg x a b (hs e) o)
DEFINE(writeEndM, : (Entry -> Text) -> Log -> Actor -> Option Hash -> Body -> (Entry -> List Entry) -> Option (Ref kindPolicy) -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (b : Body) (n : Entry -> List Entry) (o : Option (Ref kindPolicy)) => case (writeLast lg none) as s1 in Option return Step with | none => (case x as s2 in Option return Step with | none => writeAdds hs lg (n (makeEntry none a b)) o | some (h : Hash) => makeStep lg (outcomeDenied none nil)) | some (e : Entry) => writeOldM hs lg x a b n (hs e) o)
DEFINE(writeAllow, : (Entry -> Text) -> Log -> Actor -> Option Hash -> Body -> Verdict -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (b : Body) (v : Verdict) => case v as s1 in Verdict return Step with | verdictDeny (d : Option (Ref kindPolicy)) => (case d as s2 in Option return Step with | none => writeEnd hs lg a x b none | some (p : Ref kindPolicy) => makeStep lg (outcomeDenied (some p) nil)) | verdictAllow (p : Ref kindPolicy) => writeEnd hs lg a x b (some p))
DEFINE(writeAllowM, : (Entry -> Text) -> Log -> Actor -> Option Hash -> Body -> (Entry -> List Entry) -> Verdict -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (b : Body) (n : Entry -> List Entry) (v : Verdict) => case v as s1 in Verdict return Step with | verdictDeny (d : Option (Ref kindPolicy)) => (case d as s2 in Option return Step with | none => writeEndM hs lg a x b n none | some (p : Ref kindPolicy) => makeStep lg (outcomeDenied (some p) nil)) | verdictAllow (p : Ref kindPolicy) => writeEndM hs lg a x b n (some p))
/* M7 part C (deltas MC-2 and MC-7, Q-C-1 (a)): writeAllow with the Body a
   function of the policy: the Event names the allowing policy, none when no
   policy applies. */
DEFINE(writeAllowBy, : (Entry -> Text) -> Log -> Actor -> Option Hash -> (Option (Ref kindPolicy) -> Body) -> Verdict -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (f : Option (Ref kindPolicy) -> Body) (v : Verdict) => case v as s1 in Verdict return Step with | verdictDeny (d : Option (Ref kindPolicy)) => (case d as s2 in Option return Step with | none => writeEnd hs lg a x (f none) none | some (p : Ref kindPolicy) => makeStep lg (outcomeDenied (some p) nil)) | verdictAllow (p : Ref kindPolicy) => writeEnd hs lg a x (f (some p)) (some p))
DEFINE(endedBody, : Ref kindMembership -> Option (Ref kindPolicy) -> Body := fun (m : Ref kindMembership) (o : Option (Ref kindPolicy)) => createsEvent (makeEvent eventEnded (subjectMembership m) none none attrsEnd o))
DEFINE(primaryBody, : Ref kindMembership -> Option (Ref kindPolicy) -> Body := fun (m : Ref kindMembership) (o : Option (Ref kindPolicy)) => createsEvent (makeEvent eventFieldsChanged (subjectMembership m) none none (attrsField primaryKey (valueFlag flagYes) attrsEnd) o))
DEFINE(amountBody, : Ref kindCommercial -> Option Nat -> Option Nat -> Option (Ref kindPolicy) -> Body := fun (m : Ref kindCommercial) (b : Option Nat) (t : Option Nat) (o : Option (Ref kindPolicy)) => createsEvent (makeEvent eventAmountChanged (subjectCommercial m) none none (attrsField beforeKey (natValue b) (attrsField afterKey (natValue t) attrsEnd)) o))
DEFINE(statusBody, : Ref kindCommercial -> CommercialStatus -> Option (Ref kindPolicy) -> Body := fun (m : Ref kindCommercial) (t : CommercialStatus) (o : Option (Ref kindPolicy)) => createsEvent (makeEvent eventFieldsChanged (subjectCommercial m) none none (attrsField statusKey (valueText (statusText t)) attrsEnd) o))
DEFINE(agreeBody, : Ref kindCommitment -> Option (Ref kindPolicy) -> Body := fun (m : Ref kindCommitment) (o : Option (Ref kindPolicy)) => createsEvent (makeEvent eventCommitmentSet (subjectCommitment m) none none (attrsField statusKey (valueText agreedText) attrsEnd) o))
DEFINE(writeMoveBody, : Ref kindCommercial -> Commercial -> Text -> Option (Ref kindPolicy) -> Body := fun (m : Ref kindCommercial) (k : Commercial) (t : Text) (o : Option (Ref kindPolicy)) => createsEvent (makeEvent eventStageChanged (subjectCommercial m) none none (attrsField beforeKey (valueText (commercialStage k)) (attrsField afterKey (valueText t) attrsEnd)) o))
DEFINE(writeGuard, : (Entry -> Text) -> Log -> Actor -> Option Hash -> List Record -> Ref kindCommercial -> Commercial -> Text -> Option (Ref kindPolicy) -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (rs : List Record) (m : Ref kindCommercial) (k : Commercial) (t : Text) (o : Option (Ref kindPolicy)) => case (dryRead rs m t) as s1 in List return Step with | nil => writeEnd hs lg a x (writeMoveBody m k t o) o | cons (y : Missing) (z : List Missing) => makeStep lg (outcomeDenied (guardWalk rs rs m t) (cons y z)))
DEFINE(writeMove, : (Entry -> Text) -> Log -> Actor -> Option Hash -> List Record -> Ref kindCommercial -> Text -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (rs : List Record) (m : Ref kindCommercial) (t : Text) => case (recCommercial rs (refText kindCommercial m)) as s1 in Option return Step with | none => makeStep lg (outcomeDenied none (cons (missingField commercialKey) nil)) | some (k : Commercial) => (case (askWalk rs (actorText a) permissionTransition (cons (some (subjectCommercial m)) nil)) as s2 in Verdict return Step with | verdictDeny (d : Option (Ref kindPolicy)) => (case d as s3 in Option return Step with | none => writeGuard hs lg a x rs m k t none | some (p : Ref kindPolicy) => makeStep lg (outcomeDenied (some p) nil)) | verdictAllow (p : Ref kindPolicy) => writeGuard hs lg a x rs m k t (some p)))
DEFINE(acctSubj, : Account -> Subject := fun (y : Account) => case y as s1 in Account return Subject with | accountParty (p : Ref kindParty) => subjectParty p | accountCommercial (c : Ref kindCommercial) => subjectCommercial c)
DEFINE_REC(acctMap, : List Account -> List (Option Subject) := fun (l : List Account) => case l as s1 in List return List (Option Subject) with | nil => nil | cons (y : Account) (r : List Account) => cons (some (acctSubj y)) (acctMap r))
DEFINE(acctSubjs, : List Account -> List (Option Subject) := fun (l : List Account) => case l as s1 in List return List (Option Subject) with | nil => cons none nil | cons (y : Account) (r : List Account) => acctMap l)
/* M7 part B1 (design items 7, 9 and 10; deltas MB-2 to MB-7): the Party
   writes. systemText, systemName and identMatch mirror checker.c
   write_ident_match; partyFind mirrors write_party_find; writeParty and
   writeVerify mirror the missingField checks and the bodies of
   write_party_change; writeFound mirrors the found end of write_step;
   partyDeleted, partyIdents and partyAttrs mirror program.c projection_party
   for ledgerLastEvent (certificate.c). */
DEFINE(keySystem, : Text := textByte 115 (textByte 121 (textByte 115 (textByte 116 (textByte 101 (textByte 109 textEnd))))))
DEFINE(keyName, : Text := textByte 110 (textByte 97 (textByte 109 (textByte 101 textEnd))))
DEFINE(keyValue, : Text := textByte 118 (textByte 97 (textByte 108 (textByte 117 (textByte 101 textEnd)))))
DEFINE(keyAttrs, : Text := textByte 97 (textByte 116 (textByte 116 (textByte 114 (textByte 115 textEnd)))))
DEFINE(keyRestored, : Text := textByte 114 (textByte 101 (textByte 115 (textByte 116 (textByte 111 (textByte 114 (textByte 101 (textByte 100 textEnd))))))))
DEFINE(keyParty, : Text := textByte 112 (textByte 97 (textByte 114 (textByte 116 (textByte 121 textEnd)))))
DEFINE(keyIdentifier, : Text := textByte 105 (textByte 100 (textByte 101 (textByte 110 (textByte 116 (textByte 105 (textByte 102 (textByte 105 (textByte 101 (textByte 114 textEnd))))))))))
DEFINE(keyErased, : Text := textByte 101 (textByte 114 (textByte 97 (textByte 115 (textByte 101 (textByte 100 textEnd))))))
DEFINE(keySplitTo, : Text := textByte 115 (textByte 112 (textByte 108 (textByte 105 (textByte 116 (textByte 84 (textByte 111 textEnd)))))))
DEFINE(keyMoved, : Text := textByte 109 (textByte 111 (textByte 118 (textByte 101 (textByte 100 textEnd)))))
DEFINE(systemText, : IdentifierSystem -> Text := fun (y : IdentifierSystem) => case y as s1 in IdentifierSystem return Text with | systemEmail => textByte 115 (textByte 121 (textByte 115 (textByte 116 (textByte 101 (textByte 109 (textByte 69 (textByte 109 (textByte 97 (textByte 105 (textByte 108 textEnd)))))))))) | systemDomain => textByte 115 (textByte 121 (textByte 115 (textByte 116 (textByte 101 (textByte 109 (textByte 68 (textByte 111 (textByte 109 (textByte 97 (textByte 105 (textByte 110 textEnd))))))))))) | systemLinkedin => textByte 115 (textByte 121 (textByte 115 (textByte 116 (textByte 101 (textByte 109 (textByte 76 (textByte 105 (textByte 110 (textByte 107 (textByte 101 (textByte 100 (textByte 105 (textByte 110 textEnd))))))))))))) | systemPhone => textByte 115 (textByte 121 (textByte 115 (textByte 116 (textByte 101 (textByte 109 (textByte 80 (textByte 104 (textByte 111 (textByte 110 (textByte 101 textEnd)))))))))) | systemSalesforce => textByte 115 (textByte 121 (textByte 115 (textByte 116 (textByte 101 (textByte 109 (textByte 83 (textByte 97 (textByte 108 (textByte 101 (textByte 115 (textByte 102 (textByte 111 (textByte 114 (textByte 99 (textByte 101 textEnd))))))))))))))) | systemStripe => textByte 115 (textByte 121 (textByte 115 (textByte 116 (textByte 101 (textByte 109 (textByte 83 (textByte 116 (textByte 114 (textByte 105 (textByte 112 (textByte 101 textEnd))))))))))) | systemOther (n : Text) => textByte 115 (textByte 121 (textByte 115 (textByte 116 (textByte 101 (textByte 109 (textByte 79 (textByte 116 (textByte 104 (textByte 101 (textByte 114 textEnd)))))))))))
DEFINE(systemName, : IdentifierSystem -> Text := fun (y : IdentifierSystem) => case y as s1 in IdentifierSystem return Text with | systemEmail => textEnd | systemDomain => textEnd | systemLinkedin => textEnd | systemPhone => textEnd | systemSalesforce => textEnd | systemStripe => textEnd | systemOther (n : Text) => n)
DEFINE(systemFrom, : Text -> Option Text -> Option IdentifierSystem := fun (t : Text) (o : Option Text) => case (textSame t (systemText systemEmail)) as s1 in Flag return Option IdentifierSystem with | flagYes => some systemEmail | flagNo => (case (textSame t (systemText systemDomain)) as s2 in Flag return Option IdentifierSystem with | flagYes => some systemDomain | flagNo => (case (textSame t (systemText systemLinkedin)) as s3 in Flag return Option IdentifierSystem with | flagYes => some systemLinkedin | flagNo => (case (textSame t (systemText systemPhone)) as s4 in Flag return Option IdentifierSystem with | flagYes => some systemPhone | flagNo => (case (textSame t (systemText systemSalesforce)) as s5 in Flag return Option IdentifierSystem with | flagYes => some systemSalesforce | flagNo => (case (textSame t (systemText systemStripe)) as s6 in Flag return Option IdentifierSystem with | flagYes => some systemStripe | flagNo => (case (textSame t (systemText (systemOther textEnd))) as s7 in Flag return Option IdentifierSystem with | flagNo => none | flagYes => (case o as s8 in Option return Option IdentifierSystem with | none => none | some (n : Text) => some (systemOther n)))))))))
DEFINE(identMatch, : Identifier -> IdentifierSystem -> Text -> Flag := fun (i : Identifier) (y : IdentifierSystem) (v : Text) => case i as s1 in Identifier return Flag with | makeIdentifier (y0 : IdentifierSystem) (v0 : Text) (z0 : Option (Ref kindEvent)) => flagAnd (textSame (systemText y0) (systemText y)) (flagAnd (textSame (systemName y0) (systemName y)) (textSame v0 v)))
DEFINE_REC(identIn, : List Identifier -> IdentifierSystem -> Text -> Flag := fun (l : List Identifier) (y : IdentifierSystem) (v : Text) => case l as s1 in List return Flag with | nil => flagNo | cons (i : Identifier) (r : List Identifier) => (case (identMatch i y v) as s2 in Flag return Flag with | flagYes => flagYes | flagNo => identIn r y v))
DEFINE_REC(identsMeet, : List Identifier -> List Identifier -> Flag := fun (l : List Identifier) (w : List Identifier) => case w as s1 in List return Flag with | nil => flagNo | cons (i : Identifier) (r : List Identifier) => (case i as s2 in Identifier return Flag with | makeIdentifier (y : IdentifierSystem) (v : Text) (z : Option (Ref kindEvent)) => (case (identIn l y v) as s3 in Flag return Flag with | flagYes => flagYes | flagNo => identsMeet l r)))
DEFINE_REC(partyFind, : List Record -> List Identifier -> Option Text := fun (l : List Record) (w : List Identifier) => case l as s1 in List return Option Text with | nil => none | cons (q : Record) (r : List Record) => (case q as s2 in Record return Option Text with | makeRecord (h : Text) (b : Body) => (case (bodyParty b) as s3 in Option return Option Text with | none => partyFind r w | some (m : Party) => (case m as s4 in Party return Option Text with | makeParty (x0 : KindParty) (x1 : Text) (x2 : Option Text) (x3 : List Identifier) (x4 : Attrs) (x5 : Option (Ref kindEvent)) (x6 : Option (Ref kindEvent)) => (case (flagAnd (optNone (Ref kindEvent) x6) (identsMeet x3 w)) as s5 in Flag return Option Text with | flagYes => some h | flagNo => partyFind r w)))))
DEFINE(recParty, : List Record -> Text -> Option Party := fun (rs : List Record) (h : Text) => case (recFind rs h) as s1 in Option return Option Party with | none => none | some (b : Body) => bodyParty b)
DEFINE_REC(keysOf, : Attrs -> List Text := fun (n : Attrs) => case n as s1 in Attrs return List Text with | attrsEnd => nil | attrsField (k : Text) (v : Value) (r : Attrs) => cons k (keysOf r))
DEFINE(identPay, : IdentifierSystem -> Text -> Attrs := fun (y : IdentifierSystem) (v : Text) => attrsField keySystem (valueText (systemText y)) (case y as s1 in IdentifierSystem return Attrs with | systemEmail => attrsField keyValue (valueText v) attrsEnd | systemDomain => attrsField keyValue (valueText v) attrsEnd | systemLinkedin => attrsField keyValue (valueText v) attrsEnd | systemPhone => attrsField keyValue (valueText v) attrsEnd | systemSalesforce => attrsField keyValue (valueText v) attrsEnd | systemStripe => attrsField keyValue (valueText v) attrsEnd | systemOther (n : Text) => attrsField keyName (valueText n) (attrsField keyValue (valueText v) attrsEnd)))
DEFINE(identBody, : Identifier -> Attrs := fun (i : Identifier) => case i as s1 in Identifier return Attrs with | makeIdentifier (y : IdentifierSystem) (v : Text) (z : Option (Ref kindEvent)) => identPay y v)
DEFINE(partyEvent, : Ref kindParty -> EventType -> Option (Ref kindArtifact) -> Option (Ref kindEvent) -> Attrs -> Body := fun (p : Ref kindParty) (t : EventType) (f : Option (Ref kindArtifact)) (e : Option (Ref kindEvent)) (l : Attrs) => createsEvent (makeEvent t (subjectParty p) f e l none))
DEFINE(enrichBody, : Ref kindParty -> Attrs -> Provenance -> Body := fun (p : Ref kindParty) (n : Attrs) (v : Provenance) => case v as s1 in Provenance return Body with | makeProvenance (f : Option (Ref kindArtifact)) (e : Option (Ref kindEvent)) (c : Option Nat) => partyEvent p eventFieldsChanged f e (attrsField keyAttrs (valueAttrs n) attrsEnd))
DEFINE(writeParty, : (Entry -> Text) -> Log -> Actor -> Option Hash -> List Record -> Ref kindParty -> Option (List Text) -> Body -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (rs : List Record) (p : Ref kindParty) (f : Option (List Text)) (b : Body) => case (recParty rs (refText kindParty p)) as s1 in Option return Step with | none => makeStep lg (outcomeDenied none (cons (missingField keyParty) nil)) | some (m : Party) => writeAllow hs lg a x b (askFields rs (actorText a) permissionWrite f (cons (some (subjectParty p)) nil)))
DEFINE(writeVerify, : (Entry -> Text) -> Log -> Actor -> Option Hash -> List Record -> Ref kindParty -> IdentifierSystem -> Text -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (rs : List Record) (p : Ref kindParty) (y : IdentifierSystem) (v : Text) => case (recParty rs (refText kindParty p)) as s1 in Option return Step with | none => makeStep lg (outcomeDenied none (cons (missingField keyParty) nil)) | some (m : Party) => (case m as s2 in Party return Step with | makeParty (x0 : KindParty) (x1 : Text) (x2 : Option Text) (x3 : List Identifier) (x4 : Attrs) (x5 : Option (Ref kindEvent)) (x6 : Option (Ref kindEvent)) => (case (identIn x3 y v) as s3 in Flag return Step with | flagNo => makeStep lg (outcomeDenied none (cons (missingField keyIdentifier) nil)) | flagYes => writeAllow hs lg a x (partyEvent p eventIdentifierVerified none none (identPay y v)) (askFields rs (actorText a) permissionWrite none (cons (some (subjectParty p)) nil)))))
DEFINE(foundEnd, : (Entry -> Text) -> Log -> Option Hash -> Text -> Option (Ref kindPolicy) -> Step := fun (hs : Entry -> Text) (lg : Log) (x : Option Hash) (h : Text) (o : Option (Ref kindPolicy)) => case (writeLast lg none) as s1 in Option return Step with | none => (case x as s2 in Option return Step with | none => makeStep lg (outcomeAppended (cons (hashOf h) nil) o) | some (y : Hash) => makeStep lg (outcomeDenied none nil)) | some (e : Entry) => (case x as s3 in Option return Step with | none => makeStep lg (outcomeAppended (cons (hashOf h) nil) o) | some (y : Hash) => (case y as s4 in Hash return Step with | hashOf (d : Text) => (case (textSame d (hs e)) as s5 in Flag return Step with | flagNo => makeStep lg (outcomeConflict (hashOf (hs e))) | flagYes => makeStep lg (outcomeAppended (cons (hashOf h) nil) o)))))
DEFINE(writeFound, : (Entry -> Text) -> Log -> Option Hash -> Text -> Verdict -> Step := fun (hs : Entry -> Text) (lg : Log) (x : Option Hash) (h : Text) (v : Verdict) => case v as s1 in Verdict return Step with | verdictDeny (d : Option (Ref kindPolicy)) => (case d as s2 in Option return Step with | none => foundEnd hs lg x h none | some (p : Ref kindPolicy) => makeStep lg (outcomeDenied (some p) nil)) | verdictAllow (p : Ref kindPolicy) => foundEnd hs lg x h (some p))
DEFINE(restoredIn, : Attrs -> Flag := fun (l : Attrs) => case (attrsGet l keyRestored) as s1 in Option return Flag with | none => flagNo | some (v : Value) => (case v as s2 in Value return Flag with | valueNull => flagNo | valueFlag (f : Flag) => f | valueNat (c : Nat) => flagNo | valueText (t : Text) => flagNo | valueItems (i : Values) => flagNo | valueAttrs (n : Attrs) => flagNo))
DEFINE(erasedIn, : Attrs -> Flag := fun (l : Attrs) => case (attrsGet l keyErased) as s1 in Option return Flag with | none => flagNo | some (v : Value) => (case v as s2 in Value return Flag with | valueNull => flagNo | valueFlag (f : Flag) => f | valueNat (c : Nat) => flagNo | valueText (t : Text) => flagNo | valueItems (i : Values) => flagNo | valueAttrs (n : Attrs) => flagNo))
DEFINE(bodyErased, : Body -> Flag := fun (e : Body) => case (bodyEvent e) as s1 in Option return Flag with | none => flagNo | some (ev : Event) => (case ev as s2 in Event return Flag with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => flagAnd (natSame (etNat ty) 13) (erasedIn pl)))
DEFINE(partyName, : Body -> Text -> Text := fun (e : Body) (t : Text) => case (bodyErased e) as s1 in Flag return Text with | flagYes => textEnd | flagNo => t)
DEFINE(partyLegal, : Body -> Option Text -> Option Text := fun (e : Body) (o : Option Text) => case (bodyErased e) as s1 in Flag return Option Text with | flagYes => none | flagNo => o)
DEFINE(partyDeleted, : Text -> Body -> Option (Ref kindEvent) -> Option (Ref kindEvent) := fun (h : Text) (e : Body) (d : Option (Ref kindEvent)) => case (bodyEvent e) as s1 in Option return Option (Ref kindEvent) with | none => d | some (ev : Event) => (case ev as s2 in Event return Option (Ref kindEvent) with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (natSame (etNat ty) 13) as s3 in Flag return Option (Ref kindEvent) with | flagYes => some (eventRef h) | flagNo => (case (flagAnd (natSame (etNat ty) 10) (restoredIn pl)) as s4 in Flag return Option (Ref kindEvent) with | flagNo => d | flagYes => none))))
DEFINE_REC(identSnoc, : List Identifier -> Identifier -> List Identifier := fun (l : List Identifier) (i : Identifier) => case l as s1 in List return List Identifier with | nil => cons i nil | cons (j : Identifier) (r : List Identifier) => cons j (identSnoc r i))
DEFINE(payIdent, : Attrs -> Option Identifier := fun (pl : Attrs) => case (attrsText pl keySystem) as s1 in Option return Option Identifier with | none => none | some (t : Text) => (case (attrsText pl keyValue) as s2 in Option return Option Identifier with | none => none | some (v : Text) => (case (systemFrom t (attrsText pl keyName)) as s3 in Option return Option Identifier with | none => none | some (y : IdentifierSystem) => some (makeIdentifier y v none))))
DEFINE(identsAdd, : Attrs -> List Identifier -> List Identifier := fun (pl : Attrs) (l : List Identifier) => case (payIdent pl) as s1 in Option return List Identifier with | none => l | some (i : Identifier) => (case i as s2 in Identifier return List Identifier with | makeIdentifier (y : IdentifierSystem) (v : Text) (z : Option (Ref kindEvent)) => (case (identIn l y v) as s3 in Flag return List Identifier with | flagYes => l | flagNo => identSnoc l i)))
DEFINE_REC(identsVer, : Text -> IdentifierSystem -> Text -> List Identifier -> List Identifier := fun (h : Text) (y : IdentifierSystem) (v : Text) (l : List Identifier) => case l as s1 in List return List Identifier with | nil => nil | cons (i : Identifier) (r : List Identifier) => cons (case (identMatch i y v) as s2 in Flag return Identifier with | flagNo => i | flagYes => (case i as s3 in Identifier return Identifier with | makeIdentifier (y0 : IdentifierSystem) (v0 : Text) (z0 : Option (Ref kindEvent)) => makeIdentifier y0 v0 (some (eventRef h)))) (identsVer h y v r))
DEFINE_REC(splitHit, : Identifier -> Values -> Flag := fun (j : Identifier) (vs : Values) => case vs as s1 in Values return Flag with | valuesEnd => flagNo | valuesItem (h : Value) (t : Values) => (case h as s2 in Value return Flag with | valueNull => splitHit j t | valueFlag (f : Flag) => splitHit j t | valueNat (c : Nat) => splitHit j t | valueText (u : Text) => splitHit j t | valueItems (i : Values) => splitHit j t | valueAttrs (n : Attrs) => (case (payIdent n) as s3 in Option return Flag with | none => splitHit j t | some (i : Identifier) => (case i as s4 in Identifier return Flag with | makeIdentifier (y : IdentifierSystem) (v : Text) (z : Option (Ref kindEvent)) => (case (identMatch j y v) as s5 in Flag return Flag with | flagYes => flagYes | flagNo => splitHit j t)))))
DEFINE_REC(identsDrop, : Values -> List Identifier -> List Identifier := fun (vs : Values) (l : List Identifier) => case l as s1 in List return List Identifier with | nil => nil | cons (j : Identifier) (r : List Identifier) => (case (splitHit j vs) as s2 in Flag return List Identifier with | flagYes => identsDrop vs r | flagNo => cons j (identsDrop vs r)))
DEFINE(identsUnsplit, : Attrs -> List Identifier -> List Identifier := fun (pl : Attrs) (l : List Identifier) => case (attrsText pl keySplitTo) as s1 in Option return List Identifier with | none => l | some (t : Text) => (case (attrsGet pl keyMoved) as s2 in Option return List Identifier with | none => l | some (v : Value) => (case v as s3 in Value return List Identifier with | valueNull => l | valueFlag (f : Flag) => l | valueNat (c : Nat) => l | valueText (u : Text) => l | valueItems (i : Values) => identsDrop i l | valueAttrs (n : Attrs) => l)))
DEFINE(partyIdents, : Text -> Body -> List Identifier -> List Identifier := fun (h : Text) (e : Body) (l : List Identifier) => case (bodyErased e) as s0 in Flag return List Identifier with | flagYes => nil | flagNo => (case (bodyEvent e) as s1 in Option return List Identifier with | none => l | some (ev : Event) => (case ev as s2 in Event return List Identifier with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (natSame (etNat ty) 10) as s3 in Flag return List Identifier with | flagYes => identsAdd pl (identsUnsplit pl l) | flagNo => (case (natSame (etNat ty) 11) as s4 in Flag return List Identifier with | flagNo => l | flagYes => (case (payIdent pl) as s5 in Option return List Identifier with | none => l | some (i : Identifier) => (case i as s6 in Identifier return List Identifier with | makeIdentifier (y : IdentifierSystem) (v : Text) (z : Option (Ref kindEvent)) => identsVer h y v l)))))))
DEFINE_REC(attrsPut, : Text -> Value -> Attrs -> Attrs := fun (k : Text) (v : Value) (l : Attrs) => case l as s1 in Attrs return Attrs with | attrsEnd => attrsField k v attrsEnd | attrsField (j : Text) (u : Value) (r : Attrs) => (case (textSame j k) as s2 in Flag return Attrs with | flagYes => attrsField k v r | flagNo => attrsField j u (attrsPut k v r)))
DEFINE_REC(attrsMerge, : Attrs -> Attrs -> Attrs := fun (n : Attrs) (l : Attrs) => case n as s1 in Attrs return Attrs with | attrsEnd => l | attrsField (k : Text) (v : Value) (r : Attrs) => attrsMerge r (attrsPut k v l))
DEFINE(partyAttrs, : Body -> Attrs -> Attrs := fun (e : Body) (l : Attrs) => case (bodyErased e) as s0 in Flag return Attrs with | flagYes => attrsEnd | flagNo => (case (bodyEvent e) as s1 in Option return Attrs with | none => l | some (ev : Event) => (case ev as s2 in Event return Attrs with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (natSame (etNat ty) 10) as s3 in Flag return Attrs with | flagNo => l | flagYes => (case (attrsGet pl keyAttrs) as s4 in Option return Attrs with | none => l | some (v : Value) => (case v as s5 in Value return Attrs with | valueNull => l | valueFlag (f : Flag) => l | valueNat (c : Nat) => l | valueText (t : Text) => l | valueItems (i : Values) => l | valueAttrs (n : Attrs) => attrsMerge n l))))))
DEFINE_REC(movedItems, : List Identifier -> Values := fun (l : List Identifier) => case l as s1 in List return Values with | nil => valuesEnd | cons (i : Identifier) (r : List Identifier) => valuesItem (valueAttrs (identBody i)) (movedItems r))
DEFINE_REC(identsHeld, : List Identifier -> List Identifier -> Flag := fun (l : List Identifier) (w : List Identifier) => case w as s1 in List return Flag with | nil => flagYes | cons (i : Identifier) (r : List Identifier) => (case i as s2 in Identifier return Flag with | makeIdentifier (y : IdentifierSystem) (v : Text) (z : Option (Ref kindEvent)) => flagAnd (identIn l y v) (identsHeld l r)))
DEFINE(splitNext, : (Entry -> Text) -> Actor -> Ref kindParty -> List Identifier -> Entry -> List Entry := fun (hs : Entry -> Text) (a : Actor) (p : Ref kindParty) (w : List Identifier) (e : Entry) => cons e (cons (makeEntry (some (hashOf (hs e))) a (partyEvent p eventFieldsChanged none none (attrsField keySplitTo (valueText (hs e)) (attrsField keyMoved (valueItems (movedItems w)) attrsEnd)))) nil))
DEFINE(writeSplit, : (Entry -> Text) -> Log -> Actor -> Option Hash -> List Record -> Ref kindParty -> List Identifier -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (rs : List Record) (p : Ref kindParty) (w : List Identifier) => case (recParty rs (refText kindParty p)) as s1 in Option return Step with | none => makeStep lg (outcomeDenied none (cons (missingField keyParty) nil)) | some (m : Party) => (case m as s2 in Party return Step with | makeParty (x0 : KindParty) (x1 : Text) (x2 : Option Text) (x3 : List Identifier) (x4 : Attrs) (x5 : Option (Ref kindEvent)) (x6 : Option (Ref kindEvent)) => (case (identsHeld x3 w) as s3 in Flag return Step with | flagNo => makeStep lg (outcomeDenied none (cons (missingField keyMoved) nil)) | flagYes => writeAllowM hs lg a x (createsParty (makeParty x0 x1 none w attrsEnd none none)) (splitNext hs a p w) (askFields rs (actorText a) permissionWrite none (cons (some (subjectParty p)) nil)))))
DEFINE(keyKeep, : Text := textByte 107 (textByte 101 (textByte 101 (textByte 112 textEnd))))
DEFINE(keyDrop, : Text := textByte 100 (textByte 114 (textByte 111 (textByte 112 textEnd))))
