/* M7 part C (delta MC-4, program.c projection_ended): an eventEnded sets
   endedBy to the event, and a later End sets the later event. */
DEFINE(endedAfter, : Text -> Body -> Option (Ref kindEvent) -> Option (Ref kindEvent) := fun (h : Text) (e : Body) (d : Option (Ref kindEvent)) => case (bodyEvent e) as s1 in Option return Option (Ref kindEvent) with | none => d | some (ev : Event) => (case ev as s2 in Event return Option (Ref kindEvent) with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (natSame (etNat ty) 12) as s3 in Flag return Option (Ref kindEvent) with | flagYes => some (eventRef h) | flagNo => d)))
DEFINE(writeMerge, : (Entry -> Text) -> Log -> Actor -> Option Hash -> List Record -> Ref kindParty -> Ref kindParty -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (rs : List Record) (k : Ref kindParty) (d : Ref kindParty) => case (recParty rs (refText kindParty k)) as s1 in Option return Step with | none => makeStep lg (outcomeDenied none (cons (missingField keyKeep) nil)) | some (m : Party) => (case (recParty rs (refText kindParty d)) as s2 in Option return Step with | none => makeStep lg (outcomeDenied none (cons (missingField keyDrop) nil)) | some (n : Party) => writeAllow hs lg a x (partyEvent d eventDeleted none none (attrsField keyMergedInto (valueText (refText kindParty k)) attrsEnd)) (askFields rs (actorText a) permissionWrite none (cons (some (subjectParty k)) (cons (some (subjectParty d)) nil)))))
DEFINE(writeGo, : (Entry -> Text) -> Log -> Actor -> Option Hash -> List Record -> Command -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (rs : List Record) (c : Command) => case c as s1 in Command return Step with | commandResolveParty (k : KindParty) (n : Text) (ids : List Identifier) => (case (partyFind rs ids) as s0 in Option return Step with | none => writeAllow hs lg a x (createsParty (makeParty k n none ids attrsEnd none none)) (askWalk rs (actorText a) permissionWrite (cons none nil)) | some (h : Text) => writeFound hs lg x h (askWalk rs (actorText a) permissionWrite (cons none nil))) | commandMergeParties (k : Ref kindParty) (d : Ref kindParty) => writeMerge hs lg a x rs k d | commandSplitParty (p : Ref kindParty) (m : List Identifier) => writeSplit hs lg a x rs p m | commandAddIdentifier (p : Ref kindParty) (i : Identifier) => writeParty hs lg a x rs p none (partyEvent p eventFieldsChanged none none (identBody i)) | commandVerifyIdentifier (p : Ref kindParty) (y : IdentifierSystem) (v : Text) => writeVerify hs lg a x rs p y v | commandEnrichParty (p : Ref kindParty) (n : Attrs) (v : Provenance) => writeParty hs lg a x rs p (some (keysOf n)) (enrichBody p n v) | commandDeleteParty (p : Ref kindParty) => writeParty hs lg a x rs p none (partyEvent p eventDeleted none none attrsEnd) | commandRestoreParty (p : Ref kindParty) => writeParty hs lg a x rs p none (partyEvent p eventFieldsChanged none none (attrsField keyRestored (valueFlag flagYes) attrsEnd)) | commandEraseParty (p : Ref kindParty) => writeParty hs lg a x rs p none (partyEvent p eventDeleted none none (attrsField keyErased (valueFlag flagYes) attrsEnd)) | commandStartMembership (m : Membership) => writeAllow hs lg a x (createsMembership m) (askWalk rs (actorText a) permissionWrite (cons (some (case m as s2 in Membership return Subject with | makeMembership (y0 : Ref kindParty) (y1 : Ref kindParty) (y2 : Option Text) (y3 : Flag) (y4 : Option (Ref kindEvent)) (y5 : Provenance) (y6 : Attrs) => subjectParty y1)) nil)) | commandEndMembership (m : Ref kindMembership) => writeMembership hs lg a x rs m (endedBody m) | commandSetPrimary (m : Ref kindMembership) => writeMembership hs lg a x rs m (primaryBody m) | commandOpenCommercial (m : Commercial) => writeAllow hs lg a x (createsCommercial m) (askWalk rs (actorText a) permissionWrite (cons (some (case m as s3 in Commercial return Subject with | makeCommercial (y0 : KindCommercial) (y1 : Text) (y2 : Ref kindParty) (y3 : Text) (y4 : Option Nat) (y5 : Text) (y6 : Option Text) (y7 : CommercialStatus) (y8 : Attrs) (y9 : Option (Ref kindEvent)) => subjectParty y2)) nil)) | commandTransition (m : Ref kindCommercial) (t : Text) => writeMove hs lg a x rs m t | commandChangeAmount (m : Ref kindCommercial) (t : Option Nat) => writeAmount hs lg a x rs m t | commandSetStatus (m : Ref kindCommercial) (t : CommercialStatus) => writeStatus hs lg a x rs m t | commandPropose (m : Commitment) => writeAllow hs lg a x (createsCommitment m) (askWalk rs (actorText a) permissionWrite (cons (some (case m as s4 in Commitment return Subject with | makeCommitment (y0 : Ref kindCommercial) (y1 : CommitmentKind) (y2 : Text) (y3 : Value) (y4 : Option Text) (y5 : CommitmentStatus) (y6 : Option (Ref kindCommitment)) (y7 : Provenance) => subjectCommercial y0)) nil)) | commandAgree (m : Ref kindCommitment) => writeAgree hs lg a x rs m | commandIngest (m : Artifact) => writeAllow hs lg a x (createsArtifact m) (askWalk rs (actorText a) permissionWrite (case m as s5 in Artifact return List (Option Subject) with | makeArtifact (y0 : ArtifactKind) (y1 : Text) (y2 : Text) (y3 : Text) (y4 : List Account) (y5 : Attrs) => acctSubjs y4)) | commandExtract (m : Ref kindArtifact) (f : List Body) => makeStep lg (outcomeDenied none nil) | commandRecord (m : Event) => writeAllow hs lg a x (createsEvent m) (askWalk rs (actorText a) permissionWrite (cons (some (case m as s6 in Event return Subject with | makeEvent (y0 : EventType) (y1 : Subject) (y2 : Option (Ref kindArtifact)) (y3 : Option (Ref kindEvent)) (y4 : Attrs) (y5 : Option (Ref kindPolicy)) => y1)) nil)) | commandAssign (m : Assignment) => writeAllow hs lg a x (createsAssignment m) (askWalk rs (actorText a) permissionAssign (cons (some (case m as s7 in Assignment return Subject with | makeAssignment (y0 : Account) (y1 : Ref kindParty) (y2 : AssignmentRole) (y3 : Option Text) (y4 : Option (Ref kindEvent)) (y5 : Provenance) => acctSubj y0)) nil)) | commandReassign (m : Ref kindAssignment) (p : Ref kindParty) => makeStep lg (outcomeDenied none nil) | commandEndAssignment (m : Ref kindAssignment) => makeStep lg (outcomeDenied none nil) | commandBulkReassign (a : Ref kindParty) (d : Ref kindParty) => makeStep lg (outcomeDenied none nil) | commandRouteTerritory (a : Account) (t : Text) => makeStep lg (outcomeDenied none nil) | commandRequestApproval (m : Ref kindCommercial) (t : Text) => makeStep lg (outcomeDenied none nil) | commandGrantApproval (m : Ref kindEvent) => makeStep lg (outcomeDenied none nil))
DEFINE(writeWith, : (Text -> Body -> Body -> Body) -> (Entry -> Text) -> Log -> Write -> Step := fun (upd : Text -> Body -> Body -> Body) (hs : Entry -> Text) (lg : Log) (w : Write) => case w as s1 in Write return Step with | makeWrite (a : Actor) (x : Option Hash) (c : Command) => writeGo hs lg a x (recordsLog lg hs upd nil) c)
DEFINE(evAction, : EventType -> Permission := fun (t : EventType) => case (natSame (etNat t) 0) as s1 in Flag return Permission with | flagYes => permissionTransition | flagNo => (case (natSame (etNat t) 2) as s2 in Flag return Permission with | flagYes => permissionAssign | flagNo => permissionWrite))
DEFINE(polName, : Policy -> Text := fun (m : Policy) => case m as s1 in Policy return Text with | makePolicy (z0 : Text) (z1 : PolicyScope) (z2 : Option Text) (z3 : Option Text) (z4 : Requirement) (z5 : List AclRule) (z6 : Flag) => z0)
DEFINE(polAllows, : List Record -> Policy -> Text -> Permission -> Subject -> Flag := fun (rs : List Record) (m : Policy) (p : Text) (a : Permission) (s : Subject) => case m as s1 in Policy return Flag with | makePolicy (z0 : Text) (z1 : PolicyScope) (z2 : Option Text) (z3 : Option Text) (z4 : Requirement) (z5 : List AclRule) (z6 : Flag) => flagAnd z6 (flagAnd (scopeApplies rs z1 s) (rulesAllow z5 p a none)))
DEFINE_REC(simAllow, : List Record -> List Record -> Policy -> Text -> Permission -> Subject -> Flag := fun (l : List Record) (rs : List Record) (g : Policy) (p : Text) (a : Permission) (s : Subject) => case l as s1 in List return Flag with | nil => polAllows rs g p a s | cons (x : Record) (r : List Record) => (case x as s2 in Record return Flag with | makeRecord (h : Text) (b : Body) => (case (bodyPolicy b) as s3 in Option return Flag with | none => simAllow r rs g p a s | some (m : Policy) => flagOr (flagAnd (flagNot (textSame (polName m) (polName g))) (polAllows rs m p a s)) (simAllow r rs g p a s))))
DEFINE_REC(simWalk, : List Entry -> List Text -> List Record -> Policy -> List (Ref kindEvent) := fun (l : List Entry) (ks : List Text) (rs : List Record) (g : Policy) => case l as s1 in List return List (Ref kindEvent) with | nil => nil | cons (e : Entry) (r : List Entry) => (case ks as s2 in List return List (Ref kindEvent) with | nil => nil | cons (k : Text) (kr : List Text) => (case e as s3 in Entry return List (Ref kindEvent) with | makeEntry (p : Option Hash) (ac : Actor) (b : Body) => (case (bodyEvent b) as s4 in Option return List (Ref kindEvent) with | none => simWalk r kr rs g | some (m : Event) => (case m as s5 in Event return List (Ref kindEvent) with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (flagAnd (optSome (Ref kindPolicy) po) (case (natSame (etNat ty) 9) as s6 in Flag return Flag with | flagYes => simAllow rs rs g (actorText ac) (evAction ty) sj | flagNo => flagNot (simAllow rs rs g (actorText ac) (evAction ty) sj))) as s7 in Flag return List (Ref kindEvent) with | flagNo => simWalk r kr rs g | flagYes => cons (eventRef k) (simWalk r kr rs g)))))))
DEFINE(readWithH, : (Text -> Body -> Body -> Body) -> List Text -> (0 answer : Type 0) -> Log -> Query answer -> answer := fun (upd : Text -> Body -> Body -> Body) (hs : List Text) (0 answer : Type 0) (lg : Log) (q : Query answer) => case q as s1 in Query a return a with | queryMembersOf (x1 : Ref kindParty) (x2 : Moment) => asOfThen (List (Ref kindMembership)) nil (fun (rs : List Record) => membersWalk rs (refText kindParty x1)) (readAsOfH upd hs lg x2) | queryEmployer (x1 : Ref kindParty) (x2 : Moment) => asOfThen (Option (Ref kindParty)) none (fun (rs : List Record) => employerRead rs (refText kindParty x1)) (readAsOfH upd hs lg x2) | queryJobChanges (x1 : Moment) => changesRead (recordsLogH lg hs upd nil) x1 | queryCommercial (x1 : Ref kindCommercial) (x2 : Moment) => asOfThen (Option Commercial) none (fun (rs : List Record) => recCommercial rs (refText kindCommercial x1)) (readAsOfH upd hs lg x2) | queryProjectionSound (x1 : Ref kindCommercial) (x2 : Commercial) => soundRead (recordsLogH lg hs upd nil) (refText kindCommercial x1) x2 | queryTermsInForce (x1 : Ref kindCommercial) (x2 : Moment) => asOfThen (List (Ref kindCommitment)) nil (fun (rs : List Record) => termsWalk rs rs (refText kindCommercial x1)) (readAsOfH upd hs lg x2) | queryTermHistory (x1 : Ref kindCommitment) => termRead (recordsLogH lg hs upd nil) (refText kindCommitment x1) | queryAmountReconciled (x1 : Ref kindCommercial) => reconRead (recordsLogH lg hs upd nil) (refText kindCommercial x1) | queryDiscountPct (x1 : Ref kindCommercial) => discRead (recordsLogH lg hs upd nil) x1 | queryEvidence (x1 : Hash) => evidenceRead (recordsLogH lg hs upd nil) x1 | queryArtifactIntact (x1 : Ref kindArtifact) (x2 : Text) => intactRead (recordsLogH lg hs upd nil) x1 x2 | queryTimeline (x1 : Subject) (x2 : Moment) => asOfThen (List (Ref kindEvent)) nil (fun (rs : List Record) => timelineRead rs x1) (readAsOfH upd hs lg x2) | queryThread (x1 : Ref kindEvent) => threadRead (recordsLogH lg hs upd nil) x1 | queryReplay (x1 : Moment) => readReplayH hs lg x1 | queryTail (x1 : Moment) => readTailH hs lg x1 | queryAuditByActor (x1 : Actor) => auditWalkH lg hs x1 | queryAuditByPolicy (x1 : Ref kindPolicy) => auditPolicyRead (recordsLogH lg hs upd nil) x1 | queryOwner (x1 : Account) (x2 : Moment) => asOfThen (Option (Ref kindParty)) none (fun (rs : List Record) => ownerRead rs x1) (readAsOfH upd hs lg x2) | queryBook (x1 : Ref kindParty) (x2 : Moment) => asOfThen (List Account) nil (fun (rs : List Record) => bookRead rs x1) (readAsOfH upd hs lg x2) | queryCan (x1 : Text) (x2 : Permission) (x3 : Subject) (x4 : Option (List Text)) => canRead (recordsLogH lg hs upd nil) x1 x2 x3 x4 | queryDryRun (x1 : Ref kindCommercial) (x2 : Text) => dryRead (recordsLogH lg hs upd nil) x1 x2 | queryRedacted (x1 : Text) (x2 : Subject) => redactRead (recordsLogH lg hs upd nil) x1 x2 | querySimulatePolicy (x1 : Policy) => simWalk lg hs (recordsLogH lg hs upd nil) x1 | queryPipeline (x1 : PipelineKey) (x2 : Moment) => asOfThen (List Bucket) nil (fun (rs : List Record) => pipeRead x1 rs) (readAsOfH upd hs lg x2) | queryStageStats => stageRead (recordsLogH lg hs recordsKeep nil) | queryStaleDeals (x1 : Nat) => staleRead (recordsLogH lg hs upd nil) x1 | queryRenewals => renewRead (recordsLogH lg hs upd nil) | queryAccount360 (x1 : Ref kindParty) (x2 : Moment) => asOfThen Account360 acctDummy (fun (rs : List Record) => acctRead rs (refText kindParty x1)) (readAsOfH upd hs lg x2) | queryReviewQueue (x1 : Nat) => reviewWalk (recordsLogH lg hs upd nil) x1)
