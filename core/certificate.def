DEFINE(writeAmount, : (Entry -> Text) -> Log -> Actor -> Option Hash -> List Record -> Ref kindCommercial -> Option Nat -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (rs : List Record) (m : Ref kindCommercial) (t : Option Nat) => case (recCommercial rs (refText kindCommercial m)) as s1 in Option return Step with | none => makeStep lg (outcomeDenied none (cons (missingField commercialKey) nil)) | some (n : Commercial) => writeAllowBy hs lg a x (amountBody m (case n as s2 in Commercial return Option Nat with | makeCommercial (y0 : KindCommercial) (y1 : Text) (y2 : Ref kindParty) (y3 : Text) (y4 : Option Nat) (y5 : Text) (y6 : Option Text) (y7 : CommercialStatus) (y8 : Attrs) (y9 : Option (Ref kindEvent)) => y4) t) (askFields rs (actorText a) permissionWrite (some (cons amountKey nil)) (cons (some (subjectCommercial m)) nil)))
DEFINE(writeStatus, : (Entry -> Text) -> Log -> Actor -> Option Hash -> List Record -> Ref kindCommercial -> CommercialStatus -> Step := fun (hs : Entry -> Text) (lg : Log) (a : Actor) (x : Option Hash) (rs : List Record) (m : Ref kindCommercial) (t : CommercialStatus) => case (recCommercial rs (refText kindCommercial m)) as s1 in Option return Step with | none => makeStep lg (outcomeDenied none (cons (missingField commercialKey) nil)) | some (n : Commercial) => writeAllowBy hs lg a x (statusBody m t) (askFields rs (actorText a) permissionWrite (some (cons statusKey nil)) (cons (some (subjectCommercial m)) nil)))
