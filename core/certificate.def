/* The fixed rows of the certificate module (M5 delta C-1, D4), in the row
   forms of compiler/certificate.c. The rows through mechRefl (the first
   DEFINE) are the copy of mechanism-lang prelude/init.mech lines 72 to 78.
   They come before the core rows. The other rows come after the core rows:
   the digits defs, the base encoders, the Value group and the encoders of
   Values, Attrs, Option and List. Each encoder puts the JSON bytes of its
   value in front of the tail. A row is one line, with no comma and no string
   literal. */

/* Equality keeps its endpoints erased and carries no constructor field. */
CARRIER(MechEq, (0 A : Type 0) (0 x : A) : (0 y : A) -> Prop)
  CONSTRUCTOR(mechReflCtor, MechEq A x x)
DEFINE(mechRefl, : (0 A : Type 0) -> (0 x : A) -> MechEq A x x := fun (0 A : Type 0) (0 x : A) => mechReflCtor)

/* The decimal digits of a Nat below 10^10. */
DEFINE(tenPowers, : List Nat := cons 1000000000 (cons 100000000 (cons 10000000 (cons 1000000 (cons 100000 (cons 10000 (cons 1000 (cons 100 (cons 10 nil)))))))))
DEFINE(digitAt, : Nat -> Nat -> Nat := fun (n : Nat) (p : Nat) => (case (natLt n (natMul 1 p)) as s1 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 2 p)) as s2 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 3 p)) as s3 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 4 p)) as s4 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 5 p)) as s5 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 6 p)) as s6 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 7 p)) as s7 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 8 p)) as s8 return Nat with | 0 (no : prod ()) => (case (natLt n (natMul 9 p)) as s9 return Nat with | 0 (no : prod ()) => 9 | 1 (yes : prod ()) => 8) | 1 (yes : prod ()) => 7) | 1 (yes : prod ()) => 6) | 1 (yes : prod ()) => 5) | 1 (yes : prod ()) => 4) | 1 (yes : prod ()) => 3) | 1 (yes : prod ()) => 2) | 1 (yes : prod ()) => 1) | 1 (yes : prod ()) => 0))
DEFINE_REC(digitTail, : List Nat -> Nat -> Text := fun (ps : List Nat) (n : Nat) => case ps as self in List return Text with | nil => textByte (natAdd 48 n) textEnd | cons (p : Nat) (rest : List Nat) => textByte (natAdd 48 (digitAt n p)) (digitTail rest (natSub n (natMul (digitAt n p) p))))
DEFINE_REC(digitLead, : List Nat -> Nat -> Text := fun (ps : List Nat) (n : Nat) => case ps as self in List return Text with | nil => textByte (natAdd 48 n) textEnd | cons (p : Nat) (rest : List Nat) => (case (natLt n p) as small return Text with | 0 (no : prod ()) => digitTail ps n | 1 (yes : prod ()) => digitLead rest n))
DEFINE(digits, : Nat -> Text := fun (n : Nat) => digitLead tenPowers n)

/* The base encoders. */
DEFINE_REC(textThen, : Text -> Text -> Text := fun (s : Text) (tail : Text) => case s as self in Text return Text with | textEnd => tail | textByte (b : Nat) (rest : Text) => textByte b (textThen rest tail))
DEFINE(hexLow, : Nat -> Nat := fun (d : Nat) => (case (natLt d 10) as s1 return Nat with | 0 (no : prod ()) => natAdd 87 d | 1 (yes : prod ()) => natAdd 48 d))
DEFINE(escapeLow, : Nat -> Text -> Text := fun (b : Nat) (tail : Text) => textByte 92 (textByte 117 (textByte 48 (textByte 48 (case (natLt b 16) as s1 return Text with | 0 (no : prod ()) => textByte 49 (textByte (hexLow (natSub b 16)) tail) | 1 (yes : prod ()) => textByte 48 (textByte (hexLow b) tail))))))
DEFINE(escapeByte, : Nat -> Text -> Text := fun (b : Nat) (tail : Text) => (case (natLt b 32) as s1 return Text with | 0 (no : prod ()) => (case (natEq b 34) as s2 return Text with | 0 (no : prod ()) => (case (natEq b 92) as s3 return Text with | 0 (no : prod ()) => textByte b tail | 1 (yes : prod ()) => textByte 92 (textByte 92 tail)) | 1 (yes : prod ()) => textByte 92 (textByte 34 tail)) | 1 (yes : prod ()) => escapeLow b tail))
DEFINE_REC(escapeThen, : Text -> Text -> Text := fun (s : Text) (tail : Text) => case s as self in Text return Text with | textEnd => textByte 34 tail | textByte (b : Nat) (rest : Text) => escapeByte b (escapeThen rest tail))
DEFINE(encodeText, : Text -> Text -> Text := fun (s : Text) (tail : Text) => textByte 34 (escapeThen s tail))
DEFINE(encodeNat, : Nat -> Text -> Text := fun (n : Nat) (tail : Text) => textThen (digits n) tail)
DEFINE(encodeFlag, : Flag -> Text -> Text := fun (b : Flag) (tail : Text) => case b as self in Flag return Text with | flagNo => textByte 102 (textByte 97 (textByte 108 (textByte 115 (textByte 101 tail)))) | flagYes => textByte 116 (textByte 114 (textByte 117 (textByte 101 tail))))
DEFINE(encodeHash, : Hash -> Text -> Text := fun (h : Hash) (tail : Text) => case h as self in Hash return Text with | hashOf (d : Text) => encodeText d tail)

/* The Value group: one mutual def rec group. */
DEFINE_REC(encodeValue, : Value -> Text -> Text := fun (v : Value) (tail : Text) => case v as sv in Value return Text with | valueNull => textByte 110 (textByte 117 (textByte 108 (textByte 108 tail))) | valueFlag (b : Flag) => encodeFlag b tail | valueNat (n : Nat) => encodeNat n tail | valueText (s : Text) => encodeText s tail | valueItems (vs : Values) => textByte 91 (encodeFirst vs tail) | valueAttrs (a : Attrs) => textByte 123 (encodeKeys a tail))
DEFINE_AND(encodeFirst, : Values -> Text -> Text := fun (vs : Values) (tail : Text) => case vs as s1 in Values return Text with | valuesEnd => textByte 93 tail | valuesItem (h : Value) (t : Values) => encodeValue h (encodeRest t tail))
DEFINE_AND(encodeRest, : Values -> Text -> Text := fun (vs : Values) (tail : Text) => case vs as s2 in Values return Text with | valuesEnd => textByte 93 tail | valuesItem (h : Value) (t : Values) => textByte 44 (encodeValue h (encodeRest t tail)))
DEFINE_AND(encodeKeys, : Attrs -> Text -> Text := fun (a : Attrs) (tail : Text) => case a as s3 in Attrs return Text with | attrsEnd => textByte 125 tail | attrsField (k : Text) (v : Value) (r : Attrs) => encodeText k (textByte 58 (encodeValue v (encodeMore r tail))))
DEFINE_AND(encodeMore, : Attrs -> Text -> Text := fun (a : Attrs) (tail : Text) => case a as s4 in Attrs return Text with | attrsEnd => textByte 125 tail | attrsField (k : Text) (v : Value) (r : Attrs) => textByte 44 (encodeText k (textByte 58 (encodeValue v (encodeMore r tail)))))

/* Values, Attrs, Option and List. The binder of the payload encoder is put.
   encodeOptionSome gives {"some":v} for a payload type that encodes null. */
DEFINE(encodeValues, : Values -> Text -> Text := fun (vs : Values) (tail : Text) => textByte 91 (encodeFirst vs tail))
DEFINE(encodeAttrs, : Attrs -> Text -> Text := fun (a : Attrs) (tail : Text) => textByte 123 (encodeKeys a tail))
DEFINE(encodeOptionBare, : (0 A : Type 0) -> (A -> Text -> Text) -> Option A -> Text -> Text := fun (0 A : Type 0) (put : A -> Text -> Text) (o : Option A) (tail : Text) => case o as self in Option return Text with | none => (textByte 110 (textByte 117 (textByte 108 (textByte 108 tail)))) | some (v : A) => put v tail)
DEFINE(encodeOptionSome, : (0 A : Type 0) -> (A -> Text -> Text) -> Option A -> Text -> Text := fun (0 A : Type 0) (put : A -> Text -> Text) (o : Option A) (tail : Text) => case o as self in Option return Text with | none => (textByte 110 (textByte 117 (textByte 108 (textByte 108 tail)))) | some (v : A) => (textByte 123 (textByte 34 (textByte 115 (textByte 111 (textByte 109 (textByte 101 (textByte 34 (textByte 58 (put v (textByte 125 tail)))))))))))
DEFINE_REC(encodeListRest, : (0 A : Type 0) -> (A -> Text -> Text) -> List A -> Text -> Text := fun (0 A : Type 0) (put : A -> Text -> Text) (l : List A) (tail : Text) => case l as self in List return Text with | nil => textByte 93 tail | cons (h : A) (t : List A) => textByte 44 (put h (encodeListRest A put t tail)))
DEFINE(encodeList, : (0 A : Type 0) -> (A -> Text -> Text) -> List A -> Text -> Text := fun (0 A : Type 0) (put : A -> Text -> Text) (l : List A) (tail : Text) => textByte 91 (case l as self in List return Text with | nil => textByte 93 tail | cons (h : A) (t : List A) => put h (encodeListRest A put t tail)))

/* SHA-256 (FIPS 180-4), the same steps as compiler/sha256.c. A word is a
   List Nat of 32 bits, the most significant bit first. shaKg0 to shaKg7 hold
   the 64 round constants in order, 8 in each row, and shaK is the chain of
   them. sha256Hex puts the 64 lowercase hex digits of the digest in front of
   the tail. */
DEFINE(shaC0, : List Nat := nil)
DEFINE(shaC1, : List Nat := (cons 0 nil))
DEFINE(shaC3, : List Nat := (cons 0 (cons 0 (cons 0 nil))))
DEFINE(shaC7, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))
DEFINE(shaC9, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))
DEFINE(shaC10, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))
DEFINE(shaC13, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))
DEFINE(shaC14, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))
DEFINE(shaC15, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))))
DEFINE(shaC19, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))))))))
DEFINE(shaC21, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))))))))))
DEFINE(shaC22, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))))))))))
DEFINE(shaC25, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))))))))))))))
DEFINE(shaC26, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))))))))))))))
DEFINE(shaC29, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil))))))))))))))))))))))))))))))
DEFINE(shaC30, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))))))))))))))))))
DEFINE(shaC32, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))))))))))))))))))))
DEFINE(shaC48, : List Nat := (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 nil)))))))))))))))))))))))))))))))))))))))))))))))))
DEFINE(shaPow35, : List Nat := (cons 17179869184 (cons 8589934592 (cons 4294967296 (cons 2147483648 (cons 1073741824 (cons 536870912 (cons 268435456 (cons 134217728 (cons 67108864 (cons 33554432 (cons 16777216 (cons 8388608 (cons 4194304 (cons 2097152 (cons 1048576 (cons 524288 (cons 262144 (cons 131072 (cons 65536 (cons 32768 (cons 16384 (cons 8192 (cons 4096 (cons 2048 (cons 1024 (cons 512 (cons 256 (cons 128 (cons 64 (cons 32 (cons 16 (cons 8 (cons 4 (cons 2 (cons 1 nil))))))))))))))))))))))))))))))))))))
DEFINE(shaPow32, : List Nat := (cons 2147483648 (cons 1073741824 (cons 536870912 (cons 268435456 (cons 134217728 (cons 67108864 (cons 33554432 (cons 16777216 (cons 8388608 (cons 4194304 (cons 2097152 (cons 1048576 (cons 524288 (cons 262144 (cons 131072 (cons 65536 (cons 32768 (cons 16384 (cons 8192 (cons 4096 (cons 2048 (cons 1024 (cons 512 (cons 256 (cons 128 (cons 64 (cons 32 (cons 16 (cons 8 (cons 4 (cons 2 (cons 1 nil)))))))))))))))))))))))))))))))))
DEFINE(shaIdx, : List Nat := (cons 0 (cons 1 (cons 2 (cons 3 (cons 4 (cons 5 (cons 6 (cons 7 (cons 8 (cons 9 (cons 10 (cons 11 (cons 12 (cons 13 (cons 14 (cons 15 (cons 16 (cons 17 (cons 18 (cons 19 (cons 20 (cons 21 (cons 22 (cons 23 (cons 24 (cons 25 (cons 26 (cons 27 (cons 28 (cons 29 (cons 30 (cons 31 (cons 32 (cons 33 (cons 34 (cons 35 (cons 36 (cons 37 (cons 38 (cons 39 (cons 40 (cons 41 (cons 42 (cons 43 (cons 44 (cons 45 (cons 46 (cons 47 (cons 48 (cons 49 (cons 50 (cons 51 (cons 52 (cons 53 (cons 54 (cons 55 (cons 56 (cons 57 (cons 58 (cons 59 (cons 60 (cons 61 (cons 62 (cons 63 nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
DEFINE(shaKg0, : List Nat := (cons 1116352408 (cons 1899447441 (cons 3049323471 (cons 3921009573 (cons 961987163 (cons 1508970993 (cons 2453635748 (cons 2870763221 nil)))))))))
DEFINE(shaKg1, : List Nat := (cons 3624381080 (cons 310598401 (cons 607225278 (cons 1426881987 (cons 1925078388 (cons 2162078206 (cons 2614888103 (cons 3248222580 nil)))))))))
DEFINE(shaKg2, : List Nat := (cons 3835390401 (cons 4022224774 (cons 264347078 (cons 604807628 (cons 770255983 (cons 1249150122 (cons 1555081692 (cons 1996064986 nil)))))))))
DEFINE(shaKg3, : List Nat := (cons 2554220882 (cons 2821834349 (cons 2952996808 (cons 3210313671 (cons 3336571891 (cons 3584528711 (cons 113926993 (cons 338241895 nil)))))))))
DEFINE(shaKg4, : List Nat := (cons 666307205 (cons 773529912 (cons 1294757372 (cons 1396182291 (cons 1695183700 (cons 1986661051 (cons 2177026350 (cons 2456956037 nil)))))))))
DEFINE(shaKg5, : List Nat := (cons 2730485921 (cons 2820302411 (cons 3259730800 (cons 3345764771 (cons 3516065817 (cons 3600352804 (cons 4094571909 (cons 275423344 nil)))))))))
DEFINE(shaKg6, : List Nat := (cons 430227734 (cons 506948616 (cons 659060556 (cons 883997877 (cons 958139571 (cons 1322822218 (cons 1537002063 (cons 1747873779 nil)))))))))
DEFINE(shaKg7, : List Nat := (cons 1955562222 (cons 2024104815 (cons 2227730452 (cons 2361852424 (cons 2428436474 (cons 2756734187 (cons 3204031479 (cons 3329325298 nil)))))))))
DEFINE(shaMaj, : Nat -> Nat -> Nat -> Nat := fun (a : Nat) (b : Nat) (c : Nat) => (case (natLt 1 (natAdd a (natAdd b c))) as s1 return Nat with | 0 (no : prod ()) => 0 | 1 (yes : prod ()) => 1))
DEFINE(shaXor3, : Nat -> Nat -> Nat -> Nat := fun (a : Nat) (b : Nat) (c : Nat) => natSub (natAdd a (natAdd b c)) (natMul 2 (shaMaj a b c)))
DEFINE(shaCh, : Nat -> Nat -> Nat -> Nat := fun (e : Nat) (f : Nat) (g : Nat) => natAdd (natMul e f) (natMul (natSub 1 e) g))
DEFINE_REC(shaZip3, : (Nat -> Nat -> Nat -> Nat) -> List Nat -> List Nat -> List Nat -> List Nat := fun (op : Nat -> Nat -> Nat -> Nat) (x : List Nat) (y : List Nat) (z : List Nat) => case x as s1 in List return List Nat with | nil => nil | cons (a : Nat) (xr : List Nat) => (case y as s2 in List return List Nat with | nil => nil | cons (b : Nat) (yr : List Nat) => (case z as s3 in List return List Nat with | nil => nil | cons (c : Nat) (zr : List Nat) => cons (op a b c) (shaZip3 op xr yr zr))))
DEFINE_REC(shaTake, : List Nat -> List Nat -> List Nat := fun (c : List Nat) (l : List Nat) => case c as s1 in List return List Nat with | nil => nil | cons (u : Nat) (cr : List Nat) => (case l as s2 in List return List Nat with | nil => nil | cons (b : Nat) (lr : List Nat) => cons b (shaTake cr lr)))
DEFINE_REC(shaDrop, : List Nat -> List Nat -> List Nat := fun (c : List Nat) (l : List Nat) => case c as s1 in List return List Nat with | nil => l | cons (u : Nat) (cr : List Nat) => (case l as s2 in List return List Nat with | nil => nil | cons (b : Nat) (lr : List Nat) => shaDrop cr lr))
DEFINE_REC(shaAppend, : List Nat -> List Nat -> List Nat := fun (x : List Nat) (y : List Nat) => case x as s1 in List return List Nat with | nil => y | cons (b : Nat) (xr : List Nat) => cons b (shaAppend xr y))
DEFINE(shaK, : List Nat := (shaAppend shaKg0 (shaAppend shaKg1 (shaAppend shaKg2 (shaAppend shaKg3 (shaAppend shaKg4 (shaAppend shaKg5 (shaAppend shaKg6 shaKg7))))))))
DEFINE(shaRotr, : List Nat -> List Nat -> List Nat := fun (c : List Nat) (x : List Nat) => shaAppend (shaDrop c x) (shaTake c x))
DEFINE_REC(shaValue, : List Nat -> Nat -> Nat := fun (l : List Nat) (acc : Nat) => case l as s1 in List return Nat with | nil => acc | cons (b : Nat) (r : List Nat) => shaValue r (natAdd (natMul 2 acc) b))
DEFINE_REC(shaBits, : List Nat -> Nat -> List Nat := fun (ps : List Nat) (n : Nat) => case ps as s1 in List return List Nat with | nil => nil | cons (p : Nat) (r : List Nat) => (case (natLt n p) as s2 return List Nat with | 0 (no : prod ()) => cons 1 (shaBits r (natSub n p)) | 1 (yes : prod ()) => cons 0 (shaBits r n)))
DEFINE(shaWord, : List Nat -> Nat := fun (x : List Nat) => shaValue x 0)
DEFINE(shaMod, : Nat -> List Nat := fun (n : Nat) => shaDrop shaC3 (shaBits shaPow35 n))
DEFINE(shaBigS0, : List Nat -> List Nat := fun (x : List Nat) => shaZip3 shaXor3 (shaRotr shaC30 x) (shaRotr shaC19 x) (shaRotr shaC10 x))
DEFINE(shaBigS1, : List Nat -> List Nat := fun (x : List Nat) => shaZip3 shaXor3 (shaRotr shaC26 x) (shaRotr shaC21 x) (shaRotr shaC7 x))
DEFINE(shaSmallS0, : List Nat -> List Nat := fun (x : List Nat) => shaZip3 shaXor3 (shaRotr shaC25 x) (shaRotr shaC14 x) (shaAppend shaC3 (shaTake shaC29 x)))
DEFINE(shaSmallS1, : List Nat -> List Nat := fun (x : List Nat) => shaZip3 shaXor3 (shaRotr shaC15 x) (shaRotr shaC13 x) (shaAppend shaC10 (shaTake shaC22 x)))
DEFINE_REC(shaNth, : List Nat -> List (List Nat) -> List Nat := fun (c : List Nat) (l : List (List Nat)) => case c as s1 in List return List Nat with | nil => (case l as s2 in List return List Nat with | nil => nil | cons (x : List Nat) (lr : List (List Nat)) => x) | cons (u : Nat) (cr : List Nat) => (case l as s3 in List return List Nat with | nil => nil | cons (y : List Nat) (lr : List (List Nat)) => shaNth cr lr))
DEFINE_REC(shaSnoc, : List (List Nat) -> List Nat -> List (List Nat) := fun (l : List (List Nat)) (x : List Nat) => case l as s1 in List return List (List Nat) with | nil => cons x nil | cons (y : List Nat) (lr : List (List Nat)) => cons y (shaSnoc lr x))
DEFINE(shaNext, : List (List Nat) -> List Nat := fun (win : List (List Nat)) => shaMod (natAdd (shaWord (shaSmallS1 (shaNth shaC14 win))) (natAdd (shaWord (shaNth shaC9 win)) (natAdd (shaWord (shaSmallS0 (shaNth shaC1 win))) (shaWord (shaNth shaC0 win))))))
DEFINE_REC(shaSched, : List Nat -> List (List Nat) -> List (List Nat) := fun (c : List Nat) (win : List (List Nat)) => case c as s1 in List return List (List Nat) with | nil => win | cons (u : Nat) (cr : List Nat) => (case win as s2 in List return List (List Nat) with | nil => nil | cons (w0 : List Nat) (wr : List (List Nat)) => cons w0 (shaSched cr (shaSnoc wr (shaNext win)))))
DEFINE(shaRoundEnd, : Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List (List Nat) := fun (t1 : Nat) (a : List Nat) (b : List Nat) (c : List Nat) (d : List Nat) (e : List Nat) (f : List Nat) (g : List Nat) => cons (shaMod (natAdd t1 (natAdd (shaWord (shaBigS0 a)) (shaWord (shaZip3 shaMaj a b c))))) (cons a (cons b (cons c (cons (shaMod (natAdd (shaWord d) t1)) (cons e (cons f (cons g nil))))))))
DEFINE(shaRoundWith, : Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List Nat -> List (List Nat) := fun (k : Nat) (w : List Nat) (a : List Nat) (b : List Nat) (c : List Nat) (d : List Nat) (e : List Nat) (f : List Nat) (g : List Nat) (h : List Nat) => shaRoundEnd (natAdd (shaWord h) (natAdd (shaWord (shaBigS1 e)) (natAdd (shaWord (shaZip3 shaCh e f g)) (natAdd k (shaWord w))))) a b c d e f g)
DEFINE(shaRound, : Nat -> List Nat -> List (List Nat) -> List (List Nat) := fun (k : Nat) (w : List Nat) (st : List (List Nat)) => (case st as q1 in List return List (List Nat) with | nil => st | cons (a : List Nat) (r1 : List (List Nat)) => (case r1 as q2 in List return List (List Nat) with | nil => st | cons (b : List Nat) (r2 : List (List Nat)) => (case r2 as q3 in List return List (List Nat) with | nil => st | cons (c : List Nat) (r3 : List (List Nat)) => (case r3 as q4 in List return List (List Nat) with | nil => st | cons (d : List Nat) (r4 : List (List Nat)) => (case r4 as q5 in List return List (List Nat) with | nil => st | cons (e : List Nat) (r5 : List (List Nat)) => (case r5 as q6 in List return List (List Nat) with | nil => st | cons (f : List Nat) (r6 : List (List Nat)) => (case r6 as q7 in List return List (List Nat) with | nil => st | cons (g : List Nat) (r7 : List (List Nat)) => (case r7 as q8 in List return List (List Nat) with | nil => st | cons (h : List Nat) (r8 : List (List Nat)) => shaRoundWith k w a b c d e f g h)))))))))
DEFINE_REC(shaRounds, : List Nat -> List (List Nat) -> List (List Nat) -> List (List Nat) := fun (ks : List Nat) (ws : List (List Nat)) (st : List (List Nat)) => case ks as s1 in List return List (List Nat) with | nil => st | cons (k : Nat) (kr : List Nat) => (case ws as s2 in List return List (List Nat) with | nil => st | cons (w : List Nat) (wr : List (List Nat)) => shaRounds kr wr (shaRound k w st)))
DEFINE_REC(shaAddState, : List (List Nat) -> List (List Nat) -> List (List Nat) := fun (x : List (List Nat)) (y : List (List Nat)) => case x as s1 in List return List (List Nat) with | nil => nil | cons (a : List Nat) (xr : List (List Nat)) => (case y as s2 in List return List (List Nat) with | nil => nil | cons (b : List Nat) (yr : List (List Nat)) => cons (shaMod (natAdd (shaWord a) (shaWord b))) (shaAddState xr yr)))
DEFINE_REC(shaCompress, : List (List (List Nat)) -> List (List Nat) -> List (List Nat) := fun (bs : List (List (List Nat))) (st : List (List Nat)) => case bs as s1 in List return List (List Nat) with | nil => st | cons (b : List (List Nat)) (br : List (List (List Nat))) => shaCompress br (shaAddState st (shaRounds shaK (shaSched shaC48 b) st)))
DEFINE(shaH, : List (List Nat) := (cons (shaBits shaPow32 1779033703) (cons (shaBits shaPow32 3144134277) (cons (shaBits shaPow32 1013904242) (cons (shaBits shaPow32 2773480762) (cons (shaBits shaPow32 1359893119) (cons (shaBits shaPow32 2600822924) (cons (shaBits shaPow32 528734635) (cons (shaBits shaPow32 1541459225) nil)))))))))
DEFINE_REC(shaBytes, : Text -> List Nat -> List Nat := fun (s : Text) (tail : List Nat) => case s as s1 in Text return List Nat with | textEnd => tail | textByte (b : Nat) (r : Text) => cons b (shaBytes r tail))
DEFINE_REC(shaLen, : Text -> Nat -> Nat := fun (s : Text) (n : Nat) => case s as s1 in Text return Nat with | textEnd => n | textByte (b : Nat) (r : Text) => shaLen r (natAdd n 1))
DEFINE_REC(shaLenMod, : Text -> Nat -> Nat := fun (s : Text) (m : Nat) => case s as s1 in Text return Nat with | textEnd => m | textByte (b : Nat) (r : Text) => shaLenMod r (case (natEq m 63) as s2 return Nat with | 0 (no : prod ()) => natAdd m 1 | 1 (yes : prod ()) => 0))
DEFINE(shaPadCount, : Nat -> Nat := fun (r : Nat) => (case (natLt r 56) as s1 return Nat with | 0 (no : prod ()) => natSub 119 r | 1 (yes : prod ()) => natSub 55 r))
DEFINE_REC(shaPadZeros, : List Nat -> Nat -> List Nat -> List Nat := fun (ix : List Nat) (z : Nat) (tail : List Nat) => case ix as s1 in List return List Nat with | nil => tail | cons (i : Nat) (ir : List Nat) => (case (natLt i z) as s2 return List Nat with | 0 (no : prod ()) => shaPadZeros ir z tail | 1 (yes : prod ()) => cons 0 (shaPadZeros ir z tail)))
DEFINE_REC(shaWords, : List Nat -> List (List Nat) -> List (List Nat) := fun (l : List Nat) (tail : List (List Nat)) => case l as q0 in List return List (List Nat) with | nil => tail | cons (b0 : Nat) (l1 : List Nat) => (case l1 as q1 in List return List (List Nat) with | nil => tail | cons (b1 : Nat) (l2 : List Nat) => (case l2 as q2 in List return List (List Nat) with | nil => tail | cons (b2 : Nat) (l3 : List Nat) => (case l3 as q3 in List return List (List Nat) with | nil => tail | cons (b3 : Nat) (l4 : List Nat) => cons (shaBits shaPow32 (natAdd (natMul 16777216 b0) (natAdd (natMul 65536 b1) (natAdd (natMul 256 b2) b3)))) (shaWords l4 tail)))))
DEFINE_REC(shaBlocks, : List (List Nat) -> List (List (List Nat)) := fun (ws : List (List Nat)) => case ws as q0 in List return List (List (List Nat)) with | nil => nil | cons (x0 : List Nat) (w1 : List (List Nat)) => (case w1 as q1 in List return List (List (List Nat)) with | nil => nil | cons (x1 : List Nat) (w2 : List (List Nat)) => (case w2 as q2 in List return List (List (List Nat)) with | nil => nil | cons (x2 : List Nat) (w3 : List (List Nat)) => (case w3 as q3 in List return List (List (List Nat)) with | nil => nil | cons (x3 : List Nat) (w4 : List (List Nat)) => (case w4 as q4 in List return List (List (List Nat)) with | nil => nil | cons (x4 : List Nat) (w5 : List (List Nat)) => (case w5 as q5 in List return List (List (List Nat)) with | nil => nil | cons (x5 : List Nat) (w6 : List (List Nat)) => (case w6 as q6 in List return List (List (List Nat)) with | nil => nil | cons (x6 : List Nat) (w7 : List (List Nat)) => (case w7 as q7 in List return List (List (List Nat)) with | nil => nil | cons (x7 : List Nat) (w8 : List (List Nat)) => (case w8 as q8 in List return List (List (List Nat)) with | nil => nil | cons (x8 : List Nat) (w9 : List (List Nat)) => (case w9 as q9 in List return List (List (List Nat)) with | nil => nil | cons (x9 : List Nat) (w10 : List (List Nat)) => (case w10 as q10 in List return List (List (List Nat)) with | nil => nil | cons (x10 : List Nat) (w11 : List (List Nat)) => (case w11 as q11 in List return List (List (List Nat)) with | nil => nil | cons (x11 : List Nat) (w12 : List (List Nat)) => (case w12 as q12 in List return List (List (List Nat)) with | nil => nil | cons (x12 : List Nat) (w13 : List (List Nat)) => (case w13 as q13 in List return List (List (List Nat)) with | nil => nil | cons (x13 : List Nat) (w14 : List (List Nat)) => (case w14 as q14 in List return List (List (List Nat)) with | nil => nil | cons (x14 : List Nat) (w15 : List (List Nat)) => (case w15 as q15 in List return List (List (List Nat)) with | nil => nil | cons (x15 : List Nat) (w16 : List (List Nat)) => (cons (cons x0 (cons x1 (cons x2 (cons x3 (cons x4 (cons x5 (cons x6 (cons x7 (cons x8 (cons x9 (cons x10 (cons x11 (cons x12 (cons x13 (cons x14 (cons x15 nil)))))))))))))))) (shaBlocks w16))))))))))))))))))
DEFINE_REC(shaHexBits, : List Nat -> Text -> Text := fun (l : List Nat) (tail : Text) => case l as q0 in List return Text with | nil => tail | cons (b3 : Nat) (l1 : List Nat) => (case l1 as q1 in List return Text with | nil => tail | cons (b2 : Nat) (l2 : List Nat) => (case l2 as q2 in List return Text with | nil => tail | cons (b1 : Nat) (l3 : List Nat) => (case l3 as q3 in List return Text with | nil => tail | cons (b0 : Nat) (l4 : List Nat) => textByte (hexLow (natAdd (natMul 8 b3) (natAdd (natMul 4 b2) (natAdd (natMul 2 b1) b0)))) (shaHexBits l4 tail)))))
DEFINE_REC(shaHexWords, : List (List Nat) -> Text -> Text := fun (l : List (List Nat)) (tail : Text) => case l as s1 in List return Text with | nil => tail | cons (x : List Nat) (r : List (List Nat)) => shaHexBits x (shaHexWords r tail))
DEFINE(sha256Hex, : Text -> Text -> Text := fun (s : Text) (tail : Text) => shaHexWords (shaCompress (shaBlocks (shaWords (shaBytes s (cons 128 (shaPadZeros shaIdx (shaPadCount (shaLenMod s 0)) nil))) (cons shaC32 (cons (shaBits shaPow32 (natMul 8 (shaLen s 0))) nil)))) shaH) tail)

/* Byte equality of two Texts. */
DEFINE_REC(textSame, : Text -> Text -> Flag := fun (s : Text) (t : Text) => case s as s1 in Text return Flag with | textEnd => (case t as s2 in Text return Flag with | textEnd => flagYes | textByte (c : Nat) (tr : Text) => flagNo) | textByte (b : Nat) (sr : Text) => (case t as s3 in Text return Flag with | textEnd => flagNo | textByte (c : Nat) (tr : Text) => (case (natEq b c) as s4 return Flag with | 0 (no : prod ()) => flagNo | 1 (yes : prod ()) => textSame sr tr)))

/* The write path (M5 delta D-1 (a), checker.c write_step): the Command to
   Body table (checker.c write_bodies and write_party_body), the last entry
   of a log, the end of a log, and writeWith. hs gives the hash text of an
   Entry (a generated row). A hash is made only in an arm where write_step
   makes it. */
DEFINE(writeBody, : Command -> Option Body := fun (c : Command) => case c as s1 in Command return Option Body with | commandResolveParty (k : KindParty) (n : Text) (ids : List Identifier) => some (createsParty (makeParty k n none ids attrsEnd none none)) | commandMergeParties (a : Ref kindParty) (d : Ref kindParty) => none | commandSplitParty (p : Ref kindParty) (m : List Identifier) => none | commandAddIdentifier (p : Ref kindParty) (i : Identifier) => none | commandVerifyIdentifier (p : Ref kindParty) (y : IdentifierSystem) (v : Text) => none | commandEnrichParty (p : Ref kindParty) (a : Attrs) (v : Provenance) => none | commandDeleteParty (p : Ref kindParty) => none | commandRestoreParty (p : Ref kindParty) => none | commandEraseParty (p : Ref kindParty) => none | commandStartMembership (m : Membership) => some (createsMembership m) | commandEndMembership (m : Ref kindMembership) => none | commandSetPrimary (m : Ref kindMembership) => none | commandOpenCommercial (m : Commercial) => some (createsCommercial m) | commandTransition (m : Ref kindCommercial) (t : Text) => none | commandChangeAmount (m : Ref kindCommercial) (a : Option Nat) => none | commandSetStatus (m : Ref kindCommercial) (t : CommercialStatus) => none | commandPropose (m : Commitment) => some (createsCommitment m) | commandAgree (m : Ref kindCommitment) => none | commandIngest (m : Artifact) => some (createsArtifact m) | commandExtract (m : Ref kindArtifact) (f : List Body) => none | commandRecord (m : Event) => some (createsEvent m) | commandAssign (m : Assignment) => some (createsAssignment m) | commandReassign (m : Ref kindAssignment) (p : Ref kindParty) => none | commandEndAssignment (m : Ref kindAssignment) => none | commandBulkReassign (a : Ref kindParty) (d : Ref kindParty) => none | commandRouteTerritory (a : Account) (t : Text) => none | commandRequestApproval (m : Ref kindCommercial) (t : Text) => none | commandGrantApproval (m : Ref kindEvent) => none)
DEFINE_REC(writeLast, : List Entry -> Option Entry -> Option Entry := fun (l : List Entry) (o : Option Entry) => case l as s1 in List return Option Entry with | nil => o | cons (e : Entry) (r : List Entry) => writeLast r (some e))
DEFINE_REC(writeSnoc, : List Entry -> Entry -> List Entry := fun (l : List Entry) (e : Entry) => case l as s1 in List return List Entry with | nil => cons e nil | cons (x : Entry) (r : List Entry) => cons x (writeSnoc r e))
DEFINE(writeAdd, : (Entry -> Text) -> Log -> Entry -> Step := fun (hs : Entry -> Text) (lg : Log) (e : Entry) => makeStep (writeSnoc lg e) (outcomeAppended (cons (hashOf (hs e)) nil) none))
DEFINE(writeOld, : (Entry -> Text) -> Log -> Option Hash -> Actor -> Body -> Text -> Step := fun (hs : Entry -> Text) (lg : Log) (x : Option Hash) (a : Actor) (b : Body) (hd : Text) => case x as s1 in Option return Step with | none => writeAdd hs lg (makeEntry (some (hashOf hd)) a b) | some (h : Hash) => (case h as s2 in Hash return Step with | hashOf (d : Text) => (case (textSame d hd) as s3 in Flag return Step with | flagNo => makeStep lg (outcomeConflict (hashOf hd)) | flagYes => writeAdd hs lg (makeEntry (some (hashOf hd)) a b))))
DEFINE(writeWith, : (Entry -> Text) -> Log -> Write -> Step := fun (hs : Entry -> Text) (lg : Log) (w : Write) => case w as s1 in Write return Step with | makeWrite (a : Actor) (x : Option Hash) (c : Command) => (case (writeBody c) as s2 in Option return Step with | none => makeStep lg (outcomeDenied none nil) | some (b : Body) => (case (writeLast lg none) as s3 in Option return Step with | none => (case x as s4 in Option return Step with | none => writeAdd hs lg (makeEntry none a b) | some (h : Hash) => makeStep lg (outcomeDenied none nil)) | some (e : Entry) => writeOld hs lg x a b (hs e))))
DEFINE(stepLog, : Step -> Log := fun (t : Step) => case t as s1 in Step return Log with | makeStep (lg : Log) (o : Outcome) => lg)

/* The records (M5 delta D-1 (a), program.c project_records): a fold over
   the feeding logs in definition order and their entries in log order, the
   records oldest first. A record is the hash text of its creating entry and
   its Body (the tag gives the type, the payload the state). upd sets
   lastEvent on a Body payload and put encodes one record (generated rows). */
FAMILY(Record, : Type 0)
  CONSTRUCTOR(makeRecord, Record) FIELD(ref, Text) FIELD(state, Body)
DEFINE_REC(recordsKnown, : List Record -> Text -> Flag := fun (rs : List Record) (h : Text) => case rs as s1 in List return Flag with | nil => flagNo | cons (r : Record) (rr : List Record) => (case r as s2 in Record return Flag with | makeRecord (x : Text) (b : Body) => (case (textSame x h) as s3 in Flag return Flag with | flagNo => recordsKnown rr h | flagYes => flagYes)))
DEFINE_REC(recordsSet, : List Record -> (Body -> Body) -> Text -> List Record := fun (rs : List Record) (f : Body -> Body) (h : Text) => case rs as s1 in List return List Record with | nil => nil | cons (r : Record) (rr : List Record) => cons (case r as s2 in Record return Record with | makeRecord (x : Text) (b : Body) => (case (textSame x h) as s3 in Flag return Record with | flagNo => makeRecord x b | flagYes => makeRecord x (f b))) (recordsSet rr f h))
DEFINE_REC(recordsSnoc, : List Record -> Record -> List Record := fun (rs : List Record) (r : Record) => case rs as s1 in List return List Record with | nil => cons r nil | cons (x : Record) (rr : List Record) => cons x (recordsSnoc rr r))
DEFINE(refText, : (0 k : Kind) -> Ref k -> Text := fun (0 k : Kind) (r : Ref k) => case r as s1 in Ref return Text with | refTo (h : Hash) => (case h as s2 in Hash return Text with | hashOf (d : Text) => d))
DEFINE(recordsSubject, : Body -> Option Text := fun (b : Body) => case b as s1 in Body return Option Text with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (e : Event) => (case e as s2 in Event return Option Text with | makeEvent (y : EventType) (j : Subject) (f : Option (Ref kindArtifact)) (q : Option (Ref kindEvent)) (v : Attrs) (g : Option (Ref kindPolicy)) => (case j as s3 in Subject return Option Text with | subjectParty (r : Ref kindParty) => some (refText kindParty r) | subjectMembership (r : Ref kindMembership) => some (refText kindMembership r) | subjectCommercial (r : Ref kindCommercial) => some (refText kindCommercial r) | subjectCommitment (r : Ref kindCommitment) => some (refText kindCommitment r) | subjectAssignment (r : Ref kindAssignment) => some (refText kindAssignment r))) | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(recordsTarget, : (Text -> Body -> Body) -> List Record -> Text -> Body -> List Record := fun (upd : Text -> Body -> Body) (rs : List Record) (h : Text) (b : Body) => case (recordsSubject b) as s1 in Option return List Record with | none => rs | some (j : Text) => recordsSet rs (upd h) j)
DEFINE(recordsAdd, : (Text -> Body -> Body) -> List Record -> Text -> Entry -> List Record := fun (upd : Text -> Body -> Body) (rs : List Record) (h : Text) (e : Entry) => case (recordsKnown rs h) as s1 in Flag return List Record with | flagNo => (case e as s2 in Entry return List Record with | makeEntry (p : Option Hash) (a : Actor) (b : Body) => recordsSnoc (recordsTarget upd rs h b) (makeRecord h b)) | flagYes => rs)
DEFINE_REC(recordsLog, : List Entry -> (Entry -> Text) -> (Text -> Body -> Body) -> List Record -> List Record := fun (l : List Entry) (hs : Entry -> Text) (upd : Text -> Body -> Body) (rs : List Record) => case l as s1 in List return List Record with | nil => rs | cons (e : Entry) (r : List Entry) => recordsLog r hs upd (recordsAdd upd rs (hs e) e))
DEFINE_REC(recordsLogs, : List Log -> (Entry -> Text) -> (Text -> Body -> Body) -> List Record -> List Record := fun (ls : List Log) (hs : Entry -> Text) (upd : Text -> Body -> Body) (rs : List Record) => case ls as s1 in List return List Record with | nil => rs | cons (l : Log) (r : List Log) => recordsLogs r hs upd (recordsLog l hs upd rs))
DEFINE(recordsWith, : (Entry -> Text) -> (Text -> Body -> Body) -> List Log -> List Record := fun (hs : Entry -> Text) (upd : Text -> Body -> Body) (ls : List Log) => recordsLogs ls hs upd nil)

/* The render helper (program.c:1300): no records gives nothing; else
   ,"records":[ then the records with , between them and ]. */
DEFINE_REC(recordsMore, : List Record -> (Text -> Body -> Text -> Text) -> Text -> Text := fun (rs : List Record) (put : Text -> Body -> Text -> Text) (tail : Text) => case rs as s1 in List return Text with | nil => textByte 93 tail | cons (r : Record) (rr : List Record) => textByte 44 (case r as s2 in Record return Text with | makeRecord (x : Text) (b : Body) => put x b (recordsMore rr put tail)))
DEFINE(recordsThen, : (Text -> Body -> Text -> Text) -> List Record -> Text -> Text := fun (put : Text -> Body -> Text -> Text) (rs : List Record) (tail : Text) => case rs as s1 in List return Text with | nil => tail | cons (r : Record) (rr : List Record) => textByte 44 (textByte 34 (textByte 114 (textByte 101 (textByte 99 (textByte 111 (textByte 114 (textByte 100 (textByte 115 (textByte 34 (textByte 58 (textByte 91 (case r as s2 in Record return Text with | makeRecord (x : Text) (b : Body) => put x b (recordsMore rr put tail))))))))))))))
/* E-1 (a): the read path. Hash lists as data; readWithH takes the update function (ledgerLastEvent is generated after these rows). */
DEFINE_REC(readUptoH, : Text -> List Entry -> List Text -> Option (List Entry) := fun (h : Text) (l : List Entry) (ks : List Text) => case l as s1 in List return Option (List Entry) with | nil => none | cons (e : Entry) (r : List Entry) => (case ks as s2 in List return Option (List Entry) with | nil => none | cons (k : Text) (kr : List Text) => (case (textSame k h) as s3 in Flag return Option (List Entry) with | flagNo => (case (readUptoH h r kr) as s4 in Option return Option (List Entry) with | none => none | some (t : List Entry) => some (cons e t)) | flagYes => some (cons e nil))))
DEFINE(readReplayH, : List Text -> Log -> Moment -> Log := fun (ks : List Text) (lg : Log) (m : Moment) => case m as s1 in Moment return Log with | momentNow => lg | momentAsOf (h : Hash) => (case h as s2 in Hash return Log with | hashOf (d : Text) => (case (readUptoH d lg ks) as s3 in Option return Log with | none => nil | some (t : List Entry) => t)))
DEFINE_REC(recordsLogH, : List Entry -> List Text -> (Text -> Body -> Body) -> List Record -> List Record := fun (l : List Entry) (ks : List Text) (upd : Text -> Body -> Body) (rs : List Record) => case l as s1 in List return List Record with | nil => rs | cons (e : Entry) (r : List Entry) => (case ks as s2 in List return List Record with | nil => rs | cons (k : Text) (kr : List Text) => recordsLogH r kr upd (recordsAdd upd rs k e)))
DEFINE_REC(recordsLogsH, : List Log -> List (List Text) -> (Text -> Body -> Body) -> List Record -> List Record := fun (ls : List Log) (kss : List (List Text)) (upd : Text -> Body -> Body) (rs : List Record) => case ls as s1 in List return List Record with | nil => rs | cons (l : Log) (r : List Log) => (case kss as s2 in List return List Record with | nil => rs | cons (ks : List Text) (kr : List (List Text)) => recordsLogsH r kr upd (recordsLogH l ks upd rs)))
DEFINE_REC(hsMap, : (Entry -> Text) -> List Entry -> List Text := fun (hs : Entry -> Text) (l : List Entry) => case l as s1 in List return List Text with | nil => nil | cons (e : Entry) (r : List Entry) => cons (hs e) (hsMap hs r))
DEFINE(bodyCommitment, : Body -> Option Commitment := fun (b : Body) => case b as s1 in Body return Option Commitment with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => some m | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(valueNatOf, : Value -> Option Nat := fun (v : Value) => case v as s1 in Value return Option Nat with | valueNull => none | valueFlag (f : Flag) => none | valueNat (n : Nat) => some n | valueText (t : Text) => none | valueItems (i : Values) => none | valueAttrs (a : Attrs) => none)
DEFINE(pctTens, : Nat -> Nat -> Nat -> Nat := fun (n : Nat) (f : Nat) (t : Nat) => natAdd (natMul 10 t) (digitAt (natSub n (natMul t (natMul 10 f))) f))
DEFINE(pctDigits, : Nat -> Nat -> Nat := fun (n : Nat) (f : Nat) => (case (natLt n (natMul 100 f)) as s1 return Nat with | 0 (no : prod ()) => 100 | 1 (yes : prod ()) => pctTens n f (digitAt n (natMul 10 f))))
DEFINE(pctOf, : Nat -> Nat -> Option Nat := fun (f : Nat) (a : Nat) => (case (natLt 0 f) as s1 return Option Nat with | 0 (no : prod ()) => none | 1 (yes : prod ()) => (case (natLt f a) as s2 return Option Nat with | 0 (no : prod ()) => some (pctDigits (natMul 100 (natSub f a)) f) | 1 (yes : prod ()) => none)))
DEFINE(discPct, : Option Value -> Value -> Option Nat := fun (fv : Option Value) (av : Value) => case fv as s1 in Option return Option Nat with | none => none | some (w : Value) => (case (valueNatOf w) as s2 in Option return Option Nat with | none => none | some (fn : Nat) => (case (valueNatOf av) as s3 in Option return Option Nat with | none => none | some (an : Nat) => pctOf fn an)))
DEFINE(discFirst, : Option Value -> Value -> Option Value := fun (fv : Option Value) (v : Value) => case fv as s1 in Option return Option Value with | none => some v | some (w : Value) => some w)
DEFINE(discIsPrice, : Text -> Ref kindCommercial -> CommitmentKind -> Flag := fun (d : Text) (cm : Ref kindCommercial) (k : CommitmentKind) => case k as s1 in CommitmentKind return Flag with | commitmentPrice => textSame (refText kindCommercial cm) d | commitmentTerm => flagNo | commitmentDate => flagNo | commitmentScope => flagNo | commitmentSla => flagNo)
DEFINE(recSupersedes, : Record -> Text -> Flag := fun (x : Record) (h : Text) => case x as s1 in Record return Flag with | makeRecord (k : Text) (b : Body) => (case (bodyCommitment b) as s2 in Option return Flag with | none => flagNo | some (c : Commitment) => (case c as s3 in Commitment return Flag with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case sp as s4 in Option return Flag with | none => flagNo | some (rf : Ref kindCommitment) => textSame (refText kindCommitment rf) h))))
DEFINE_REC(recSuperseded, : List Record -> Text -> Flag := fun (l : List Record) (h : Text) => case l as s1 in List return Flag with | nil => flagNo | cons (x : Record) (r : List Record) => (case (recSupersedes x h) as s2 in Flag return Flag with | flagNo => recSuperseded r h | flagYes => flagYes))
DEFINE(discAgreed, : List Record -> Text -> CommitmentStatus -> Value -> Option Value -> Option Nat -> Option Nat := fun (all : List Record) (h : Text) (st : CommitmentStatus) (v : Value) (fv : Option Value) (res : Option Nat) => case st as s1 in CommitmentStatus return Option Nat with | commitmentProposed => res | commitmentAgreed => (case (recSuperseded all h) as s2 in Flag return Option Nat with | flagNo => discPct fv v | flagYes => res) | commitmentSuperseded => res)
DEFINE_REC(discWalk, : List Record -> List Record -> Text -> Option Value -> Option Nat -> Option Nat := fun (l : List Record) (all : List Record) (d : Text) (fv : Option Value) (res : Option Nat) => case l as s1 in List return Option Nat with | nil => res | cons (x : Record) (r : List Record) => (case x as s2 in Record return Option Nat with | makeRecord (h : Text) (b : Body) => (case (bodyCommitment b) as s3 in Option return Option Nat with | none => discWalk r all d fv res | some (c : Commitment) => (case c as s4 in Commitment return Option Nat with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case (discIsPrice d cm ck) as s5 in Flag return Option Nat with | flagNo => discWalk r all d fv res | flagYes => discWalk r all d (discFirst fv v) (discAgreed all h st v fv res))))))
DEFINE(discRead, : List Record -> Ref kindCommercial -> Option Nat := fun (rs : List Record) (c : Ref kindCommercial) => discWalk rs rs (refText kindCommercial c) none none)
DEFINE(bodyCommercial, : Body -> Option Commercial := fun (b : Body) => case b as s1 in Body return Option Commercial with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => some m | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE_REC(recLen, : List Record -> Nat := fun (l : List Record) => case l as s1 in List return Nat with | nil => 0 | cons (x : Record) (r : List Record) => natAdd 1 (recLen r))
DEFINE_REC(recPos, : List Record -> Text -> Nat -> Option Nat := fun (l : List Record) (h : Text) (i : Nat) => case l as s1 in List return Option Nat with | nil => none | cons (x : Record) (r : List Record) => (case x as s2 in Record return Option Nat with | makeRecord (k : Text) (b : Body) => (case (textSame k h) as s3 in Flag return Option Nat with | flagNo => recPos r h (natAdd i 1) | flagYes => some i)))
DEFINE(staleLast, : List Record -> Commercial -> Nat -> Nat := fun (all : List Record) (c : Commercial) (p : Nat) => case c as s1 in Commercial return Nat with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => (case x9 as s2 in Option return Nat with | none => p | some (ev : Ref kindEvent) => (case (recPos all (refText kindEvent ev) 0) as s3 in Option return Nat with | none => p | some (s : Nat) => (case (natLt p s) as s4 return Nat with | 0 (no : prod ()) => p | 1 (yes : prod ()) => s))))
DEFINE(commercialRef, : Text -> Ref kindCommercial := fun (h : Text) => refTo (hashOf h))
DEFINE_REC(staleWalk, : List Record -> List Record -> Nat -> Nat -> Nat -> List (Ref kindCommercial) := fun (l : List Record) (all : List Record) (p : Nat) (total : Nat) (quiet : Nat) => case l as s1 in List return List (Ref kindCommercial) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindCommercial) with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return List (Ref kindCommercial) with | none => staleWalk r all (natAdd p 1) total quiet | some (c : Commercial) => (case (natLt (natAdd (staleLast all c p) quiet) total) as s4 return List (Ref kindCommercial) with | 0 (no : prod ()) => staleWalk r all (natAdd p 1) total quiet | 1 (yes : prod ()) => cons (commercialRef h) (staleWalk r all (natAdd p 1) total quiet)))))
DEFINE(staleRead, : List Record -> Nat -> List (Ref kindCommercial) := fun (rs : List Record) (q : Nat) => staleWalk rs rs 0 (recLen rs) q)
DEFINE(flagAnd, : Flag -> Flag -> Flag := fun (a : Flag) (b : Flag) => case a as s1 in Flag return Flag with | flagNo => flagNo | flagYes => b)
DEFINE(flagOr, : Flag -> Flag -> Flag := fun (a : Flag) (b : Flag) => case a as s1 in Flag return Flag with | flagNo => b | flagYes => flagYes)
DEFINE(flagNot, : Flag -> Flag := fun (a : Flag) => case a as s1 in Flag return Flag with | flagNo => flagYes | flagYes => flagNo)
DEFINE(natSame, : Nat -> Nat -> Flag := fun (a : Nat) (b : Nat) => (case (natEq a b) as s1 return Flag with | 0 (no : prod ()) => flagNo | 1 (yes : prod ()) => flagYes))
DEFINE(optNone, : (0 A : Type 0) -> Option A -> Flag := fun (0 A : Type 0) (o : Option A) => case o as s1 in Option return Flag with | none => flagYes | some (v : A) => flagNo)
DEFINE(optSome, : (0 A : Type 0) -> Option A -> Flag := fun (0 A : Type 0) (o : Option A) => flagNot (optNone A o))
DEFINE(optSame, : (0 A : Type 0) -> (A -> A -> Flag) -> Option A -> Option A -> Flag := fun (0 A : Type 0) (cmp : A -> A -> Flag) (o : Option A) (p : Option A) => case o as s1 in Option return Flag with | none => optNone A p | some (v : A) => (case p as s2 in Option return Flag with | none => flagNo | some (w : A) => cmp v w))
DEFINE(refSame, : (0 k : Kind) -> Ref k -> Ref k -> Flag := fun (0 k : Kind) (a : Ref k) (b : Ref k) => textSame (refText k a) (refText k b))
DEFINE_REC(textIn, : List Text -> Text -> Flag := fun (l : List Text) (t : Text) => case l as s1 in List return Flag with | nil => flagNo | cons (x : Text) (r : List Text) => (case (textSame x t) as s2 in Flag return Flag with | flagNo => textIn r t | flagYes => flagYes))
DEFINE_REC(textDedupe, : List Text -> List Text -> List Text := fun (l : List Text) (seen : List Text) => case l as s1 in List return List Text with | nil => nil | cons (t : Text) (r : List Text) => (case (textIn seen t) as s2 in Flag return List Text with | flagNo => cons t (textDedupe r (cons t seen)) | flagYes => textDedupe r seen))
DEFINE(asOfThen, : (0 A : Type 0) -> A -> (List Record -> A) -> Option (List Record) -> A := fun (0 A : Type 0) (d : A) (k : List Record -> A) (o : Option (List Record)) => case o as s1 in Option return A with | none => d | some (rs : List Record) => k rs)
DEFINE(readAsOfH, : (Text -> Body -> Body) -> List Text -> Log -> Moment -> Option (List Record) := fun (upd : Text -> Body -> Body) (ks : List Text) (lg : Log) (m : Moment) => case m as s1 in Moment return Option (List Record) with | momentNow => some (recordsLogH lg ks upd nil) | momentAsOf (h : Hash) => (case h as s2 in Hash return Option (List Record) with | hashOf (d : Text) => (case (readUptoH d lg ks) as s3 in Option return Option (List Record) with | none => none | some (t : List Entry) => some (recordsLogH t ks upd nil))))
DEFINE_REC(recFind, : List Record -> Text -> Option Body := fun (l : List Record) (h : Text) => case l as s1 in List return Option Body with | nil => none | cons (x : Record) (r : List Record) => (case x as s2 in Record return Option Body with | makeRecord (k : Text) (b : Body) => (case (textSame k h) as s3 in Flag return Option Body with | flagNo => recFind r h | flagYes => some b)))
DEFINE(bodyParty, : Body -> Option Party := fun (b : Body) => case b as s1 in Body return Option Party with | createsParty (m : Party) => some m | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(bodyMembership, : Body -> Option Membership := fun (b : Body) => case b as s1 in Body return Option Membership with | createsParty (m : Party) => none | createsMembership (m : Membership) => some m | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(bodyArtifact, : Body -> Option Artifact := fun (b : Body) => case b as s1 in Body return Option Artifact with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => some m | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(bodyEvent, : Body -> Option Event := fun (b : Body) => case b as s1 in Body return Option Event with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => some m | createsAssignment (m : Assignment) => none | createsPolicy (m : Policy) => none)
DEFINE(bodyAssignment, : Body -> Option Assignment := fun (b : Body) => case b as s1 in Body return Option Assignment with | createsParty (m : Party) => none | createsMembership (m : Membership) => none | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => none | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => some m | createsPolicy (m : Policy) => none)
DEFINE(eventRef, : Text -> Ref kindEvent := fun (h : Text) => refTo (hashOf h))
DEFINE(membershipRef, : Text -> Ref kindMembership := fun (h : Text) => refTo (hashOf h))
DEFINE(commitmentRef, : Text -> Ref kindCommitment := fun (h : Text) => refTo (hashOf h))
DEFINE(assignmentRef, : Text -> Ref kindAssignment := fun (h : Text) => refTo (hashOf h))
DEFINE(artifactRef, : Text -> Ref kindArtifact := fun (h : Text) => refTo (hashOf h))
DEFINE_REC(attrsGet, : Attrs -> Text -> Option Value := fun (a : Attrs) (t : Text) => case a as s1 in Attrs return Option Value with | attrsEnd => none | attrsField (k : Text) (v : Value) (r : Attrs) => (case (textSame k t) as s2 in Flag return Option Value with | flagNo => attrsGet r t | flagYes => some v))
DEFINE(valueTextOf, : Value -> Option Text := fun (v : Value) => case v as s1 in Value return Option Text with | valueNull => none | valueFlag (f : Flag) => none | valueNat (n : Nat) => none | valueText (t : Text) => some t | valueItems (i : Values) => none | valueAttrs (a : Attrs) => none)
DEFINE(attrsText, : Attrs -> Text -> Option Text := fun (a : Attrs) (k : Text) => case (attrsGet a k) as s1 in Option return Option Text with | none => none | some (v : Value) => valueTextOf v)
DEFINE(recCommercial, : List Record -> Text -> Option Commercial := fun (rs : List Record) (h : Text) => case (recFind rs h) as s1 in Option return Option Commercial with | none => none | some (b : Body) => bodyCommercial b)
DEFINE(kcNat, : KindCommercial -> Nat := fun (k : KindCommercial) => case k as s1 in KindCommercial return Nat with | commercialDeal => 0 | commercialSubscription => 1 | commercialTicket => 2)
DEFINE(csNat, : CommercialStatus -> Nat := fun (k : CommercialStatus) => case k as s1 in CommercialStatus return Nat with | statusOpen => 0 | statusWon => 1 | statusLost => 2 | statusPaused => 3)
DEFINE(attrsSame, : Attrs -> Attrs -> Flag := fun (a : Attrs) (b : Attrs) => textSame (encodeAttrs a textEnd) (encodeAttrs b textEnd))
DEFINE(commercialSame, : Commercial -> Commercial -> Flag := fun (c : Commercial) (d : Commercial) => case c as s1 in Commercial return Flag with | makeCommercial (a0 : KindCommercial) (a1 : Text) (a2 : Ref kindParty) (a3 : Text) (a4 : Option Nat) (a5 : Text) (a6 : Option Text) (a7 : CommercialStatus) (a8 : Attrs) (a9 : Option (Ref kindEvent)) => (case d as s2 in Commercial return Flag with | makeCommercial (b0 : KindCommercial) (b1 : Text) (b2 : Ref kindParty) (b3 : Text) (b4 : Option Nat) (b5 : Text) (b6 : Option Text) (b7 : CommercialStatus) (b8 : Attrs) (b9 : Option (Ref kindEvent)) => flagAnd (natSame (kcNat a0) (kcNat b0)) (flagAnd (textSame a1 b1) (flagAnd (refSame kindParty a2 b2) (flagAnd (textSame a3 b3) (flagAnd (optSame Nat natSame a4 b4) (flagAnd (textSame a5 b5) (flagAnd (optSame Text textSame a6 b6) (flagAnd (natSame (csNat a7) (csNat b7)) (flagAnd (attrsSame a8 b8) (optSame (Ref kindEvent) (refSame kindEvent) a9 b9)))))))))))
DEFINE(soundRead, : List Record -> Text -> Commercial -> Flag := fun (rs : List Record) (d : Text) (s : Commercial) => case (recCommercial rs d) as s1 in Option return Flag with | none => flagNo | some (c : Commercial) => commercialSame c s)
DEFINE_REC(readAfterH, : Text -> List Entry -> List Text -> Log := fun (h : Text) (l : List Entry) (ks : List Text) => case l as s1 in List return Log with | nil => nil | cons (e : Entry) (r : List Entry) => (case ks as s2 in List return Log with | nil => nil | cons (k : Text) (kr : List Text) => (case (textSame k h) as s3 in Flag return Log with | flagNo => readAfterH h r kr | flagYes => r)))
DEFINE(readTailH, : List Text -> Log -> Moment -> Log := fun (ks : List Text) (lg : Log) (m : Moment) => case m as s1 in Moment return Log with | momentNow => nil | momentAsOf (h : Hash) => (case h as s2 in Hash return Log with | hashOf (d : Text) => readAfterH d lg ks))
DEFINE(actorSame, : Actor -> Actor -> Flag := fun (a : Actor) (b : Actor) => case a as s1 in Actor return Flag with | actorHuman (p : Ref kindParty) => (case b as s2 in Actor return Flag with | actorHuman (q : Ref kindParty) => refSame kindParty p q | actorAgent (m : Text) => flagNo | actorSystem (m : Text) => flagNo) | actorAgent (n : Text) => (case b as s3 in Actor return Flag with | actorHuman (q : Ref kindParty) => flagNo | actorAgent (m : Text) => textSame n m | actorSystem (m : Text) => flagNo) | actorSystem (n : Text) => (case b as s4 in Actor return Flag with | actorHuman (q : Ref kindParty) => flagNo | actorAgent (m : Text) => flagNo | actorSystem (m : Text) => textSame n m))
DEFINE_REC(auditWalkH, : List Entry -> List Text -> Actor -> List (Ref kindEvent) := fun (l : List Entry) (ks : List Text) (a : Actor) => case l as s1 in List return List (Ref kindEvent) with | nil => nil | cons (e : Entry) (r : List Entry) => (case ks as s2 in List return List (Ref kindEvent) with | nil => nil | cons (k : Text) (kr : List Text) => (case e as s3 in Entry return List (Ref kindEvent) with | makeEntry (p : Option Hash) (ac : Actor) (b : Body) => (case (flagAnd (optSome Event (bodyEvent b)) (actorSame ac a)) as s4 in Flag return List (Ref kindEvent) with | flagNo => auditWalkH r kr a | flagYes => cons (eventRef k) (auditWalkH r kr a)))))
DEFINE_REC(membersWalk, : List Record -> Text -> List (Ref kindMembership) := fun (l : List Record) (o : Text) => case l as s1 in List return List (Ref kindMembership) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindMembership) with | makeRecord (h : Text) (b : Body) => (case (bodyMembership b) as s3 in Option return List (Ref kindMembership) with | none => membersWalk r o | some (m : Membership) => (case m as s4 in Membership return List (Ref kindMembership) with | makeMembership (pe : Ref kindParty) (og : Ref kindParty) (ro : Option Text) (ip : Flag) (eb : Option (Ref kindEvent)) (pv : Provenance) (ats : Attrs) => (case (flagAnd (textSame (refText kindParty og) o) (optNone (Ref kindEvent) eb)) as s5 in Flag return List (Ref kindMembership) with | flagNo => membersWalk r o | flagYes => cons (membershipRef h) (membersWalk r o))))))
DEFINE_REC(employerFirst, : List Record -> Text -> Flag -> Option (Ref kindParty) := fun (l : List Record) (p : Text) (pr : Flag) => case l as s1 in List return Option (Ref kindParty) with | nil => none | cons (x : Record) (r : List Record) => (case x as s2 in Record return Option (Ref kindParty) with | makeRecord (h : Text) (b : Body) => (case (bodyMembership b) as s3 in Option return Option (Ref kindParty) with | none => employerFirst r p pr | some (m : Membership) => (case m as s4 in Membership return Option (Ref kindParty) with | makeMembership (pe : Ref kindParty) (og : Ref kindParty) (ro : Option Text) (ip : Flag) (eb : Option (Ref kindEvent)) (pv : Provenance) (ats : Attrs) => (case (flagAnd (textSame (refText kindParty pe) p) (flagAnd (optNone (Ref kindEvent) eb) (flagOr (flagNot pr) ip))) as s5 in Flag return Option (Ref kindParty) with | flagNo => employerFirst r p pr | flagYes => some og)))))
DEFINE(employerRead, : List Record -> Text -> Option (Ref kindParty) := fun (rs : List Record) (p : Text) => case (employerFirst rs p flagYes) as s1 in Option return Option (Ref kindParty) with | none => employerFirst rs p flagNo | some (o : Ref kindParty) => some o)
DEFINE_REC(changesPersons, : List Record -> List (Ref kindParty) := fun (l : List Record) => case l as s1 in List return List (Ref kindParty) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindParty) with | makeRecord (h : Text) (b : Body) => (case (bodyMembership b) as s3 in Option return List (Ref kindParty) with | none => changesPersons r | some (m : Membership) => (case m as s4 in Membership return List (Ref kindParty) with | makeMembership (pe : Ref kindParty) (og : Ref kindParty) (ro : Option Text) (ip : Flag) (eb : Option (Ref kindEvent)) (pv : Provenance) (ats : Attrs) => cons pe (changesPersons r)))))
DEFINE_REC(changesFrom, : List Record -> Text -> List (Ref kindParty) := fun (l : List Record) (h : Text) => case l as s1 in List return List (Ref kindParty) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindParty) with | makeRecord (k : Text) (b : Body) => (case (textSame k h) as s3 in Flag return List (Ref kindParty) with | flagNo => changesFrom r h | flagYes => changesPersons r)))
DEFINE(changesRead, : List Record -> Moment -> List (Ref kindParty) := fun (rs : List Record) (m : Moment) => case m as s1 in Moment return List (Ref kindParty) with | momentNow => nil | momentAsOf (h : Hash) => (case h as s2 in Hash return List (Ref kindParty) with | hashOf (d : Text) => changesFrom rs d))
DEFINE(statusLive, : CommitmentStatus -> Flag := fun (s : CommitmentStatus) => case s as s1 in CommitmentStatus return Flag with | commitmentProposed => flagYes | commitmentAgreed => flagYes | commitmentSuperseded => flagNo)
DEFINE_REC(termsWalk, : List Record -> List Record -> Text -> List (Ref kindCommitment) := fun (l : List Record) (all : List Record) (d : Text) => case l as s1 in List return List (Ref kindCommitment) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindCommitment) with | makeRecord (h : Text) (b : Body) => (case (bodyCommitment b) as s3 in Option return List (Ref kindCommitment) with | none => termsWalk r all d | some (c : Commitment) => (case c as s4 in Commitment return List (Ref kindCommitment) with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case (flagAnd (textSame (refText kindCommercial cm) d) (flagAnd (statusLive st) (flagNot (recSuperseded all h)))) as s5 in Flag return List (Ref kindCommitment) with | flagNo => termsWalk r all d | flagYes => cons (commitmentRef h) (termsWalk r all d))))))
DEFINE(recCommitment, : List Record -> Text -> Option Commitment := fun (rs : List Record) (h : Text) => case (recFind rs h) as s1 in Option return Option Commitment with | none => none | some (b : Body) => bodyCommitment b)
DEFINE_REC(termChain, : List Record -> List Record -> Text -> List (Ref kindCommitment) -> List (Ref kindCommitment) := fun (fu : List Record) (all : List Record) (h : Text) (acc : List (Ref kindCommitment)) => case fu as s1 in List return List (Ref kindCommitment) with | nil => acc | cons (y : Record) (fr : List Record) => (case (recCommitment all h) as s2 in Option return List (Ref kindCommitment) with | none => acc | some (c : Commitment) => (case c as s3 in Commitment return List (Ref kindCommitment) with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case sp as s4 in Option return List (Ref kindCommitment) with | none => cons (commitmentRef h) acc | some (rf : Ref kindCommitment) => termChain fr all (refText kindCommitment rf) (cons (commitmentRef h) acc)))))
DEFINE(termRead, : List Record -> Text -> List (Ref kindCommitment) := fun (rs : List Record) (h : Text) => termChain rs rs h nil)
DEFINE(statusAgreed, : CommitmentStatus -> Flag := fun (s : CommitmentStatus) => case s as s1 in CommitmentStatus return Flag with | commitmentProposed => flagNo | commitmentAgreed => flagYes | commitmentSuperseded => flagNo)
DEFINE(valueIsNat, : Value -> Nat -> Flag := fun (v : Value) (n : Nat) => case (valueNatOf v) as s1 in Option return Flag with | none => flagNo | some (p : Nat) => natSame p n)
DEFINE_REC(reconWalk, : List Record -> List Record -> Text -> Nat -> Flag := fun (l : List Record) (all : List Record) (d : Text) (n : Nat) => case l as s1 in List return Flag with | nil => flagNo | cons (x : Record) (r : List Record) => (case x as s2 in Record return Flag with | makeRecord (h : Text) (b : Body) => (case (bodyCommitment b) as s3 in Option return Flag with | none => reconWalk r all d n | some (c : Commitment) => (case c as s4 in Commitment return Flag with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case (flagAnd (discIsPrice d cm ck) (flagAnd (statusAgreed st) (flagAnd (valueIsNat v n) (flagNot (recSuperseded all h))))) as s5 in Flag return Flag with | flagNo => reconWalk r all d n | flagYes => flagYes)))))
DEFINE(reconRead, : List Record -> Text -> Flag := fun (rs : List Record) (d : Text) => case (recCommercial rs d) as s1 in Option return Flag with | none => flagNo | some (c : Commercial) => (case c as s2 in Commercial return Flag with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => (case x4 as s3 in Option return Flag with | none => flagNo | some (n : Nat) => reconWalk rs rs d n)))
DEFINE(pipeKey, : Flag -> Commercial -> Text := fun (cl : Flag) (c : Commercial) => case c as s1 in Commercial return Text with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => (case cl as s2 in Flag return Text with | flagNo => x3 | flagYes => (case x6 as s3 in Option return Text with | none => textEnd | some (t : Text) => t)))
DEFINE(commercialCents, : Commercial -> Nat := fun (c : Commercial) => case c as s1 in Commercial return Nat with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => (case x4 as s2 in Option return Nat with | none => 0 | some (n : Nat) => n))
DEFINE(commercialStage, : Commercial -> Text := fun (c : Commercial) => case c as s1 in Commercial return Text with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => x3)
DEFINE_REC(pipeCount, : List Record -> Flag -> Text -> Nat := fun (l : List Record) (cl : Flag) (k : Text) => case l as s1 in List return Nat with | nil => 0 | cons (x : Record) (r : List Record) => (case x as s2 in Record return Nat with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return Nat with | none => pipeCount r cl k | some (c : Commercial) => (case (textSame (pipeKey cl c) k) as s4 in Flag return Nat with | flagNo => pipeCount r cl k | flagYes => natAdd 1 (pipeCount r cl k)))))
DEFINE_REC(pipeCents, : List Record -> Flag -> Text -> Nat := fun (l : List Record) (cl : Flag) (k : Text) => case l as s1 in List return Nat with | nil => 0 | cons (x : Record) (r : List Record) => (case x as s2 in Record return Nat with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return Nat with | none => pipeCents r cl k | some (c : Commercial) => (case (textSame (pipeKey cl c) k) as s4 in Flag return Nat with | flagNo => pipeCents r cl k | flagYes => natAdd (commercialCents c) (pipeCents r cl k)))))
DEFINE_REC(pipeWalk, : List Record -> List Record -> Flag -> List Text -> List Bucket := fun (l : List Record) (all : List Record) (cl : Flag) (seen : List Text) => case l as s1 in List return List Bucket with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Bucket with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return List Bucket with | none => pipeWalk r all cl seen | some (c : Commercial) => (case (textIn seen (pipeKey cl c)) as s4 in Flag return List Bucket with | flagNo => cons (makeBucket (pipeKey cl c) (pipeCount all cl (pipeKey cl c)) (pipeCents all cl (pipeKey cl c))) (pipeWalk r all cl (cons (pipeKey cl c) seen)) | flagYes => pipeWalk r all cl seen))))
DEFINE(pipeRead, : PipelineKey -> List Record -> List Bucket := fun (k : PipelineKey) (rs : List Record) => case k as s1 in PipelineKey return List Bucket with | pipelineByStage => pipeWalk rs rs flagNo nil | pipelineByOwner => nil | pipelineByTerritory => nil | pipelineByCloseDate => pipeWalk rs rs flagYes nil)
DEFINE(afterKey, : Text := textByte 97 (textByte 102 (textByte 116 (textByte 101 (textByte 114 textEnd)))))
DEFINE(beforeKey, : Text := textByte 98 (textByte 101 (textByte 102 (textByte 111 (textByte 114 (textByte 101 textEnd))))))
DEFINE(isStageType, : EventType -> Flag := fun (t : EventType) => case t as s1 in EventType return Flag with | eventStageChanged => flagYes | eventAmountChanged => flagNo | eventAssignmentChanged => flagNo | eventCommitmentSet => flagNo | eventNoteAdded => flagNo | eventMessage => flagNo | eventMeeting => flagNo | eventCall => flagNo | eventApproval => flagNo | eventPolicyDenied => flagNo | eventFieldsChanged => flagNo | eventIdentifierVerified => flagNo | eventEnded => flagNo | eventDeleted => flagNo)
DEFINE(subjIsCommercial, : Subject -> Flag := fun (sj : Subject) => case sj as s1 in Subject return Flag with | subjectParty (p : Ref kindParty) => flagNo | subjectMembership (p : Ref kindMembership) => flagNo | subjectCommercial (p : Ref kindCommercial) => flagYes | subjectCommitment (p : Ref kindCommitment) => flagNo | subjectAssignment (p : Ref kindAssignment) => flagNo)
DEFINE(moveOf, : Body -> Option Event := fun (b : Body) => case (bodyEvent b) as s1 in Option return Option Event with | none => none | some (ev : Event) => (case ev as s2 in Event return Option Event with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (flagAnd (isStageType ty) (flagAnd (subjIsCommercial sj) (optSome Text (attrsText pl afterKey)))) as s3 in Flag return Option Event with | flagNo => none | flagYes => some ev)))
DEFINE(evDeal, : Event -> Text := fun (ev : Event) => case ev as s1 in Event return Text with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case sj as s2 in Subject return Text with | subjectParty (p : Ref kindParty) => textEnd | subjectMembership (p : Ref kindMembership) => textEnd | subjectCommercial (p : Ref kindCommercial) => refText kindCommercial p | subjectCommitment (p : Ref kindCommitment) => textEnd | subjectAssignment (p : Ref kindAssignment) => textEnd))
DEFINE(evAfter, : Event -> Text := fun (ev : Event) => case ev as s1 in Event return Text with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (attrsText pl afterKey) as s2 in Option return Text with | none => textEnd | some (t : Text) => t))
DEFINE(evBefore, : Event -> Option Text := fun (ev : Event) => case ev as s1 in Event return Option Text with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => attrsText pl beforeKey)
DEFINE(moveHas, : Flag -> Event -> Text -> Flag := fun (f : Flag) (ev : Event) (s : Text) => case f as s1 in Flag return Flag with | flagNo => textSame (evAfter ev) s | flagYes => (case (evBefore ev) as s2 in Option return Flag with | none => flagNo | some (bt : Text) => textSame bt s))
DEFINE(moveNames, : Event -> List Text -> List Text := fun (ev : Event) (rest : List Text) => case (evBefore ev) as s1 in Option return List Text with | none => cons (evAfter ev) rest | some (bt : Text) => cons bt (cons (evAfter ev) rest))
DEFINE_REC(stageNames, : List Record -> List Text := fun (l : List Record) => case l as s1 in List return List Text with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Text with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return List Text with | none => (case (moveOf b) as s4 in Option return List Text with | none => stageNames r | some (ev : Event) => moveNames ev (stageNames r)) | some (c : Commercial) => cons (commercialStage c) (stageNames r))))
DEFINE_REC(stageMoves, : List Record -> Flag -> Text -> Nat := fun (l : List Record) (f : Flag) (s : Text) => case l as s1 in List return Nat with | nil => 0 | cons (x : Record) (r : List Record) => (case x as s2 in Record return Nat with | makeRecord (h : Text) (b : Body) => (case (moveOf b) as s3 in Option return Nat with | none => stageMoves r f s | some (ev : Event) => (case (moveHas f ev s) as s4 in Flag return Nat with | flagNo => stageMoves r f s | flagYes => natAdd 1 (stageMoves r f s)))))
DEFINE_REC(stageSpan, : List Record -> Text -> Text -> Nat := fun (l : List Record) (d : Text) (s : Text) => case l as s1 in List return Nat with | nil => 1 | cons (x : Record) (r : List Record) => (case x as s2 in Record return Nat with | makeRecord (h : Text) (b : Body) => (case (moveOf b) as s3 in Option return Nat with | none => natAdd 1 (stageSpan r d s) | some (ev : Event) => (case (flagAnd (textSame (evDeal ev) d) (moveHas flagYes ev s)) as s4 in Flag return Nat with | flagNo => natAdd 1 (stageSpan r d s) | flagYes => 1))))
DEFINE(stayCost, : Body -> Text -> List Record -> Text -> Nat := fun (b : Body) (h : Text) (r : List Record) (s : Text) => case (bodyCommercial b) as s1 in Option return Nat with | none => (case (moveOf b) as s3 in Option return Nat with | none => 0 | some (ev : Event) => (case (textSame (evAfter ev) s) as s4 in Flag return Nat with | flagNo => 0 | flagYes => stageSpan r (evDeal ev) s)) | some (c : Commercial) => (case (textSame (commercialStage c) s) as s2 in Flag return Nat with | flagNo => 0 | flagYes => stageSpan r h s))
DEFINE_REC(stageSum, : List Record -> Text -> Nat := fun (l : List Record) (s : Text) => case l as s1 in List return Nat with | nil => 0 | cons (x : Record) (r : List Record) => (case x as s2 in Record return Nat with | makeRecord (h : Text) (b : Body) => natAdd (stayCost b h r s) (stageSum r s)))
DEFINE_REC(stageMap, : List Record -> List Text -> List StageStat := fun (rs : List Record) (l : List Text) => case l as s1 in List return List StageStat with | nil => nil | cons (s : Text) (r : List Text) => cons (makeStageStat s (stageMoves rs flagNo s) (stageMoves rs flagYes s) (stageSum rs s)) (stageMap rs r))
DEFINE(stageRead, : List Record -> List StageStat := fun (rs : List Record) => stageMap rs (textDedupe (stageNames rs) nil))
DEFINE(kindIsDate, : CommitmentKind -> Flag := fun (k : CommitmentKind) => case k as s1 in CommitmentKind return Flag with | commitmentPrice => flagNo | commitmentTerm => flagNo | commitmentDate => flagYes | commitmentScope => flagNo | commitmentSla => flagNo)
DEFINE(kindIsTerm, : CommitmentKind -> Flag := fun (k : CommitmentKind) => case k as s1 in CommitmentKind return Flag with | commitmentPrice => flagNo | commitmentTerm => flagYes | commitmentDate => flagNo | commitmentScope => flagNo | commitmentSla => flagNo)
DEFINE_REC(renewFirst, : List Record -> List Record -> Text -> (CommitmentKind -> Flag) -> Option Record := fun (l : List Record) (all : List Record) (d : Text) (kf : CommitmentKind -> Flag) => case l as s1 in List return Option Record with | nil => none | cons (x : Record) (r : List Record) => (case x as s2 in Record return Option Record with | makeRecord (h : Text) (b : Body) => (case (bodyCommitment b) as s3 in Option return Option Record with | none => renewFirst r all d kf | some (c : Commitment) => (case c as s4 in Commitment return Option Record with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case (flagAnd (textSame (refText kindCommercial cm) d) (flagAnd (kf ck) (flagAnd (statusLive st) (flagNot (recSuperseded all h))))) as s5 in Flag return Option Record with | flagNo => renewFirst r all d kf | flagYes => some x)))))
DEFINE(recTermRef, : Option Record -> Option (Ref kindCommitment) := fun (o : Option Record) => case o as s1 in Option return Option (Ref kindCommitment) with | none => none | some (x : Record) => (case x as s2 in Record return Option (Ref kindCommitment) with | makeRecord (h : Text) (b : Body) => some (commitmentRef h)))
DEFINE(recDateText, : Record -> Text := fun (x : Record) => case x as s1 in Record return Text with | makeRecord (h : Text) (b : Body) => (case (bodyCommitment b) as s2 in Option return Text with | none => textEnd | some (c : Commitment) => (case c as s3 in Commitment return Text with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => (case (valueTextOf v) as s4 in Option return Text with | none => textEnd | some (t : Text) => t))))
DEFINE(renewItem, : List Record -> Text -> Option Record -> List Renewal -> List Renewal := fun (all : List Record) (h : Text) (od : Option Record) (rest : List Renewal) => case od as s1 in Option return List Renewal with | none => rest | some (dx : Record) => cons (makeRenewal (commercialRef h) (recDateText dx) (recTermRef (renewFirst all all h kindIsTerm))) rest)
DEFINE_REC(renewWalk, : List Record -> List Record -> List Renewal := fun (l : List Record) (all : List Record) => case l as s1 in List return List Renewal with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Renewal with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return List Renewal with | none => renewWalk r all | some (c : Commercial) => renewItem all h (renewFirst all all h kindIsDate) (renewWalk r all))))
DEFINE(renewRead, : List Record -> List Renewal := fun (rs : List Record) => renewWalk rs rs)
DEFINE(acctNames, : Account -> Text -> List Text -> Flag := fun (a : Account) (p : Text) (ds : List Text) => case a as s1 in Account return Flag with | accountParty (r : Ref kindParty) => textSame (refText kindParty r) p | accountCommercial (c : Ref kindCommercial) => textIn ds (refText kindCommercial c))
DEFINE_REC(acctsName, : List Account -> Text -> List Text -> Flag := fun (l : List Account) (p : Text) (ds : List Text) => case l as s1 in List return Flag with | nil => flagNo | cons (a : Account) (r : List Account) => flagOr (acctNames a p ds) (acctsName r p ds))
DEFINE(subjNames, : Subject -> Text -> List Text -> Flag := fun (sj : Subject) (p : Text) (ds : List Text) => case sj as s1 in Subject return Flag with | subjectParty (r : Ref kindParty) => textSame (refText kindParty r) p | subjectMembership (r : Ref kindMembership) => flagNo | subjectCommercial (c : Ref kindCommercial) => textIn ds (refText kindCommercial c) | subjectCommitment (r : Ref kindCommitment) => flagNo | subjectAssignment (r : Ref kindAssignment) => flagNo)
DEFINE_REC(acctDeals, : List Record -> Text -> List Text := fun (l : List Record) (p : Text) => case l as s1 in List return List Text with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Text with | makeRecord (h : Text) (b : Body) => (case (bodyCommercial b) as s3 in Option return List Text with | none => acctDeals r p | some (c : Commercial) => (case c as s4 in Commercial return List Text with | makeCommercial (x0 : KindCommercial) (x1 : Text) (x2 : Ref kindParty) (x3 : Text) (x4 : Option Nat) (x5 : Text) (x6 : Option Text) (x7 : CommercialStatus) (x8 : Attrs) (x9 : Option (Ref kindEvent)) => (case (textSame (refText kindParty x2) p) as s5 in Flag return List Text with | flagNo => acctDeals r p | flagYes => cons h (acctDeals r p))))))
DEFINE_REC(dealRefs, : List Text -> List (Ref kindCommercial) := fun (l : List Text) => case l as s1 in List return List (Ref kindCommercial) with | nil => nil | cons (h : Text) (r : List Text) => cons (commercialRef h) (dealRefs r))
DEFINE_REC(acctMems, : List Record -> Text -> List (Ref kindMembership) := fun (l : List Record) (p : Text) => case l as s1 in List return List (Ref kindMembership) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindMembership) with | makeRecord (h : Text) (b : Body) => (case (bodyMembership b) as s3 in Option return List (Ref kindMembership) with | none => acctMems r p | some (m : Membership) => (case m as s4 in Membership return List (Ref kindMembership) with | makeMembership (pe : Ref kindParty) (og : Ref kindParty) (ro : Option Text) (ip : Flag) (eb : Option (Ref kindEvent)) (pv : Provenance) (ats : Attrs) => (case (flagAnd (optNone (Ref kindEvent) eb) (flagOr (textSame (refText kindParty pe) p) (textSame (refText kindParty og) p))) as s5 in Flag return List (Ref kindMembership) with | flagNo => acctMems r p | flagYes => cons (membershipRef h) (acctMems r p))))))
DEFINE_REC(acctAssigns, : List Record -> Text -> List Text -> List (Ref kindAssignment) := fun (l : List Record) (p : Text) (ds : List Text) => case l as s1 in List return List (Ref kindAssignment) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindAssignment) with | makeRecord (h : Text) (b : Body) => (case (bodyAssignment b) as s3 in Option return List (Ref kindAssignment) with | none => acctAssigns r p ds | some (m : Assignment) => (case m as s4 in Assignment return List (Ref kindAssignment) with | makeAssignment (sb : Account) (ae : Ref kindParty) (rl : AssignmentRole) (te : Option Text) (eb : Option (Ref kindEvent)) (pv : Provenance) => (case (flagAnd (optNone (Ref kindEvent) eb) (acctNames sb p ds)) as s5 in Flag return List (Ref kindAssignment) with | flagNo => acctAssigns r p ds | flagYes => cons (assignmentRef h) (acctAssigns r p ds))))))
DEFINE_REC(acctArts, : List Record -> Text -> List Text -> List (Ref kindArtifact) := fun (l : List Record) (p : Text) (ds : List Text) => case l as s1 in List return List (Ref kindArtifact) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindArtifact) with | makeRecord (h : Text) (b : Body) => (case (bodyArtifact b) as s3 in Option return List (Ref kindArtifact) with | none => acctArts r p ds | some (m : Artifact) => (case m as s4 in Artifact return List (Ref kindArtifact) with | makeArtifact (kd : ArtifactKind) (sh : Text) (ur : Text) (mi : Text) (sbs : List Account) (ats : Attrs) => (case (acctsName sbs p ds) as s5 in Flag return List (Ref kindArtifact) with | flagNo => acctArts r p ds | flagYes => cons (artifactRef h) (acctArts r p ds))))))
DEFINE_REC(acctTimes, : List Record -> Text -> List Text -> List (Ref kindEvent) := fun (l : List Record) (p : Text) (ds : List Text) => case l as s1 in List return List (Ref kindEvent) with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List (Ref kindEvent) with | makeRecord (h : Text) (b : Body) => (case (bodyEvent b) as s3 in Option return List (Ref kindEvent) with | none => acctTimes r p ds | some (m : Event) => (case m as s4 in Event return List (Ref kindEvent) with | makeEvent (ty : EventType) (sj : Subject) (af : Option (Ref kindArtifact)) (pa : Option (Ref kindEvent)) (pl : Attrs) (po : Option (Ref kindPolicy)) => (case (subjNames sj p ds) as s5 in Flag return List (Ref kindEvent) with | flagNo => acctTimes r p ds | flagYes => cons (eventRef h) (acctTimes r p ds))))))
DEFINE(acctDummy, : Account360 := makeAccount360 (makeParty partyOrg textEnd none nil attrsEnd none none) nil nil nil nil nil)
DEFINE(acctView, : List Record -> Text -> Party -> List Text -> Account360 := fun (rs : List Record) (p : Text) (pa : Party) (ds : List Text) => makeAccount360 pa (acctMems rs p) (dealRefs ds) (acctAssigns rs p ds) (acctArts rs p ds) (acctTimes rs p ds))
DEFINE(acctRead, : List Record -> Text -> Account360 := fun (rs : List Record) (p : Text) => case (recFind rs p) as s1 in Option return Account360 with | none => acctDummy | some (b : Body) => (case (bodyParty b) as s2 in Option return Account360 with | none => acctDummy | some (pa : Party) => acctView rs p pa (acctDeals rs p)))
DEFINE(provConf, : Provenance -> Option Nat := fun (v : Provenance) => case v as s1 in Provenance return Option Nat with | makeProvenance (pa : Option (Ref kindArtifact)) (pe : Option (Ref kindEvent)) (pc : Option Nat) => pc)
DEFINE(bodyConfidence, : Body -> Option Nat := fun (b : Body) => case b as s1 in Body return Option Nat with | createsParty (m : Party) => none | createsMembership (m : Membership) => (case m as s2 in Membership return Option Nat with | makeMembership (pe : Ref kindParty) (og : Ref kindParty) (ro : Option Text) (ip : Flag) (eb : Option (Ref kindEvent)) (pv : Provenance) (ats : Attrs) => provConf pv) | createsCommercial (m : Commercial) => none | createsCommitment (m : Commitment) => (case m as s3 in Commitment return Option Nat with | makeCommitment (cm : Ref kindCommercial) (ck : CommitmentKind) (lb : Text) (v : Value) (u : Option Text) (st : CommitmentStatus) (sp : Option (Ref kindCommitment)) (pv : Provenance) => provConf pv) | createsArtifact (m : Artifact) => none | createsEvent (m : Event) => none | createsAssignment (m : Assignment) => (case m as s4 in Assignment return Option Nat with | makeAssignment (sb : Account) (ae : Ref kindParty) (rl : AssignmentRole) (te : Option Text) (eb : Option (Ref kindEvent)) (pv : Provenance) => provConf pv) | createsPolicy (m : Policy) => none)
DEFINE_REC(reviewWalk, : List Record -> Nat -> List Hash := fun (l : List Record) (bl : Nat) => case l as s1 in List return List Hash with | nil => nil | cons (x : Record) (r : List Record) => (case x as s2 in Record return List Hash with | makeRecord (h : Text) (b : Body) => (case (bodyConfidence b) as s3 in Option return List Hash with | none => reviewWalk r bl | some (k : Nat) => (case (natLt k bl) as s4 return List Hash with | 0 (no : prod ()) => reviewWalk r bl | 1 (yes : prod ()) => cons (hashOf h) (reviewWalk r bl)))))
DEFINE(evArtifact, : Event -> List (Ref kindArtifact) := fun (ev : Event) => case ev as s1 in Event return List (Ref kindArtifact) with | makeEvent (x0 : EventType) (x1 : Subject) (x2 : Option (Ref kindArtifact)) (x3 : Option (Ref kindEvent)) (x4 : Attrs) (x5 : Option (Ref kindPolicy)) => (case x2 as s2 in Option return List (Ref kindArtifact) with | none => nil | some (a : Ref kindArtifact) => cons a nil))
DEFINE(evidenceBody, : Text -> Body -> List (Ref kindArtifact) := fun (d : Text) (b : Body) => case (bodyEvent b) as s1 in Option return List (Ref kindArtifact) with | none => (case (bodyArtifact b) as s2 in Option return List (Ref kindArtifact) with | none => nil | some (m : Artifact) => cons (artifactRef d) nil) | some (ev : Event) => evArtifact ev)
DEFINE(evidenceRead, : List Record -> Hash -> List (Ref kindArtifact) := fun (rs : List Record) (h : Hash) => case h as s1 in Hash return List (Ref kindArtifact) with | hashOf (d : Text) => (case (recFind rs d) as s2 in Option return List (Ref kindArtifact) with | none => nil | some (b : Body) => evidenceBody d b))
DEFINE(artSame, : Artifact -> Text -> Flag := fun (m : Artifact) (g : Text) => case m as s1 in Artifact return Flag with | makeArtifact (x0 : ArtifactKind) (x1 : Text) (x2 : Text) (x3 : Text) (x4 : List Account) (x5 : Attrs) => textSame x1 g)
DEFINE(intactRead, : List Record -> Ref kindArtifact -> Text -> Flag := fun (rs : List Record) (r : Ref kindArtifact) (g : Text) => case (recFind rs (refText kindArtifact r)) as s1 in Option return Flag with | none => flagNo | some (b : Body) => (case (bodyArtifact b) as s2 in Option return Flag with | none => flagNo | some (m : Artifact) => artSame m g))
DEFINE(readWithH, : (Text -> Body -> Body) -> List Text -> (0 answer : Type 0) -> Log -> Query answer -> answer := fun (upd : Text -> Body -> Body) (hs : List Text) (0 answer : Type 0) (lg : Log) (q : Query answer) => case q as s1 in Query a return a with | queryMembersOf (x1 : Ref kindParty) (x2 : Moment) => asOfThen (List (Ref kindMembership)) nil (fun (rs : List Record) => membersWalk rs (refText kindParty x1)) (readAsOfH upd hs lg x2) | queryEmployer (x1 : Ref kindParty) (x2 : Moment) => asOfThen (Option (Ref kindParty)) none (fun (rs : List Record) => employerRead rs (refText kindParty x1)) (readAsOfH upd hs lg x2) | queryJobChanges (x1 : Moment) => changesRead (recordsLogH lg hs upd nil) x1 | queryCommercial (x1 : Ref kindCommercial) (x2 : Moment) => asOfThen (Option Commercial) none (fun (rs : List Record) => recCommercial rs (refText kindCommercial x1)) (readAsOfH upd hs lg x2) | queryProjectionSound (x1 : Ref kindCommercial) (x2 : Commercial) => soundRead (recordsLogH lg hs upd nil) (refText kindCommercial x1) x2 | queryTermsInForce (x1 : Ref kindCommercial) (x2 : Moment) => asOfThen (List (Ref kindCommitment)) nil (fun (rs : List Record) => termsWalk rs rs (refText kindCommercial x1)) (readAsOfH upd hs lg x2) | queryTermHistory (x1 : Ref kindCommitment) => termRead (recordsLogH lg hs upd nil) (refText kindCommitment x1) | queryAmountReconciled (x1 : Ref kindCommercial) => reconRead (recordsLogH lg hs upd nil) (refText kindCommercial x1) | queryDiscountPct (x1 : Ref kindCommercial) => discRead (recordsLogH lg hs upd nil) x1 | queryEvidence (x1 : Hash) => evidenceRead (recordsLogH lg hs upd nil) x1 | queryArtifactIntact (x1 : Ref kindArtifact) (x2 : Text) => intactRead (recordsLogH lg hs upd nil) x1 x2 | queryTimeline (x1 : Subject) (x2 : Moment) => nil | queryThread (x1 : Ref kindEvent) => nil | queryReplay (x1 : Moment) => readReplayH hs lg x1 | queryTail (x1 : Moment) => readTailH hs lg x1 | queryAuditByActor (x1 : Actor) => auditWalkH lg hs x1 | queryAuditByPolicy (x1 : Ref kindPolicy) => nil | queryOwner (x1 : Account) (x2 : Moment) => none | queryBook (x1 : Ref kindParty) (x2 : Moment) => nil | queryCan (x1 : Text) (x2 : Permission) (x3 : Subject) (x4 : Option (List Text)) => verdictDeny none | queryDryRun (x1 : Ref kindCommercial) (x2 : Text) => nil | queryRedacted (x1 : Text) (x2 : Subject) => attrsEnd | querySimulatePolicy (x1 : Policy) => nil | queryPipeline (x1 : PipelineKey) (x2 : Moment) => asOfThen (List Bucket) nil (fun (rs : List Record) => pipeRead x1 rs) (readAsOfH upd hs lg x2) | queryStageStats => stageRead (recordsLogH lg hs upd nil) | queryStaleDeals (x1 : Nat) => staleRead (recordsLogH lg hs upd nil) x1 | queryRenewals => renewRead (recordsLogH lg hs upd nil) | queryAccount360 (x1 : Ref kindParty) (x2 : Moment) => asOfThen Account360 acctDummy (fun (rs : List Record) => acctRead rs (refText kindParty x1)) (readAsOfH upd hs lg x2) | queryReviewQueue (x1 : Nat) => reviewWalk (recordsLogH lg hs upd nil) x1)
